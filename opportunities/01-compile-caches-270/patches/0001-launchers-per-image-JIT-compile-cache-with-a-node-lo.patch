+    resolved = (tmp_path / "env_resolved_1_arm64.toml").read_text()
+    assert 'TRITON_CACHE_DIR = "/tmp/sml-jit-cache/triton"' in resolved
+    assert 'image = "/imgs/x-arm64.sqsh"' in resolved
+    assert proc.returncode != 0  # missing image is still reported
+
+
+@pytest.mark.parametrize("framework", ["vllm", "sglang"])
+@pytest.mark.parametrize("npr", [1, 2])
+def test_rank_scripts_seed_and_promote(framework: str, npr: int) -> None:
+    scripts = render_rank_scripts(
+        _args("/e.toml", framework=framework, topology=Topology(replicas=1, nodes_per_replica=npr))
+    )
+    head = scripts["head.sh"]
+    assert 'sml_jit="$(dirname "$0")/sml_jit_cache.py"' in head
+    assert 'seed --shared "$SML_JIT_CACHE_SHARED"' in head
+    assert '--when-ready "http://localhost:8080/health"' in head
+    if npr > 1:
+        assert '--when-ready "http://$replica_head_ip:8080/health"' in scripts["follower.sh"]
+    # the cache hooks run before the engine starts
+    assert head.index("seed --shared") < head.index("$OPENTELA_BIN start")
+
+
+def test_off_mode_renders_no_hooks() -> None:
+    args = _args("/e.toml", jit_cache="off")
+    assert "sml_jit_cache.py" not in "".join(render_rank_scripts(args).values())
+    master = render_master(args)
+    assert "SML_JIT_CACHE_MODE=off" in master and "sml_jit_cache.py" not in master
+
+
+def test_env_tomls_point_every_cache_at_the_placeholder() -> None:
+    envs = files("swiss_ai_model_launch.assets").joinpath("envs")
+    for name, required in {
+        "vllm_base.toml": {"VLLM_CACHE_ROOT", "TRITON_CACHE_DIR", "TILELANG_CACHE_DIR", "DG_JIT_CACHE_DIR"},
+        "sglang_base.toml": {"SGLANG_CACHE_DIR", "SGLANG_JIT_CACHE_DIR", "TRITON_CACHE_DIR", "TILELANG_CACHE_DIR"},
+    }.items():
+        env = tomllib.loads(envs.joinpath(name).read_text())["env"]
+        assert required <= set(env), name
+        for key in required:
+            assert env[key].startswith("{jit_cache}/"), (name, key)
+
+
+# --- the embedded helper ---------------------------------------------------------------------
+
+
+def _overlay(local: Path, tag: str) -> None:
+    for k in range(5):
+        d = local / "triton" / f"{tag}{k}"
+        d.mkdir(parents=True)
+        (d / "k.cubin").write_bytes(b"\x7fELF" + tag.encode() * 100)
+    (local / "inductor" / "locks").mkdir(parents=True)
+    (local / "inductor" / "locks" / "a.lock").write_text("")
+    (local / "vllm").mkdir()
+    (local / "vllm" / "gpu_p2p_access_cache_for_0,1.json").write_text("{}")
+    at = local / "sglang" / "flashinfer" / "autotune" / "rank_0.json"
+    at.parent.mkdir(parents=True)
+    at.write_text("{}")
+    at.chmod(0o600)
+
+
+def test_helper_promote_concurrently_then_seed(tmp_path: Path) -> None:
+    shared = tmp_path / "shared"
+    shared.mkdir()
+    overlays = []
+    for i in range(6):
+        o = tmp_path / f"o{i}"
+        _overlay(o, f"J{i}K")
+        overlays.append(o)
+    procs = [
+        subprocess.Popen(
+            [sys.executable, str(_HELPER), "promote", "--shared", str(shared), "--local", str(o), "--settle", "0"],
+            stdout=subprocess.PIPE,
+            text=True,
+        )
+        for o in overlays
+    ]
+    results = [json.loads(p.communicate()[0])["promote"] for p in procs]
+    assert all(r["errors"] == 0 for r in results)
+    assert len(list((shared / "triton").iterdir())) == 30  # every job's distinct kernels landed
+    assert not list(shared.rglob("*.lock")) and not list(shared.rglob("gpu_p2p_access_cache_for_*"))
+    mode = stat.S_IMODE((shared / "sglang/flashinfer/autotune/rank_0.json").stat().st_mode)
+    assert mode & 0o044 == 0o044  # readable by other infra01 members despite mkstemp's 0600
+    fresh = tmp_path / "fresh"
+    seeded = sjc.seed(shared, fresh)
+    assert seeded["errors"] == 0 and (fresh / "triton" / "J3K4" / "k.cubin").exists()
+    assert sjc.promote(shared, fresh)["promoted"] == 0
