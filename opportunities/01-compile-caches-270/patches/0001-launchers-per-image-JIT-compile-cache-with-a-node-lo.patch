+def _render_jit_cache_setup(launch_args: LaunchArgs) -> str:
+    """Key the shared cache by image and GPU arch, on the batch host, before the env file
+    is resolved (its ``{jit_cache}`` placeholder is the node-local overlay, or the shared
+    directory itself in ``shared`` mode).
+
+    Images are updated in place, so the path is no key. A ``<image>.digest`` sidecar
+    (written by the images CI) wins; otherwise hash the file size and the 96-byte squashfs
+    superblock (mkfs time, table offsets, bytes used): one small read, new on every rebuild.
+    Same key as ``sml_jit_cache.py key``.
+    """
+    if launch_args.jit_cache == JIT_CACHE_OFF:
+        return f'export SML_JIT_CACHE_MODE=off SML_JIT_CACHE_LOCAL="{JIT_CACHE_LOCAL}" SML_JIT_CACHE_SHARED=""'
+    env = launch_args.environment
+    return (
+        "# JIT/compile caches (#270): <root>/<image key>/<gpu arch>, see docs/jit-cache.md.\n"
+        f'SML_JIT_CACHE_MODE="{launch_args.jit_cache}"\n'
+        f'SML_JIT_CACHE_LOCAL="{JIT_CACHE_LOCAL}"\n'
+        'SML_JIT_CACHE_SHARED=""\n'
+        'sml_img=$(sed -n \'s|^ *image *= *"\\([^"]*\\)".*|\\1|p\' '
+        f'"{env}" | head -1 | sed "s|{{arch}}|${{SML_ARCH}}|g")\n'
+        'if [[ -r "${sml_img}.digest" ]]; then\n'
+        "    sml_key=$(head -1 \"${sml_img}.digest\" | tr ':' '-' | cut -c1-23)\n"
+        'elif [[ -f "$sml_img" && "$(head -c 4 "$sml_img")" == "hsqs" ]]; then\n'
+        '    sml_key="sqsh-$( { printf \'%s\\0\' "$(wc -c < "$sml_img" | tr -d \' \')"; head -c 96 "$sml_img"; } '
+        '| sha256sum | cut -c1-16)"\n'
+        "else\n"
+        '    sml_key="ref-$(printf \'%s\' "$sml_img" | sha256sum | cut -c1-16)"\n'
+        "fi\n"
+        "sml_cc=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null"
+        " | head -1 | tr -d '.[:space:]')\n"
+        f'SML_JIT_CACHE_SHARED="{launch_args.jit_cache_root}/${{sml_key}}/sm${{sml_cc:-unknown}}"\n'
+        "# Readers without write access still seed; only promotion needs it.\n"
+        'mkdir -p "$SML_JIT_CACHE_SHARED" 2>/dev/null || true\n'
+        'if [[ "$SML_JIT_CACHE_MODE" == "shared" ]]; then\n'
+        '    SML_JIT_CACHE_LOCAL="$SML_JIT_CACHE_SHARED"\n'
+        "fi\n"
+        'echo "JIT cache ($SML_JIT_CACHE_MODE): shared $SML_JIT_CACHE_SHARED, in-container $SML_JIT_CACHE_LOCAL"\n'
+        "export SML_JIT_CACHE_MODE SML_JIT_CACHE_LOCAL SML_JIT_CACHE_SHARED\n"
+        f"cat > \"$RANKS_DIR/sml_jit_cache.py\" <<'{_JIT_CACHE_HELPER_HEREDOC}'\n"
+        f"{_JIT_CACHE_HELPER_TEXT.rstrip()}\n"
+        f"{_JIT_CACHE_HELPER_HEREDOC}"
+    )
