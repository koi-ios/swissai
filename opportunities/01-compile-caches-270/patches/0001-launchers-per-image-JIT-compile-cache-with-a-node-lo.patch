+# ruff: noqa: S603, S607  # subprocess invocations against controlled paths/binaries
+"""Persistent JIT/compile caches (#270): cache key, {jit_cache} resolution, rank-script hooks,
+and the embedded helper (seed / promote / gc).
+
+Like test_env_arch_resolution, the shell is run for real: the key the batch host computes
+in bash must equal the helper's, or seeding and promotion would use different directories.
+"""
+
+import importlib.util
+import json
+import stat
+import subprocess
+import sys
+import tomllib
+from importlib.resources import files
+from pathlib import Path
+
+import pytest
+
+from swiss_ai_model_launch.launchers.framework import (
+    JIT_CACHE_LOCAL,
+    _render_env_file_resolution,
+    _render_jit_cache_setup,
+    render_master,
+    render_rank_scripts,
+)
+from swiss_ai_model_launch.launchers.launch_args import LaunchArgs
+from swiss_ai_model_launch.launchers.topology import Topology
+
+_HELPER = Path(str(files("swiss_ai_model_launch.assets").joinpath("sml_jit_cache.py")))
+_spec = importlib.util.spec_from_file_location("sml_jit_cache", _HELPER)
+assert _spec and _spec.loader
+sjc = importlib.util.module_from_spec(_spec)
+sys.modules["sml_jit_cache"] = sjc  # dataclasses resolve their module
+_spec.loader.exec_module(sjc)
+
+
+def _args(environment: str, **kw: object) -> LaunchArgs:
+    base: dict[str, object] = {
+        "job_name": "j",
+        "served_model_name": "vendor/model-abc1",
+        "account": "proj01",
+        "partition": "normal",
+        "environment": environment,
+        "framework": "vllm",
+    }
+    base.update(kw)
+    return LaunchArgs(**base)  # type: ignore[arg-type]
+
+
+def _fake_sqsh(path: Path, salt: bytes = b"") -> Path:
+    path.write_bytes(b"hsqs" + b"\x01" * 4 + salt.ljust(88, b"\0") + b"x" * 4096)
+    return path
+
+
+def _run_setup(tmp_path: Path, env_file: Path, args: LaunchArgs) -> dict[str, str]:
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir(exist_ok=True)
+    smi = bin_dir / "nvidia-smi"
+    smi.write_text("#!/bin/sh\necho 9.0\necho 9.0\n")
+    smi.chmod(0o755)
+    ranks = tmp_path / "ranks"
+    ranks.mkdir(exist_ok=True)
+    script = (
+        f"set -euo pipefail\nSML_ARCH=arm64\nRANKS_DIR={ranks}\n{_render_jit_cache_setup(args)}\n"
+        'echo "SHARED=$SML_JIT_CACHE_SHARED"\necho "LOCAL=$SML_JIT_CACHE_LOCAL"\n'
+    )
+    proc = subprocess.run(
+        ["bash", "-c", script],
+        cwd=tmp_path,
+        env={"PATH": f"{bin_dir}:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin"},
+        capture_output=True,
+        text=True,
+    )
+    assert proc.returncode == 0, proc.stderr
+    out = dict(ln.split("=", 1) for ln in proc.stdout.splitlines() if "=" in ln)
+    assert (ranks / "sml_jit_cache.py").read_text() == _HELPER.read_text()
+    return out
+
+
+_HAS_SHA256SUM = any((Path(d) / "sha256sum").exists() for d in ("/usr/bin", "/bin", "/usr/sbin", "/sbin"))
+
+
+@pytest.mark.skipif(not _HAS_SHA256SUM, reason="needs coreutils sha256sum")
+def test_bash_key_matches_helper_and_changes_on_rebuild(tmp_path: Path) -> None:
+    img = _fake_sqsh(tmp_path / "vllm_base-arm64.sqsh")
+    env_file = tmp_path / "env.toml"
+    env_file.write_text(f'image = "{tmp_path}/vllm_base-{{arch}}.sqsh"\n')
+    out = _run_setup(tmp_path, env_file, _args(str(env_file), jit_cache_root="/root"))
+    assert out["SHARED"] == f"/root/{sjc.image_key(str(img))}/sm90"
+    assert out["LOCAL"] == JIT_CACHE_LOCAL
+    _fake_sqsh(img, b"rebuilt in place")  # images are updated in place: same path, new key
+    out2 = _run_setup(tmp_path, env_file, _args(str(env_file), jit_cache_root="/root"))
+    assert out2["SHARED"] != out["SHARED"]
+    (tmp_path / "vllm_base-arm64.sqsh.digest").write_text("sha256:0123456789abcdef0123456789\n")
+    out3 = _run_setup(tmp_path, env_file, _args(str(env_file), jit_cache_root="/root"))
+    assert out3["SHARED"] == "/root/sha256-0123456789abcdef/sm90"
+
+
+@pytest.mark.skipif(not _HAS_SHA256SUM, reason="needs coreutils sha256sum")
+def test_shared_mode_points_caches_at_shared_dir(tmp_path: Path) -> None:
+    env_file = tmp_path / "env.toml"
+    env_file.write_text('image = "docker.io/lmsysorg/sglang:v0.5.20"\n')
+    out = _run_setup(tmp_path, env_file, _args(str(env_file), jit_cache="shared", jit_cache_root="/root"))
+    assert out["SHARED"].startswith("/root/ref-") and out["LOCAL"] == out["SHARED"]
+
+
+def test_jit_cache_placeholder_resolved_with_arch(tmp_path: Path) -> None:
+    env_file = tmp_path / "env.toml"
+    env_file.write_text('image = "/imgs/x-{arch}.sqsh"\n[env]\nTRITON_CACHE_DIR = "{jit_cache}/triton"\n')
+    block = _render_env_file_resolution(_args(str(env_file)))
+    script = f'set -euo pipefail\nSML_ARCH=arm64\n{block}\ncat "$SML_ENV_FILE"\n'
+    proc = subprocess.run(
+        ["bash", "-c", script],
+        cwd=tmp_path,
+        env={"SLURM_JOB_ID": "1", "PATH": "/usr/bin:/bin", "SML_JIT_CACHE_LOCAL": JIT_CACHE_LOCAL},
+        capture_output=True,
+        text=True,
