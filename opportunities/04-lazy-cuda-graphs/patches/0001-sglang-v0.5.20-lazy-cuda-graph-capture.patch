+# ==============================================================================
+"""Runner-side wiring for lazy CUDA-graph capture: eligibility, schedule
+construction from cuda_graph_config, and the per-step memory check."""
+
+from __future__ import annotations
+
+import logging
+from typing import TYPE_CHECKING, List, Optional, Sequence, Tuple
+
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.model_executor.cuda_graph_config import Backend, Phase
+from sglang.srt.model_executor.runner.lazy_capture import LazyCaptureSchedule
+from sglang.srt.runtime_context import (
+    get_disagg,
+    get_exec,
+    get_flags,
+    get_parallel,
+)
+from sglang.srt.utils import log_info_on_rank0
+
+if TYPE_CHECKING:
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+logger = logging.getLogger(__name__)
+
+# Lazy capture is validated only for the default backend of each phase.
+_LAZY_BACKEND = {Phase.DECODE: Backend.FULL, Phase.PREFILL: Backend.BREAKABLE}
+
+
+def lazy_capture_unsupported_reason(
+    *, phase: str, model_runner: ModelRunner
+) -> Optional[str]:
+    """Why lazy capture cannot run for this phase, or None if it can.
+
+    Deferred steps capture while serving: every rank must reach the step in
+    the same scheduler iteration (TP-only request broadcast), and the step
+    must not touch state a live request owns.
+    """
+    parallel = get_parallel()
+    graph = get_exec().graph
+    backend = getattr(graph.cuda_graph_config, phase).backend
+    checks = (
+        (model_runner.device != "cuda", "device is not CUDA"),
+        (backend != _LAZY_BACKEND[phase], f"{phase} backend is {backend!r}"),
+        (model_runner.is_draft_worker, "draft worker"),
+        (model_runner.spec_algorithm.is_speculative(), "speculative decoding"),
+        (model_runner.lora_manager is not None, "LoRA"),
+        (model_runner.model_config.is_encoder_decoder, "encoder-decoder model"),
+        # MLA / DSA backends keep capture-time metadata outside the per-bucket
+        # dicts that FA3 / FlashInfer / Triton use; not validated.
+        (model_runner.use_mla_backend, "MLA attention"),
+        (parallel.pp_size > 1, "pipeline parallelism"),
+        (parallel.enable_dp_attention, "DP attention"),
+        (parallel.attn_cp_size > 1 or parallel.dcp_enabled, "context parallelism"),
+        (get_disagg().disaggregation_mode != "null", "PD disaggregation"),
+        (get_disagg().enable_pdmux, "PD multiplexing"),
+        (get_exec().overlap.enable_two_batch_overlap, "two-batch overlap"),
+        (get_flags().capture.enable_torch_compile, "torch.compile"),
+        (graph.enable_profile_cuda_graph, "CUDA graph profiling"),
+        (get_exec().features.enable_memory_saver, "memory saver"),
+        (
+            envs.SGLANG_ENABLE_POST_CAPTURE_KV_SIZING.get(),
+            "post-capture KV sizing (it sizes the KV pool after startup capture)",
+        ),
+        (
+            # Deferred capture zeroes index buffers so dummy writes hit the
+            # reserved KV slot 0; hybrid state pools have no such guarantee.
+            getattr(model_runner.req_to_token_pool, "mamba_pool", None) is not None,
+            "hybrid state (mamba) pools",
+        ),
+    )
+    phase_checks = {
+        Phase.DECODE: (
+            (graph.disable_cuda_graph_padding, "disable_cuda_graph_padding"),
+            (envs.SGLANG_ENABLE_METADATA_GLUE_GRAPH.get(), "metadata glue graph"),
+        ),
+        Phase.PREFILL: (),
+    }[phase]
+    for failed, reason in (*checks, *phase_checks):
+        if failed:
+            return reason
+    return None
+
+
+def maybe_create_lazy_schedule(
+    *, phase: str, planned: Sequence[int], model_runner: ModelRunner
+) -> Optional[LazyCaptureSchedule]:
+    """Build the schedule when cuda_graph_config[phase].initial_bs is set."""
+    phase_config = getattr(get_exec().graph.cuda_graph_config, phase)
+    if phase_config.initial_bs is None:
+        return None
+    reason = lazy_capture_unsupported_reason(phase=phase, model_runner=model_runner)
+    if reason is not None:
+        logger.warning(
+            "Lazy CUDA graph capture disabled for %s (%s); capturing every "
+            "bucket at startup.",
+            phase,
+            reason,
+        )
+        return None
+    initial, deferred, priority, dropped = _restrict_to_planned(
+        planned=planned,
+        initial_bs=phase_config.initial_bs,
+        deferred_bs=phase_config.deferred_bs,
+        deferred_priority=phase_config.deferred_priority,
+    )
+    if dropped:
+        log_info_on_rank0(
+            logger,
+            f"Lazy CUDA graph capture [{phase}]: ignoring buckets {dropped} that "
+            "are not in the resolved capture list.",
+        )
+    schedule = LazyCaptureSchedule(
+        phase=phase,
+        planned=planned,
+        initial=initial,
+        deferred_order=deferred,
+        deferred_priority=priority,
+        promote_after=envs.SGLANG_LAZY_CUDA_GRAPH_PROMOTE_AFTER.get(),
+    )
+    log_info_on_rank0(
+        logger,
+        f"Lazy CUDA graph capture [{phase}]: {len(schedule.initial)} of "
+        f"{len(schedule.planned)} buckets at startup {list(schedule.initial)}, "
+        f"{len(schedule.pending)} deferred.",
+    )
+    return schedule
+
+
+def _restrict_to_planned(
+    *,
+    planned: Sequence[int],
+    initial_bs: Sequence[int],
+    deferred_bs: Optional[Sequence[int]],
+    deferred_priority: Optional[Sequence[float]],
+) -> Tuple[List[int], Optional[List[int]], Optional[List[float]], List[int]]:
+    """Drop configured buckets the runner filtered out (alignment, pool size)."""
+    planned_set = set(planned)
+    initial = sorted({int(s) for s in initial_bs if int(s) in planned_set})
+    dropped = sorted({int(s) for s in initial_bs} - planned_set)
+    if deferred_bs is None:
+        return initial, None, None, dropped
+    if deferred_priority is not None and len(deferred_priority) != len(deferred_bs):
+        raise ValueError("deferred_priority must have one entry per deferred_bs entry")
+    kept = [
+        (int(s), i)
+        for i, s in enumerate(deferred_bs)
+        if int(s) in planned_set and int(s) not in initial
+    ]
+    dropped += sorted({int(s) for s in deferred_bs} - planned_set)
+    deferred = [s for s, _ in kept]
+    priority = (
+        [float(deferred_priority[i]) for _, i in kept]
+        if deferred_priority is not None
+        else None
+    )
+    return initial, deferred, priority, dropped
+
+
+def has_capture_headroom() -> bool:
+    """Free memory check before a deferred step; returns cached eager blocks first.
+
+    Eager forwards of not-yet-captured buckets leave activation blocks in the
+    caching allocator's default pool, which the graph pool cannot reuse.
+    """
+    torch.cuda.empty_cache()
+    free_bytes, _ = torch.cuda.mem_get_info()
+    return free_bytes >= envs.SGLANG_LAZY_CUDA_GRAPH_MIN_FREE_MB.get() * (1 << 20)
