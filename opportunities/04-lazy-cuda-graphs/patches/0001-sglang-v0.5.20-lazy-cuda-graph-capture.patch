index 0000000..a00af3c
--- /dev/null
+++ b/python/sglang/srt/model_executor/runner/lazy_capture.py
@@ -0,0 +1,241 @@
+# Copyright 2023-2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+"""Bookkeeping for deferred (lazy) CUDA-graph capture of one phase runner.
+
+A runner keeps its full *planned* bucket list (static buffers stay sized for
+it) but captures only ``initial`` at startup. The remaining buckets wait in a
+priority queue and are captured one per step while the scheduler is idle
+(see ``scheduler_components/lazy_graph_capture.py``).
+
+Dispatch is bucket-exact: a batch replays a graph only if the bucket the
+default capture would have used for it is already captured; otherwise it runs
+eagerly. Lazy mode therefore never pads more than the default does.
+
+Rank consistency: every method is a pure function of rank-replicated inputs
+(config, the sequence of batch shapes, the sequence of capture steps). All TP
+ranks hold identical state without exchanging messages, which matters because
+graph replay and eager execution take different all-reduce paths and must not
+be mixed across ranks within one forward.
+
+This module imports only the standard library so it can be unit-tested
+without a GPU.
+"""
+
+from __future__ import annotations
+
+import bisect
+from typing import Dict, List, Optional, Sequence, Tuple
+
+# Promoted buckets sort ahead of every policy priority, in promotion order.
+_PROMOTED_PRIORITY = float("inf")
+
+
+class LazyCaptureSchedule:
+    """Planned, captured and pending buckets of one runner (decode or prefill)."""
+
+    def __init__(
+        self,
+        *,
+        phase: str,
+        planned: Sequence[int],
+        initial: Sequence[int],
+        deferred_order: Optional[Sequence[int]] = None,
+        deferred_priority: Optional[Sequence[float]] = None,
+        promote_after: int = 0,
+    ) -> None:
+        self.phase = phase
+        self._planned: Tuple[int, ...] = tuple(sorted(set(int(s) for s in planned)))
+        if not self._planned:
+            raise ValueError(f"lazy capture [{phase}]: planned bucket list is empty")
+        planned_set = set(self._planned)
+        initial_set = set(int(s) for s in initial)
+        unknown = initial_set - planned_set
+        if unknown:
+            raise ValueError(
+                f"lazy capture [{phase}]: initial_bs {sorted(unknown)} not in bs"
+            )
+        self._initial: Tuple[int, ...] = tuple(sorted(initial_set))
+        order = self._resolve_order(
+            planned=self._planned,
+            initial_set=initial_set,
+            deferred_order=deferred_order,
+        )
+        priority = self._resolve_priority(order, deferred_priority)
+        # Pending buckets in capture order; priorities are kept alongside so the
+        # scheduler can merge the decode and prefill queues.
+        self._pending: List[int] = list(order)
+        self._priority: Dict[int, float] = dict(zip(order, priority))
+        self._captured: List[int] = []
+        self._failed: List[int] = []
+        self._eager_hits: Dict[int, int] = {}
+        self._promote_after = int(promote_after)
+        self._num_promoted = 0
+
+    @staticmethod
+    def _resolve_order(
+        *,
+        planned: Tuple[int, ...],
+        initial_set: set,
+        deferred_order: Optional[Sequence[int]],
+    ) -> List[int]:
+        remaining = [s for s in planned if s not in initial_set]
+        if deferred_order is None:
+            # Small buckets first: they are the cheapest to capture.
+            return remaining
+        order: List[int] = []
+        seen = set()
+        for s in deferred_order:
+            s = int(s)
+            if s in initial_set or s not in planned or s in seen:
+                raise ValueError(
+                    f"deferred_bs entry {s} must be a planned bucket that is not "
+                    "in initial_bs, listed once"
+                )
+            order.append(s)
+            seen.add(s)
+        # Planned buckets the policy left out are still captured eventually, last.
+        order.extend(s for s in remaining if s not in seen)
+        return order
+
+    @staticmethod
+    def _resolve_priority(
+        order: List[int], deferred_priority: Optional[Sequence[float]]
+    ) -> List[float]:
+        if deferred_priority is None:
+            # Strictly decreasing so the given order is preserved when merged.
+            return [float(len(order) - i) for i in range(len(order))]
+        if len(deferred_priority) > len(order):
+            raise ValueError("deferred_priority is longer than the deferred list")
+        given = [float(p) for p in deferred_priority]
+        # Buckets appended after the policy's list rank below all of its entries.
+        floor = min(given, default=0.0)
+        tail = [floor - 1.0 - i for i in range(len(order) - len(given))]
+        return given + tail
+
+    # ---- read side ---------------------------------------------------------
+
+    @property
+    def planned(self) -> Tuple[int, ...]:
+        return self._planned
+
+    @property
+    def initial(self) -> Tuple[int, ...]:
+        return self._initial
+
+    @property
+    def captured(self) -> Tuple[int, ...]:
+        return tuple(self._captured)
+
+    @property
+    def pending(self) -> Tuple[int, ...]:
+        return tuple(self._pending)
+
+    @property
+    def failed(self) -> Tuple[int, ...]:
+        return tuple(self._failed)
+
+    def eager_hits(self, size: int) -> int:
+        return self._eager_hits.get(size, 0)
+
+    def planned_bucket(self, raw_size: int) -> Optional[int]:
+        """The bucket the default (capture-all) runner would pad ``raw_size`` to."""
+        index = bisect.bisect_left(self._planned, raw_size)
+        if index == len(self._planned):
+            return None
+        return self._planned[index]
+
+    def is_captured(self, size: int) -> bool:
+        index = bisect.bisect_left(self._captured, size)
+        return index < len(self._captured) and self._captured[index] == size
+
+    def can_replay(self, raw_size: int) -> bool:
+        bucket = self.planned_bucket(raw_size)
+        return bucket is not None and self.is_captured(bucket)
+
+    def next_pending(self) -> Optional[Tuple[int, float]]:
+        """Head of the queue as ``(size, priority)``, or None when done."""
+        if not self._pending:
+            return None
+        size = self._pending[0]
+        return size, self._priority[size]
+
+    # ---- write side (called identically on every rank) ---------------------
+
+    def record_eager(self, raw_size: int) -> Optional[int]:
+        """Count an eager forward whose bucket is still pending.
+
+        Returns the bucket if this call promoted it to the head of the queue.
+        """
+        bucket = self.planned_bucket(raw_size)
+        if bucket is None or self.is_captured(bucket):
+            return None
+        if bucket not in self._priority:
+            return None  # failed bucket: stays eager
+        hits = self._eager_hits.get(bucket, 0) + 1
+        self._eager_hits[bucket] = hits
+        if self._promote_after > 0 and hits == self._promote_after:
+            self._promote(bucket)
+            return bucket
+        return None
+
+    def _promote(self, bucket: int) -> None:
+        self._pending.remove(bucket)
+        # Earlier promotions keep their place ahead of this one.
+        self._pending.insert(self._num_promoted, bucket)
+        self._priority[bucket] = _PROMOTED_PRIORITY
+        self._num_promoted += 1
+
+    def mark_captured(self, size: int) -> None:
+        if size in self._pending:
+            index = self._pending.index(size)
+            self._pending.pop(index)
+            if index < self._num_promoted:
+                self._num_promoted -= 1
+            self._priority.pop(size, None)
+        elif size not in self._initial:
+            raise ValueError(f"lazy capture [{self.phase}]: {size} was never planned")
+        if not self.is_captured(size):
+            bisect.insort(self._captured, size)
+
+    def mark_failed(self, size: int) -> None:
+        """Drop a bucket that could not be captured; it keeps running eagerly."""
+        if size in self._pending:
+            index = self._pending.index(size)
+            self._pending.pop(index)
+            if index < self._num_promoted:
+                self._num_promoted -= 1
+            self._priority.pop(size, None)
+        if size not in self._failed:
+            self._failed.append(size)
+
+    def startup_sizes(self) -> List[int]:
+        """Buckets to capture before serving, largest first (pool reuse)."""
+        return sorted(self._initial, reverse=True)
+
+
+def pick_next_phase(
+    schedules: Sequence[Optional[LazyCaptureSchedule]],
+) -> Optional[LazyCaptureSchedule]:
+    """The schedule whose head has the highest priority; earlier entries win ties."""
+    best: Optional[LazyCaptureSchedule] = None
+    best_priority = float("-inf")
+    for schedule in schedules:
+        if schedule is None:
+            continue
+        head = schedule.next_pending()
+        if head is None:
+            continue
+        if best is None or head[1] > best_priority:
+            best, best_priority = schedule, head[1]
+    return best
