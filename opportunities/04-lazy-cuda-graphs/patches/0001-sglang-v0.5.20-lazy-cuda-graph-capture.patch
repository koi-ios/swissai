+# limitations under the License.
+# ==============================================================================
+"""Idle-time driver for deferred CUDA-graph capture (lazy capture).
+
+Protocol, one capture step per scheduler iteration at most:
+
+1. Leader (TP rank 0) in ``ingest_requests``: if the scheduler was fully idle
+   for long enough, ``propose`` returns a ``LazyGraphCaptureTick`` naming the
+   head bucket. The tick rides the existing per-iteration request broadcast, so
+   every rank receives it in the same iteration and in the same order as real
+   requests. Only the leader reads a clock; *which* bucket is next is
+   rank-replicated state, *when* is the leader's decision.
+2. Every rank: the request dispatcher hands the tick to ``accept``.
+3. Every rank: ``on_idle`` (reached in lockstep, since the batch decision is
+   replicated) calls ``run_pending``. It agrees with the other ranks via one
+   MIN all-reduce on the CPU group that all of them are fully idle, expect the
+   same bucket and have memory headroom. Then all ranks capture exactly that
+   bucket inside one ``graph_capture`` session.
+
+A request that arrives during a step is polled in the next iteration, so it
+waits for at most one capture step.
+
+Imports are standard library plus the pure schedule module so this file can be
+unit-tested with fake runners and a fake all-reduce.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Mapping, Optional, Protocol, Tuple
+
+import msgspec
+
+from sglang.srt.model_executor.runner.lazy_capture import (
+    LazyCaptureSchedule,
+    pick_next_phase,
+)
+
+logger = logging.getLogger(__name__)
+
+# Fallback step-cost model (seconds = a + b * size) until the leader has
+# observed steps of a phase. Fitted to SGLang 0.5.16 capture logs of
+# Llama-3.1-70B TP4 on GH200 (lab runs); deliberately on the slow side.
+_DEFAULT_COST_MODEL: Dict[str, Tuple[float, float]] = {
+    "decode": (0.30, 0.0),
+    "prefill": (0.40, 1.4e-4),
+}
+
+
+class LazyGraphCaptureTick(msgspec.Struct, frozen=True, kw_only=True):
+    """Leader's proposal to capture one bucket; rides the TP request broadcast."""
+
+    seq: int
+    phase: str
+    size: int
+
+
+class LazyCaptureTarget(Protocol):
+    """What the controller needs from a decode or prefill graph runner."""
+
+    lazy_schedule: LazyCaptureSchedule
+
+    def capture_deferred(self, size: int) -> None: ...
+
+    def lazy_has_headroom(self, size: int) -> bool: ...
+
+
+class LazyGraphCaptureController:
+    def __init__(
+        self,
+        *,
+        is_leader: bool,
+        targets: Mapping[str, LazyCaptureTarget],
+        agree_min: Callable[[List[int]], List[int]],
+        min_idle_s: float,
+        idle_cost_ratio: float,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self._is_leader = is_leader
+        # Decode first: on equal priority its buckets win (cheaper, hit per token).
+        self._targets: Dict[str, LazyCaptureTarget] = dict(targets)
+        self._agree_min = agree_min
+        self._min_idle_s = float(min_idle_s)
+        self._idle_cost_ratio = float(idle_cost_ratio)
+        self._clock = clock
+        self._seq = 0
+        # Set on every rank at once when the ranks disagree about the next step.
+        self._disabled = False
+        self._pending_tick: Optional[LazyGraphCaptureTick] = None
+        self._idle_since: Optional[float] = None
+        self._observed: Dict[str, List[Tuple[int, float]]] = {
+            phase: [] for phase in self._targets
+        }
+
+    # ---- shared state ------------------------------------------------------
+
+    @property
+    def seq(self) -> int:
+        return self._seq
+
+    def _schedules(self) -> List[LazyCaptureSchedule]:
+        return [target.lazy_schedule for target in self._targets.values()]
+
+    @property
+    def disabled(self) -> bool:
+        return self._disabled
+
+    def has_pending_work(self) -> bool:
+        return not self._disabled and pick_next_phase(self._schedules()) is not None
+
+    def next_bucket(self) -> Optional[Tuple[str, int]]:
+        schedule = pick_next_phase(self._schedules())
+        if schedule is None:
+            return None
+        head = schedule.next_pending()
+        assert head is not None
+        return schedule.phase, head[0]
+
+    # ---- leader --------------------------------------------------------------
+
+    def observe_step(self, *, phase: str, size: int, seconds: float) -> None:
+        """Feed a measured capture time (startup or deferred) to the cost model."""
+        self._observed.setdefault(phase, []).append((int(size), float(seconds)))
+
+    def estimate_cost(self, *, phase: str, size: int) -> float:
+        a, b = _fit_cost_model(
+            self._observed.get(phase, []), _DEFAULT_COST_MODEL.get(phase, (0.5, 0.0))
+        )
+        return max(0.0, a + b * size)
+
+    def propose(self, *, fully_idle: bool) -> Optional[LazyGraphCaptureTick]:
+        """Leader only: a tick for the head bucket once idle long enough."""
+        if not self._is_leader or self._disabled:
+            return None
+        if not fully_idle:
+            self._idle_since = None
+            return None
+        now = self._clock()
+        if self._idle_since is None:
+            self._idle_since = now
+        head = self.next_bucket()
+        if head is None:
+            return None
+        phase, size = head
+        needed = self._min_idle_s + self._idle_cost_ratio * self.estimate_cost(
+            phase=phase, size=size
+        )
+        if now - self._idle_since < needed:
+            return None
+        return LazyGraphCaptureTick(seq=self._seq, phase=phase, size=size)
+
+    # ---- every rank ----------------------------------------------------------
+
+    def begin_iteration(self) -> None:
+        """Drop a tick that was not run in the iteration that delivered it."""
+        self._pending_tick = None
+
+    def accept(self, tick: LazyGraphCaptureTick) -> None:
+        self._pending_tick = tick
+
+    def take_ticks(self, recv_reqs: List[Any]) -> List[Any]:
+        """Accept the broadcast tick, if any, and return the real requests."""
+        if not recv_reqs:
+            return recv_reqs
+        rest = []
+        for req in recv_reqs:
+            if isinstance(req, LazyGraphCaptureTick):
+                self.accept(req)
+            else:
+                rest.append(req)
+        return rest
+
+    def run_pending(self, *, fully_idle: bool) -> Optional[LazyGraphCaptureTick]:
+        """Run the delivered tick if every rank agrees; returns the tick run."""
+        tick = self._pending_tick
+        self._pending_tick = None
+        if tick is None:
+            return None
+        expected = self.next_bucket()
+        matches = (
+            expected is not None
+            and tick.seq == self._seq
+            and (tick.phase, tick.size) == expected
+        )
+        if not matches:
+            # Diverged bookkeeping is a bug; skip loudly rather than deadlock.
+            logger.error(
+                "Lazy CUDA graph capture: tick %s does not match local head %s "
+                "(seq %d); skipping.",
+                tick,
+                expected,
+                self._seq,
+            )
+        target = self._targets.get(tick.phase)
+        headroom = matches and fully_idle and target.lazy_has_headroom(tick.size)
+        votes = self._agree_min([int(matches), int(fully_idle), int(headroom)])
+        if not all(votes):
+            if not votes[0]:
+                # Some rank's queue diverged: stop on every rank, keep serving.
+                self._disabled = True
+                logger.error(
+                    "Lazy CUDA graph capture disabled: ranks disagree on the next "
+                    "bucket; uncaptured buckets will keep running eagerly."
+                )
+            elif votes[1] and not votes[2]:
+                # Out of memory headroom on some rank: give up on this bucket
+                # everywhere so the queue keeps moving.
+                target.lazy_schedule.mark_failed(tick.size)
+                self._seq += 1
+                logger.warning(
+                    "Lazy CUDA graph capture: no memory headroom for %s bucket "
+                    "%d on some rank; it will keep running eagerly.",
+                    tick.phase,
+                    tick.size,
+                )
+            return None
+        start = self._clock()
+        target.capture_deferred(tick.size)
+        seconds = self._clock() - start
+        self._seq += 1
+        self.observe_step(phase=tick.phase, size=tick.size, seconds=seconds)
+        self._log_step(tick, seconds)
+        return tick
+
+    def _log_step(self, tick: LazyGraphCaptureTick, seconds: float) -> None:
+        if not self._is_leader:
+            return
+        remaining = sum(len(s.pending) for s in self._schedules())
+        logger.info(
+            "Lazy CUDA graph capture: %s bucket %d captured in %.3f s "
+            "(step %d, %d buckets pending).",
+            tick.phase,
+            tick.size,
+            seconds,
+            tick.seq,
+            remaining,
+        )
+        if remaining == 0:
+            logger.info("Lazy CUDA graph capture: all planned buckets captured.")
+
+
+def _fit_cost_model(
+    observations: List[Tuple[int, float]], default: Tuple[float, float]
+) -> Tuple[float, float]:
+    """Least-squares ``seconds = a + b * size``; falls back to ``default``."""
+    if not observations:
+        return default
+    if len(observations) == 1 or len({s for s, _ in observations}) == 1:
+        mean_s = sum(t for _, t in observations) / len(observations)
+        a_default, b_default = default
+        size = observations[0][0]
+        # Keep the default slope, shift the intercept to match what we saw.
+        return max(0.0, mean_s - b_default * size), b_default
+    n = len(observations)
+    mean_x = sum(s for s, _ in observations) / n
+    mean_y = sum(t for _, t in observations) / n
+    sxx = sum((s - mean_x) ** 2 for s, _ in observations)
+    sxy = sum((s - mean_x) * (t - mean_y) for s, t in observations)
+    b = max(0.0, sxy / sxx)
+    a = max(0.0, mean_y - b * mean_x)
+    return a, b
+
+
+def maybe_create_lazy_graph_capture(
+    *,
+    is_leader: bool,
+    decode_runner: Any,
+    prefill_runner: Any,
+    tp_cpu_group: Any,
+    tp_size: int,
+) -> Optional[LazyGraphCaptureController]:
+    """A controller when either graph runner has deferred buckets, else None."""
+    from sglang.srt.environ import envs
+
+    targets: Dict[str, LazyCaptureTarget] = {}
+    for phase, runner in (("decode", decode_runner), ("prefill", prefill_runner)):
+        # Eager / disabled phases have no lazy_schedule attribute.
+        schedule = getattr(runner, "lazy_schedule", None)
+        if schedule is not None:
+            targets[phase] = runner
+    if not targets:
+        return None
+    return LazyGraphCaptureController(
+        is_leader=is_leader,
+        targets=targets,
+        agree_min=_make_agree_min(tp_cpu_group=tp_cpu_group, tp_size=tp_size),
+        min_idle_s=envs.SGLANG_LAZY_CUDA_GRAPH_MIN_IDLE_S.get(),
+        idle_cost_ratio=envs.SGLANG_LAZY_CUDA_GRAPH_IDLE_COST_RATIO.get(),
+    )
+
+
+def _make_agree_min(
+    *, tp_cpu_group: Any, tp_size: int
+) -> Callable[[List[int]], List[int]]:
+    """Element-wise MIN over the TP ranks on the CPU (gloo) group."""
+    if tp_size == 1:
+        return list
+
+    import torch
+    import torch.distributed as dist
+
+    def agree_min(flags: List[int]) -> List[int]:
+        tensor = torch.tensor(flags, dtype=torch.int64)
+        dist.all_reduce(tensor, op=dist.ReduceOp.MIN, group=tp_cpu_group)
+        return [int(v) for v in tensor.tolist()]
+
+    return agree_min
