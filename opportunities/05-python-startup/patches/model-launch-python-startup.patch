From 69d2e173d77c1bd4b076c03dd7aca474e3a37763 Mon Sep 17 00:00:00 2001
From: pystartup <pystartup@localhost>
Date: Thu, 12 Nov 2026 06:40:23 +0100
Subject: [PATCH] images: ship bytecode; sglang: overridable entrypoint

The uv-built vLLM images contain no .pyc files, so the first process of every launch
compiles torch, transformers and vLLM from source (and every process does on a
read-only root). Add a gap-filling compileall step with unchecked-hash pycs to the
SGLang and vLLM Dockerfiles. Make the SGLang entrypoint overridable through
SML_SGLANG_ENTRYPOINT so a deployment can start SGLang through a launcher such as the
worker-zygote wrapper without a code change; the default is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 images/sglang_0.5.20/Dockerfile                  |  8 ++++++++
 images/sglang_cuda13/Dockerfile                  |  8 ++++++++
 images/vllm_0.30.0/Dockerfile                    |  8 ++++++++
 images/vllm_apertus_1.5_release/Dockerfile       |  8 ++++++++
 images/vllm_cuda13/Dockerfile                    |  8 ++++++++
 images/vllm_cuda13_v2/Dockerfile                 | 10 +++++++++-
 src/swiss_ai_model_launch/launchers/framework.py |  5 ++++-
 7 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/images/sglang_0.5.20/Dockerfile b/images/sglang_0.5.20/Dockerfile
index df392c9..486de92 100644
--- a/images/sglang_0.5.20/Dockerfile
+++ b/images/sglang_0.5.20/Dockerfile
@@ -89,4 +89,12 @@ RUN pip install --no-cache-dir nvidia-cublas==13.4.0.1 && \
     conda install -y curl && conda clean -ya && \
     pip install --no-cache-dir sglang-router==0.3.2
 
+# Ship bytecode with the image. Without it the first process of every launch compiles torch,
+# transformers and the engine from source (uv never compiles; pip does), and on a read-only
+# root every process does. Hash-based pycs that are never checked against the source
+# (PEP 552, unchecked-hash) suit an immutable image and survive mtime changes on the way to
+# the .sqsh. No -f: valid pycs that pip already wrote are kept.
+RUN python -m compileall -q -j 0 --invalidation-mode unchecked-hash "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
+    || echo "compileall: some sources did not compile (unimportable files); continuing"
+
 WORKDIR /opt
