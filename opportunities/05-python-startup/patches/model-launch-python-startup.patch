diff --git a/src/swiss_ai_model_launch/launchers/framework.py b/src/swiss_ai_model_launch/launchers/framework.py
index 9f626c2..6aa452d 100644
--- a/src/swiss_ai_model_launch/launchers/framework.py
+++ b/src/swiss_ai_model_launch/launchers/framework.py
@@ -53,7 +53,10 @@ class Framework:
 
 class Sglang(Framework):
     name = "sglang"
-    entrypoint = "python3 -m sglang.launch_server"
+    # Overridable at job runtime (bash expansion in the rank scripts), e.g.
+    # SML_SGLANG_ENTRYPOINT="python3 -m pystartup.sglang_launch --" to fork the TP
+    # workers from a preloaded zygote instead of spawning fresh interpreters.
+    entrypoint = "${SML_SGLANG_ENTRYPOINT:-python3 -m sglang.launch_server}"
     env_exports = [
         'export no_proxy="0.0.0.0,$no_proxy"',
         'export NO_PROXY="0.0.0.0,$NO_PROXY"',
