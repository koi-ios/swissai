From c8bafdea2a941777ad31d22aed681cb934cf05bc Mon Sep 17 00:00:00 2001
From: snarayana <snarayana@student.ethz.ch>
Date: Thu, 12 Nov 2026 01:36:48 +0100
Subject: [PATCH 1/3] test: skip the O_DIRECT stager tests where the platform
 has none

os.O_DIRECT does not exist on macOS, so the odirect_tmpdir fixture raised
AttributeError there and two tests errored instead of skipping. The stager
itself (GNU find/stat, bash 4) only runs on Linux anyway.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/test_launch.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tests/test_launch.py b/tests/test_launch.py
index 3be3eea..cc3994e 100644
--- a/tests/test_launch.py
+++ b/tests/test_launch.py
@@ -234,6 +234,8 @@ def test_the_vendored_stager_is_byte_identical_to_the_experiment():
 @pytest.fixture
 def odirect_tmpdir():
     """A temp dir on a filesystem that supports O_DIRECT, which the stager needs."""
+    if not hasattr(os, "O_DIRECT"):
+        pytest.skip("this platform has no O_DIRECT (macOS); the stager runs on Linux")
     with tempfile.TemporaryDirectory(dir=REPO) as d:
         probe = Path(d) / ".probe"
         probe.write_bytes(b"x" * 4096)
