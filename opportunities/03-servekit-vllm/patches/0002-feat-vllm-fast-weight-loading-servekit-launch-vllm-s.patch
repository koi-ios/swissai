+def copy_stage(delay=0.0):
+    def _stage(src, dest, slices=64, file_pattern="*"):
+        time.sleep(delay)
+        dest.mkdir(parents=True, exist_ok=True)
+        n = 0
+        for f in sorted(src.glob(file_pattern)):
+            if f.is_file():
+                (dest / f.name).write_bytes(f.read_bytes())
+                n += f.stat().st_size
+        return StageResult(dest=dest, wall_s=max(delay, 0.01), gbps=1.0, bytes=n)
+    return _stage
+
