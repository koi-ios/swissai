+        dest = isolated / "shm" / artifact.name
+        seen.update(command=command, env=env or {}, files=sorted(p.name for p in dest.iterdir()))
+        report = ProfileReport(command="", started_at=time.time(), ready_at=time.time() + 1, success=True,
+                               framework="vllm")
+        on_ready(report)
+        return report
+
+    monkeypatch.setattr("servekit.launch.stage", copy_stage())
+    monkeypatch.setattr("servekit.launch.run_profile", fake_run_profile)
+
+    assert _launch(isolated, model, artifact) == 0
+    dest = isolated / "shm" / artifact.name
+    assert seen["command"] == [
+        "vllm", "serve", str(dest), "--tensor-parallel-size", "2",
+        "--served-model-name", str(model), "--load-format", "sharded_state",
+    ]
+    assert "config.json" in seen["files"] and "model-rank-1-part-0.safetensors" in seen["files"]
+    assert seen["env"][_vllm_plugin.ENV_FLAG] == "1"
+    caches = isolated / "cache-root" / artifact.name
+    assert seen["env"]["VLLM_CACHE_ROOT"] == str(caches / "vllm")
+    assert {k: seen["env"][k] for k in vllm_cache.CACHES} == vllm_cache.env_for(caches)
+    assert "VLLM_PLUGINS" not in seen["env"], "VLLM_PLUGINS is part of vLLM's compile cache key"
