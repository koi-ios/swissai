new file mode 100644
index 0000000..0bab2d7
--- /dev/null
+++ b/src/servekit/vllm_cache.py
@@ -0,0 +1,74 @@
+"""Where a vLLM engine's compile and JIT caches live, so they outlive the job.
+
+The same scheme as `jit_cache` (a node-local copy at a fixed path, kept beside
+the checkpoint), with what vLLM adds:
+
+- VLLM_CACHE_ROOT holds torch.compile's artifacts
+  (<root>/torch_compile_cache/<hash>/rank_<r>_<dp>/, vllm/compilation/backends.py:1086-1104),
+  Inductor's cache (forced under it, compiler_interface.py:29-34), DeepGEMM's
+  JIT cache unless DG_JIT_CACHE_DIR is set (vllm/utils/deep_gemm.py:280-285),
+  and the opt-in startup plan. vLLM leaves it out of its compile cache key
+  (vllm/envs.py:2366), so moving it is safe;
+- TileLang, which follows none of them.
+
+The cache key does include the model path (vllm/config/model.py:457-525). The
+engine reads /dev/shm/servekit/<artifact name> on every launch, so the key is
+stable from one launch to the next. But no other run's cache fits it: not the
+sharding run's, which reads the source checkpoint, and not a plain vLLM run's.
+So the cache is written back after the first launch that compiled, instead of
+during prepare.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+from pathlib import Path
+from typing import Dict
+
+from . import jit_cache
+
+CACHES: Dict[str, str] = {
+    **jit_cache.CACHES,
+    "VLLM_CACHE_ROOT": "vllm",
+    "TILELANG_CACHE_DIR": "tilelang",
+}
+
+
+def env_for(root: Path) -> Dict[str, str]:
+    return {var: str(root / subdir) for var, subdir in CACHES.items()}
+
+
+def create(root: Path) -> Dict[str, str]:
+    for subdir in CACHES.values():
+        (root / subdir).mkdir(parents=True, exist_ok=True)
+    return env_for(root)
+
+
+def write_back(node_local: Path, kept: Path) -> int:
+    """Copy the files `kept` does not have yet from `node_local`; return how many.
+
+    Never overwrites: a file already kept was written by an earlier launch or
+    by another node, and concurrent launches would otherwise race on it. Each
+    file lands under a temporary name and is renamed, so a launch seeding from
+    `kept` at the same time sees whole files or none. Several nodes can write
+    back into one artifact: each adds its own ranks' files.
+    """
+    if not node_local.is_dir():
+        return 0
+    added = 0
+    for src in sorted(p for p in node_local.rglob("*") if p.is_file() and not p.is_symlink()):
+        dest = kept / src.relative_to(node_local)
+        if dest.exists():
+            continue
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        tmp = dest.with_name(f".{dest.name}.servekit-{os.getpid()}.tmp")
+        try:
+            shutil.copy2(src, tmp)
+            os.replace(tmp, dest)
+            added += 1
+        except OSError:
+            try:
+                tmp.unlink()
+            except OSError:
+                pass
+    return added
diff --git a/src/servekit/vllm_guard.py b/src/servekit/vllm_guard.py
new file mode 100644
index 0000000..ca22a3a
--- /dev/null
+++ b/src/servekit/vllm_guard.py
@@ -0,0 +1,136 @@
+"""What vLLM's `sharded_state` cannot round-trip, so servekit will not preshard it.
+
+vLLM's saver dumps the model's state dict *after* process_weights_after_loading
+(vllm/model_executor/model_loader/sharded_state_loader.py:268-303), and its
+loader copies that dump into a freshly built model in checkpoint layout, then
+runs process_weights_after_loading a second time (base_loader.py:88, 109).
+vLLM's own weight cache (`--load-format ipc_cache`) solves the same problem
+properly: it refuses any quant method that does not declare
+`supports_pre_processed_weights` and re-runs the hook under
+`weights_already_processed()` (weight_cache/ipc_loader.py:295-313).
+ShardedStateLoader does neither. So, as of vLLM 0.33:
+
+- quantized checkpoints are post-processed twice;
+- MLA layers register W_UV / W_UK_T as new parameters after loading
+  (layers/attention/mla_attention.py:1347-1350), which a freshly built model
+  has no slot for;
+- expert parallelism gives each data-parallel rank its own experts under the
+  same file name (the names carry only pp and tp ranks);
+- LoRA pads parameters that the dump does not have, and vLLM's own saver
+  refuses it;
+- a speculative draft model is loaded with the same --load-format from a
+  checkpoint nobody presharded.
+
+Unlike `quant_guard`, nothing here was observed corrupting a model: the rules
+come from reading vLLM 0.33. A refusal therefore means "serve with vLLM's own
+loader", not an error. SERVEKIT_VLLM_ALLOW_QUANTIZED=1 lifts only the
+quantization rule, for experiments that run `servekit verify` before trusting
+the result.
+"""
+from __future__ import annotations
+
+import json
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import List, Mapping, Optional, Sequence
+
+from .engine_args import _find_flag
+
+ALLOW_QUANTIZED_ENV = "SERVEKIT_VLLM_ALLOW_QUANTIZED"
+
+
+@dataclass(frozen=True)
+class Setup:
+    """The checkpoint's config and the serve flags that change what a rank holds."""
+
+    config: Mapping = field(default_factory=dict)
+    quantization_flag: Optional[str] = None
+    gguf_files: bool = False
+    expert_parallel: bool = False
+    lora: bool = False
+    speculative: bool = False
+    config_file: bool = False
+    allow_quantized: bool = False
+
+    def _get(self, key: str):
+        """A key from the top-level config, or from a multimodal model's text_config."""
+        if key in self.config:
+            return self.config[key]
+        text = self.config.get("text_config") or {}
+        return text.get(key) if isinstance(text, Mapping) else None
+
+    @property
+    def quantized(self) -> bool:
+        flag = (self.quantization_flag or "").lower()
+        return bool(self._get("quantization_config")) or flag not in ("", "none") or self.gguf_files
+
+    @property
+    def mla(self) -> bool:
+        return bool(self._get("kv_lora_rank"))
+
+
+RULES = [
+    ("a quantized checkpoint (post-processed twice on reload)",
+     lambda s: s.quantized and not s.allow_quantized),
+    ("MLA attention (W_UV / W_UK_T are created after loading)",
+     lambda s: s.mla),
+    ("--enable-expert-parallel (experts differ per data-parallel rank under one file name)",
+     lambda s: s.expert_parallel),
+    ("--enable-lora (padded parameters the shards do not have)",
+     lambda s: s.lora),
+    ("--speculative-config (the draft model is not presharded)",
+     lambda s: s.speculative),
+    ("--config (servekit cannot see the settings in a config file; put them on the command line)",
+     lambda s: s.config_file),
+]
+
+
+def check(setup: Setup) -> List[str]:
+    """What about this setup servekit will not preshard for vLLM. Empty means go ahead."""
+    return [name for name, triggers in RULES if triggers(setup)]
+
+
+def _read_config(model_dir: Path) -> dict:
+    path = Path(model_dir) / "config.json"
+    if not path.is_file():
+        return {}
+    try:
+        config = json.loads(path.read_text())
+    except (json.JSONDecodeError, OSError):
+        return {}
+    return config if isinstance(config, dict) else {}
+
+
+def _has(command: Sequence[str], *flags: str) -> bool:
+    """A boolean flag that is on: `--x`, or `--x=true`; `--no-x` and `--x=false` are off."""
+    for arg in command:
+        for flag in flags:
+            if arg == flag:
+                return True
+            if arg.startswith(flag + "="):
+                return arg.split("=", 1)[1].lower() not in ("false", "0", "no")
+    return False
+
+
+def check_command(model_dir: Path, command: Sequence[str]) -> List[str]:
+    """`check` for a checkpoint directory and a `vllm serve` command line."""
+    command = list(command)
+    found = _find_flag(command, ["--quantization", "-q"])
+    return check(Setup(
+        config=_read_config(model_dir),
+        quantization_flag=found[1] if found else None,
+        gguf_files=any(Path(model_dir).glob("*.gguf")),
+        expert_parallel=_has(command, "--enable-expert-parallel", "--enable_expert_parallel", "-ep"),
+        lora=_has(command, "--enable-lora", "--enable_lora"),
+        speculative=_find_flag(command, ["--speculative-config", "--speculative_config", "-sc"]) is not None,
+        config_file=_find_flag(command, ["--config"]) is not None,
+        allow_quantized=os.environ.get(ALLOW_QUANTIZED_ENV) == "1",
+    ))
+
+
+def explain(unsupported: Sequence[str], model_dir) -> str:
+    return (
+        f"[SERVEKIT] vllm's sharded_state cannot round-trip {', '.join(unsupported)} ({model_dir}); "
+        f"serving it with vllm's own loader instead"
+    )
