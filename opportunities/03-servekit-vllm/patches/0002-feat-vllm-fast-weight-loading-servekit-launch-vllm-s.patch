diff --git a/src/servekit/_prepare/save_sharded_state_vllm.py b/src/servekit/_prepare/save_sharded_state_vllm.py
new file mode 100644
index 0000000..1d156f5
--- /dev/null
+++ b/src/servekit/_prepare/save_sharded_state_vllm.py
@@ -0,0 +1,148 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Write a TP/PP-presharded checkpoint for `vllm serve --load-format sharded_state`.
+
+Adapted from vLLM's examples/features/sharded_state/save_sharded_state_offline.py
+(v0.33.0, Apache-2.0, Copyright contributors to the vLLM project). Changes:
+
+- it parses every `vllm serve` flag, not only the engine's, so `prepare` can
+  hand it the serve command it will later launch;
+- it forces what saving does not need: eager mode (no torch.compile, no CUDA
+  graphs), one data-parallel replica (DP replicas would write the same file
+  names at once), and the source checkpoint's own loader;
+- it skips stale `*.index.json` files and subdirectories when copying metadata;
+- it reports what the engine resolved (`--servekit-resolved-out`) for the manifest.
+
+The head node runs this. Every other node of a multi-node layout runs the
+headless worker its serve command describes (`vllm serve ... --headless`), and
+`save_sharded_state` is a collective RPC that returns only once every worker,
+remote ones included, has written its files (vllm/v1/executor/abstract.py:328).
+"""
+from __future__ import annotations
+
+import dataclasses
+import json
+import os
+import shutil
+import sys
+from pathlib import Path
+
+from servekit import vllm_guard
+
+# Saving needs one replica and no compilation; everything else is the serve command's.
+FORCED = {"enforce_eager": True, "load_format": "auto"}
+ONE_REPLICA = (
+    "data_parallel_size", "data_parallel_size_local", "data_parallel_rank",
+    "data_parallel_start_rank", "data_parallel_address", "data_parallel_rpc_port",
+    "data_parallel_hybrid_lb", "data_parallel_external_lb", "api_server_count",
+)
+
+
+def _parser():
+    try:
+        from vllm.utils.argparse_utils import FlexibleArgumentParser
+    except ImportError:  # vLLM < 0.11
+        from vllm.utils import FlexibleArgumentParser
+    parser = FlexibleArgumentParser()
+    make_arg_parser = None
+    for module in ("vllm.entrypoints.common.cli_args", "vllm.entrypoints.openai.cli_args"):
+        try:
+            make_arg_parser = __import__(module, fromlist=["make_arg_parser"]).make_arg_parser
+            break
+        except (ImportError, AttributeError):
+            continue
+    if make_arg_parser is not None:
+        parser = make_arg_parser(parser)
+    else:
+        from vllm import EngineArgs
+
+        EngineArgs.add_cli_args(parser)
+    parser.add_argument("--output", "-o", required=True, type=str, help="path to output checkpoint")
+    parser.add_argument("--file-pattern", type=str, default=None, help="saved file names")
+    parser.add_argument("--max-file-size", type=int, default=5 * 1024**3,
+                        help="max size (in bytes) of each safetensors file")
+    parser.add_argument("--servekit-resolved-out", type=str, default=None)
+    return parser
+
+
+def _defaults(cls) -> dict:
+    out = {}
+    for f in dataclasses.fields(cls):
+        if f.default is not dataclasses.MISSING:
+            out[f.name] = f.default
+        elif f.default_factory is not dataclasses.MISSING:  # type: ignore[misc]
+            out[f.name] = f.default_factory()  # type: ignore[misc]
+    return out
+
+
+def resolved(llm, engine_args) -> dict:
+    """What the engine decided: --dtype auto becomes the checkpoint's dtype."""
+    import vllm
+
+    model_config = getattr(llm.llm_engine, "model_config", None)
+    dtype = getattr(model_config, "dtype", None) if model_config is not None else None
+    quantization = getattr(model_config, "quantization", None) if model_config is not None else None
+    return {
+        "engine": "vllm",
+        "engine_version": getattr(vllm, "__version__", "unknown"),
+        "tp_size": engine_args.tensor_parallel_size,
+        "pp_size": engine_args.pipeline_parallel_size,
+        "dp_size": 1,
+        "dtype": str(dtype).replace("torch.", "") if dtype is not None else str(engine_args.dtype),
+        "quantization": quantization if quantization is not None else engine_args.quantization,
+    }
+
+
+def main(argv=None) -> int:
+    args = _parser().parse_args(argv)
+    from vllm import LLM, EngineArgs
+
+    if getattr(args, "model_tag", None):
+        args.model = args.model_tag
+    engine_args = EngineArgs.from_cli_args(args)
+    model_path = engine_args.model
+    if not Path(model_path).is_dir():
+        raise ValueError("model path must be a local directory")
+
+    # Before the engine, so an unsupported checkpoint costs a second rather than
+    # a full load followed by a dump nobody can trust.
+    unsupported = vllm_guard.check_command(Path(model_path), sys.argv[1:] if argv is None else argv)
+    if unsupported:
+        print(vllm_guard.explain(unsupported, model_path).replace("serving it", "not presharding it"),
+              file=sys.stderr)
+        return 2
+
+    defaults = _defaults(EngineArgs)
+    for name in ONE_REPLICA:
+        if hasattr(engine_args, name) and name in defaults:
+            setattr(engine_args, name, defaults[name])
+    for name, value in FORCED.items():
+        setattr(engine_args, name, value)
+
+    out = Path(args.output)
+    out.mkdir(parents=True, exist_ok=True)
+    llm = LLM.from_engine_args(engine_args)
+    llm.llm_engine.engine_core.save_sharded_state(
+        path=str(out), pattern=args.file_pattern, max_size=args.max_file_size
+    )
+
+    for file in sorted(os.listdir(model_path)):
+        src = os.path.join(model_path, file)
+        if os.path.isdir(src):
+            print(f"  skipping directory {file}/")
+            continue
+        if os.path.splitext(file)[1] in (".bin", ".pt", ".pth", ".safetensors"):
+            continue
+        if file.endswith(".index.json"):
+            print(f"  skipping stale weight index {file}")
+            continue
+        shutil.copy(src, os.path.join(out, file))
+
+    if args.servekit_resolved_out:
+        with open(args.servekit_resolved_out, "w") as f:
+            json.dump(resolved(llm, engine_args), f)
+    print(f"saved sharded checkpoint to {out}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/servekit/_vllm_plugin.py b/src/servekit/_vllm_plugin.py
new file mode 100644
index 0000000..b637341
--- /dev/null
+++ b/src/servekit/_vllm_plugin.py
@@ -0,0 +1,253 @@
+"""vLLM plugin: the --overlap stage barrier, strict loads, and per-rank load
+records for `--load-format sharded_state`.
+
+vLLM spawns its workers as fresh interpreters, so a patch made in servekit's
+process never reaches the code that reads the weights; the same reason
+servekit's SGLang half is a plugin (servekit._shim). vLLM runs every
+`vllm.general_plugins` entry point in every process, workers included, before
+the model loads (vllm/v1/worker/worker_base.py:287-289), and lets a plugin
+replace the class behind a load format (register_model_loader,
+vllm/model_executor/model_loader/__init__.py:69-120). So this needs no fork.
+
+The class keeps the name `sharded_state` on purpose: vLLM special-cases that
+name (it does not untie word embeddings for it, vllm/config/vllm.py:1612-1620),
+and a new name would lose that.
+
+Over vLLM's own ShardedStateLoader it adds three things, all in load_weights:
+
+1. the stage barrier: block until servekit's stage into the model directory
+   has published done (servekit._shim's marker protocol; no marker, no wait),
+   right before the read, so model construction still overlaps the stage;
+2. strictness: ShardedStateLoader narrows a tensor that is smaller than its
+   parameter and casts one of another dtype, with only a warning
+   (sharded_state_loader.py:224-244). A checkpoint presharded for TP=4 and
+   loaded at TP=2 does exactly that, and serves. Those warnings become errors;
+3. a record per rank: vLLM logs "Model loading took" on local rank 0 only
+   (info_once, scope "local"), so the slowest rank is invisible, and a
+   headless node never says it is done reading. Each rank writes its own load
+   time next to the staged copy; servekit reports the max and frees a node's
+   copy only once every local rank has read it.
+
+None of it happens unless servekit started the engine: launch sets
+SERVEKIT_VLLM_LOADER=1, which vLLM does not hash into its compile cache key
+(only its own variables are hashed). VLLM_PLUGINS is hashed, so servekit
+never sets that.
+
+vLLM imports stay inside function bodies: servekit imports this module to read
+markers, and must not pull vLLM into its own process.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import sys
+import time
+from typing import Dict, Iterable, List, Optional, Tuple
+
+from . import _shim
+
+ENV_FLAG = "SERVEKIT_VLLM_LOADER"
+STRICT_ENV = "SERVEKIT_VLLM_STRICT"
+STAGE_TIMEOUT_ENV = "SERVEKIT_STAGE_TIMEOUT"
+ENTRY_POINT_GROUP = "vllm.general_plugins"
+ENTRY_POINT_NAME = "servekit"
+LOAD_FORMAT = "sharded_state"
+
+# The two things ShardedStateLoader logs and then does anyway.
+_SILENT_TEMPLATES = ("loading tensor of shape", "Attempted to load weight")
+
+
+# --- per-rank load records ---------------------------------------------------
+
+def loaded_dir(dest: str) -> str:
+    p = os.path.normpath(dest)
+    return os.path.join(os.path.dirname(p), f".{os.path.basename(p)}.loaded")
+
+
+def rank_key(pp_rank: int, tp_rank: int) -> str:
+    return f"pp{pp_rank}-tp{tp_rank}"
+
+
+def record_loaded(dest: str, key: str, info: dict) -> None:
+    """Atomically write one rank's record; a reader never sees half of one."""
+    d = loaded_dir(dest)
+    os.makedirs(d, exist_ok=True)
+    final = os.path.join(d, f"{key}.json")
+    tmp = f"{final}.{os.getpid()}.tmp"
+    with open(tmp, "w") as f:
+        json.dump(info, f)
+    os.replace(tmp, final)
+
+
+def read_loaded(dest: str) -> Dict[str, dict]:
+    d = loaded_dir(dest)
+    out: Dict[str, dict] = {}
+    try:
+        names = os.listdir(d)
+    except FileNotFoundError:
+        return out
+    for name in names:
+        if not name.endswith(".json"):
+            continue
+        try:
+            with open(os.path.join(d, name)) as f:
+                out[name[: -len(".json")]] = json.load(f)
+        except (OSError, json.JSONDecodeError):
+            continue
+    return out
+
+
+def wait_for_loaded(
+    dest: str, keys: Iterable[str], timeout_s: float = 1800, poll_s: float = 0.2
+) -> Dict[str, dict]:
+    """Block until every rank in `keys` has recorded its load; return the records."""
+    want = list(keys)
+    deadline = time.monotonic() + timeout_s
+    while True:
+        seen = read_loaded(dest)
+        pending = [k for k in want if k not in seen]
+        if not pending:
+            return {k: seen[k] for k in want}
+        if time.monotonic() > deadline:
+            raise TimeoutError(
+                f"timed out after {timeout_s}s waiting for {len(pending)} rank(s) to finish "
+                f"reading {dest}: {', '.join(pending)}"
+            )
+        time.sleep(poll_s)
+
+
+def clear_loaded(dest: str) -> None:
+    d = loaded_dir(dest)
+    try:
+        names = os.listdir(d)
+    except FileNotFoundError:
+        return
+    for name in names:
+        try:
+            os.unlink(os.path.join(d, name))
+        except FileNotFoundError:
+            pass
+    try:
+        os.rmdir(d)
+    except OSError:
+        pass
+
+
+# --- the loader ----------------------------------------------------------------
+
+class _Collector(logging.Handler):
+    """Keeps the narrowing and dtype-cast warnings a load emits."""
+
+    def __init__(self) -> None:
+        super().__init__(level=logging.WARNING)
+        self.messages: List[str] = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        if isinstance(record.msg, str) and record.msg.startswith(_SILENT_TEMPLATES):
+            try:
+                self.messages.append(record.getMessage())
+            except Exception:  # noqa: BLE001 - a bad format string is still a hit
+                self.messages.append(str(record.msg))
+
+
+def _strict() -> bool:
+    return os.environ.get(STRICT_ENV, "1") != "0"
+
+
+def _ranks() -> Tuple[int, int, int]:
+    """(global rank, tp rank, pp rank) of this worker; zeros outside a process group."""
+    try:
+        from vllm.distributed import get_pp_group, get_tensor_model_parallel_rank
+
+        tp_rank = get_tensor_model_parallel_rank()
+        pp_rank = get_pp_group().rank_in_group
+    except Exception:  # noqa: BLE001 - single process, or an older vLLM
+        tp_rank = pp_rank = 0
+    try:
+        import torch.distributed as dist
+
+        rank = dist.get_rank() if dist.is_initialized() else 0
+    except Exception:  # noqa: BLE001
+        rank = 0
+    return rank, tp_rank, pp_rank
+
+
+def make_loader(base: type) -> type:
+    """A subclass of vLLM's ShardedStateLoader with the barrier, strictness and records."""
+
+    class ServekitShardedStateLoader(base):  # type: ignore[misc, valid-type]
+        def load_weights(self, model, model_config) -> None:
+            dest = getattr(model_config, "model_weights", None) or model_config.model
+            t_wait = time.monotonic()
+            _shim.wait_for_stage(dest, timeout_s=float(os.environ.get(STAGE_TIMEOUT_ENV, 1800)))
+            waited = time.monotonic() - t_wait
+
+            collector = _Collector()
+            logger = logging.getLogger(base.__module__)
+            logger.addHandler(collector)
+            t0 = time.monotonic()
+            try:
+                super().load_weights(model, model_config)
+            finally:
+                logger.removeHandler(collector)
+            seconds = time.monotonic() - t0
+
+            if collector.messages and _strict():
+                shown = "; ".join(collector.messages[:3])
+                more = f" (+{len(collector.messages) - 3} more)" if len(collector.messages) > 3 else ""
+                raise ValueError(
+                    f"[SERVEKIT] refusing to serve {dest}: vLLM narrowed or cast "
+                    f"{len(collector.messages)} tensor(s) while loading it, which means the "
+                    f"checkpoint was presharded for different settings: {shown}{more}. "
+                    f"Re-prepare it, or set {STRICT_ENV}=0 to load anyway."
+                )
+
+            rank, tp_rank, pp_rank = _ranks()
+            record_loaded(dest, rank_key(pp_rank, tp_rank), {
+                "rank": rank, "tp_rank": tp_rank, "pp_rank": pp_rank, "pid": os.getpid(),
+                "load_s": round(seconds, 3), "barrier_wait_s": round(waited, 3),
+            })
+
+    ServekitShardedStateLoader.__qualname__ = ServekitShardedStateLoader.__name__
+    return ServekitShardedStateLoader
+
+
+def register() -> None:
+    """vLLM plugin entry point; runs in every vLLM process, so it must be idempotent."""
+    if os.environ.get(ENV_FLAG) != "1":
+        return
+    try:
+        from vllm.model_executor.model_loader import register_model_loader
+        from vllm.model_executor.model_loader.sharded_state_loader import ShardedStateLoader
+    except Exception as e:  # noqa: BLE001 - a missing piece is a log line, not a crash
+        print(f"[SERVEKIT] not registering the sharded_state barrier: {e}", file=sys.stderr, flush=True)
+        return
+    register_model_loader(LOAD_FORMAT)(make_loader(ShardedStateLoader))
+
+
+# --- for launch: will the plugin be there? -----------------------------------
+
+def plugin_problem(env: Optional[Dict[str, str]] = None) -> Optional[str]:
+    """Why the engine would load without this plugin, or None if it will have it.
+
+    Checks this interpreter's installed entry points, which is the engine's
+    when `vllm` runs from the same environment as servekit, and the allowlist
+    vLLM applies to them (vllm/plugins/__init__.py:56-64).
+    """
+    env = dict(os.environ if env is None else env)
+    try:
+        from importlib.metadata import entry_points
+
+        found = entry_points(group=ENTRY_POINT_GROUP)
+    except Exception as e:  # noqa: BLE001
+        return f"cannot read installed entry points ({e})"
+    if not any(ep.name == ENTRY_POINT_NAME and ep.value.startswith(__name__) for ep in found):
+        return (
+            f"servekit's {ENTRY_POINT_GROUP} entry point is not installed in this environment "
+            f"(reinstall servekit with pip)"
+        )
+    allowed = env.get("VLLM_PLUGINS")
+    if allowed is not None and ENTRY_POINT_NAME not in allowed.split(","):
+        return f"VLLM_PLUGINS={allowed!r} does not allow the {ENTRY_POINT_NAME!r} plugin"
+    return None
