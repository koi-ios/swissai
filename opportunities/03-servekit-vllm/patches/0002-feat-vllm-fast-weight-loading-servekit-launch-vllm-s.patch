+# --- end to end: a mock `vllm serve` behind the real run_profile --------------------------
+
+MOCK_ENGINE = r'''
+import glob, hashlib, json, os, signal, sys, threading, time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from servekit import _shim, _vllm_plugin
+
+argv = sys.argv[1:]
+assert argv[0] == "serve", argv
+model = argv[1]
+def opt(name, default=None):
+    return argv[argv.index(name) + 1] if name in argv else default
+tp = int(opt("--tensor-parallel-size", "1"))
+facts = {"model": model, "served": opt("--served-model-name"), "load_format": opt("--load-format"),
+         "flag": os.environ.get(_vllm_plugin.ENV_FLAG), "cache_root": os.environ.get("VLLM_CACHE_ROOT"),
+         "marker_at_start": None}
+marker = _shim.stage_marker(model)
+if os.path.exists(marker):
+    facts["marker_at_start"] = open(marker).read()
+print(f"(APIServer pid={os.getpid()}) INFO non-default args: {{'model': '{model}'}}", flush=True)
+expected = json.loads(os.environ["MOCK_EXPECT"])
+
+def worker(rank):
+    # What servekit's loader does around vLLM's: barrier, read, record.
+    _shim.wait_for_stage(model, timeout_s=30, poll_s=0.01)
+    t0 = time.monotonic()
+    for path in glob.glob(os.path.join(model, f"model-rank-{rank}-part-*.safetensors")):
+        digest = hashlib.sha256(open(path, "rb").read()).hexdigest()
+        if digest != expected[os.path.basename(path)]:
+            print(f"(Worker_TP{rank} pid={os.getpid()}) ERROR read a partial {path}", flush=True)
+            os._exit(3)
+    _vllm_plugin.record_loaded(model, _vllm_plugin.rank_key(0, rank), {"load_s": time.monotonic() - t0})
+
+threads = [threading.Thread(target=worker, args=(r,)) for r in range(tp)]
+[t.start() for t in threads]
+[t.join() for t in threads]
+print(f"(Worker_TP0 pid={os.getpid()}) INFO Model loading took 1.00 GiB memory and 0.500000 seconds", flush=True)
+json.dump(facts, open(os.environ["MOCK_FACTS"], "w"))
+print(f"(APIServer pid={os.getpid()}) INFO:     Application startup complete.", flush=True)
+time.sleep(float(os.environ.get("MOCK_SERVE_S", "0.5")))
+'''
+
+
+def test_end_to_end_overlap_through_a_mock_vllm(isolated, prepared, monkeypatch):
+    model, artifact = prepared
+    for r, nbytes in enumerate((3 * 2**20 + 1, 2**20)):
+        (artifact / f"model-rank-{r}-part-0.safetensors").write_bytes(os.urandom(nbytes))
+    expected = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in artifact.glob("model-*")}
+    bin_dir = isolated / "bin"
+    bin_dir.mkdir()
+    engine = isolated / "mock_engine.py"
+    engine.write_text(MOCK_ENGINE)
+    launcher = bin_dir / "vllm"
+    launcher.write_text(f'#!/bin/sh\nexec "{sys.executable}" "{engine}" "$@"\n')
+    launcher.chmod(launcher.stat().st_mode | stat.S_IEXEC)
+    facts = isolated / "facts.json"
+    monkeypatch.setenv("MOCK_EXPECT", json.dumps(expected))
+    monkeypatch.setenv("MOCK_FACTS", str(facts))
+
+    def slow_partial_writer(src, stage_dest, slices=64, file_pattern="*"):
+        """Writes each shard in two halves with a pause between, like a stage in flight."""
+        stage_dest.mkdir(parents=True, exist_ok=True)
+        n = 0
+        for f in sorted(src.glob(file_pattern)):
+            data = f.read_bytes()
+            with open(stage_dest / f.name, "wb") as out:
+                out.write(data[: len(data) // 2])
+                out.flush()
+                time.sleep(0.3)
+                out.write(data[len(data) // 2:])
+            n += len(data)
+        return StageResult(dest=stage_dest, wall_s=0.6, gbps=1.0, bytes=n)
+
+    monkeypatch.setattr("servekit.launch.stage", slow_partial_writer)
+    rc = main([
+        "launch", "--servekit-artifact-path", str(artifact), "--out", str(isolated / "run.json"),
+        "--overlap", "--timeout", "60",
+        "--", str(launcher), "serve", str(model), "--tensor-parallel-size", "2",
+    ])
+
+    assert rc == 0
+    seen = json.loads(facts.read_text())
+    dest = isolated / "shm" / artifact.name
+    assert seen["model"] == str(dest) and seen["served"] == str(model)
+    assert seen["load_format"] == "sharded_state" and seen["flag"] == "1"
+    assert seen["marker_at_start"] == _shim.STAGE_PENDING, "the engine did not start before the stage ended"
+    assert seen["cache_root"].startswith(str(isolated / "cache-root"))
+    report = json.loads((isolated / "run.json").read_text())
+    assert report["success"] and report["framework"] == "vllm"
+    assert not dest.exists() and _vllm_plugin.read_loaded(str(dest)) == {}
+    assert not Path(_shim.stage_marker(str(dest))).exists()
