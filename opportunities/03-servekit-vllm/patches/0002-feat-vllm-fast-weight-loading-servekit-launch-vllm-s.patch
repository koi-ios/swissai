diff --git a/src/servekit/engine_args.py b/src/servekit/engine_args.py
index 49442fa..1cc6248 100644
--- a/src/servekit/engine_args.py
+++ b/src/servekit/engine_args.py
@@ -28,24 +28,65 @@ def _find_flag(command: List[str], flags: List[str]) -> Optional[Tuple[int, str]
     return None
 
 
+def _find_positional(command: List[str], subcommand: str) -> Optional[Tuple[int, str]]:
+    """The argument right after `subcommand`, if it is not an option.
+
+    Only a `subcommand` before the first long option counts, so an option value
+    that happens to spell it (`--served-model-name serve`) is not one; single-dash
