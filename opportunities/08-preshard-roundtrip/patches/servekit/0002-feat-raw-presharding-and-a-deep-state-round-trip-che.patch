@@ -0,0 +1,5 @@
+"""Raw presharding: store the checkpoint bytes each rank reads, replay them through the engine's own load.
+
+`footprint` finds which bytes a load reads, `store` writes and replays them,
+`sglang_hooks` wires both into SGLang through servekit's plugin.
+"""
diff --git a/src/servekit/rawshard/footprint.py b/src/servekit/rawshard/footprint.py
new file mode 100644
index 0000000..bbc314c
--- /dev/null
+++ b/src/servekit/rawshard/footprint.py
@@ -0,0 +1,400 @@
+"""Which bytes of each checkpoint tensor one rank's load actually reads.
+
+Raw presharding stores, per rank, exactly the bytes of the original checkpoint
+that the engine's ordinary load read on that rank, and feeds them back through
+the ordinary load later. Every weight loader, post-processing hook and lazily
+created alias then runs as in a default load, because it *is* a default load,
+just from fewer bytes.
+
+The footprint of a load is found by wrapping every checkpoint tensor the
+weights iterator yields in `FootprintTensor`, a wrapper subclass that sees
+every aten op applied to it or to a view of it:
+
+* a view op (narrow, slice, select, view, t, split, chunk, as_strided, ...)
+  returns another wrapper over the same base, and reads nothing;
+* any other op reads every byte of every wrapped input it is given. The view's
+  (storage offset, sizes, strides) relative to the base tell exactly which bytes
+  those are; they are kept as a strided byte box.
+
+Over-approximating is always safe: a box that covers bytes the loader never
+looks at only costs disk. Methods that leave the dispatcher (numpy, tolist,
+data_ptr, untyped_storage) are overridden to record the whole tensor.
+
+Nothing here imports an engine: the same recorder serves SGLang and, later, vLLM.
+"""
+from __future__ import annotations
+
+import math
+import threading
+import weakref
+from dataclasses import dataclass, field
+from typing import Dict, Iterable, Iterator, List, Optional, Sequence, Tuple
+
+import torch
+from torch.utils._pytree import tree_flatten, tree_map
+
+# A box with more contiguous runs than this is recorded as its bounding interval.
+# Bounds the cost of verification; an over-approximation is still a correct one.
+MAX_RUNS = 1 << 20
+
+
+@dataclass(frozen=True)
+class Box:
+    """A strided set of bytes of one base tensor: {offset + sum(i_k * strides[k])}.
+
+    Canonical: no size-1 dims, strides strictly decreasing, adjacent dims merged
+    wherever they are contiguous, innermost stride 1 (a byte). Two reads of the
+    same bytes therefore produce equal boxes, which is what makes the common
+    verification case a set lookup.
+    """
+
+    offset: int
+    sizes: Tuple[int, ...]
+    strides: Tuple[int, ...]
+
+    @property
+    def nbytes(self) -> int:
+        return math.prod(self.sizes) if self.sizes else 0
+
+    @property
+    def n_runs(self) -> int:
+        return math.prod(self.sizes[:-1]) if len(self.sizes) > 1 else 1
+
+    @property
+    def end(self) -> int:
+        """One past the last byte the box touches."""
+        return self.offset + sum((s - 1) * t for s, t in zip(self.sizes, self.strides)) + 1
+
+    def to_json(self) -> list:
+        return [self.offset, list(self.sizes), list(self.strides)]
+
+    @classmethod
+    def from_json(cls, data: Sequence) -> "Box":
+        offset, sizes, strides = data
+        return cls(int(offset), tuple(int(s) for s in sizes), tuple(int(t) for t in strides))
+
+    def runs(self) -> Tuple["torch.Tensor", int]:
+        """(start offsets of every contiguous run, run length). int64, sorted."""
+        if not self.sizes:
+            return torch.empty(0, dtype=torch.int64), 0
+        inner = self.sizes[-1]
+        starts = torch.tensor([self.offset], dtype=torch.int64)
+        for size, stride in zip(self.sizes[:-1], self.strides[:-1]):
+            steps = torch.arange(size, dtype=torch.int64) * stride
+            starts = (starts[:, None] + steps[None, :]).reshape(-1)
+        return torch.sort(starts).values, inner
+
+
+def canonical_box(offset: int, sizes: Sequence[int], strides: Sequence[int]) -> Optional[Box]:
+    """The canonical box for a byte view, or None if it holds no bytes.
+
+    `sizes` and `strides` are in bytes and must include the innermost byte dim.
+    Negative strides do not occur for torch views; zero strides (expand) are
+    dropped, since they re-read the same bytes.
+    """
+    if any(s == 0 for s in sizes):
+        return None
+    dims = [(t, s) for s, t in zip(sizes, strides) if s != 1 and t != 0]
+    dims.sort(key=lambda d: -d[0])
+    merged: List[List[int]] = []
+    for stride, size in dims:
+        if merged:
+            outer_stride, outer_size = merged[-1]
+            if outer_stride == stride * size:
+                # the outer dim steps over exactly one inner dim: one longer run
+                merged[-1] = [stride, outer_size * size]
+                continue
+        merged.append([stride, size])
+    if not merged or merged[-1][0] != 1:
+        # every element of the view is a single byte apart from the next only
+        # through the byte dim; one with no byte dim left means a 1-byte view
+        merged.append([1, 1])
+    box = Box(int(offset), tuple(int(s) for _, s in merged), tuple(int(t) for t, _ in merged))
+    if box.n_runs > MAX_RUNS:
+        return Box(box.offset, (box.end - box.offset,), (1,))
+    return box
+
+
+def full_box(nbytes: int) -> Optional[Box]:
+    return Box(0, (nbytes,), (1,)) if nbytes > 0 else None
+
+
+def view_box(view: torch.Tensor, base: torch.Tensor) -> Optional[Box]:
+    """The bytes of `base` that reading `view` touches. Both share one storage."""
+    elem = view.element_size()
+    offset = view.storage_offset() * elem - base.storage_offset() * base.element_size()
+    sizes = list(view.size()) + [elem]
+    strides = [st * elem for st in view.stride()] + [1]
+    box = canonical_box(offset, sizes, strides)
+    if box is not None and (box.offset < 0 or box.end > base_nbytes(base)):
+        # a view reaching outside its base would be an engine bug, not ours;
+        # still record something that cannot under-cover what was read
+        return full_box(base_nbytes(base))
+    return box
+
+
+def base_nbytes(t: torch.Tensor) -> int:
+    return t.numel() * t.element_size()
+
+
+class Footprint:
+    """The bytes one rank read of one checkpoint tensor, plus what it was."""
+
+    __slots__ = ("name", "shape", "dtype", "nbytes", "boxes", "full", "order", "live")
+
+    def __init__(self, name: str, shape: Tuple[int, ...], dtype: torch.dtype, order: int):
+        self.name = name
+        self.shape = shape
+        self.dtype = dtype
+        self.nbytes = math.prod(shape) * _element_size(dtype)
+        self.boxes: Dict[Box, None] = {}  # insertion-ordered set
+        self.full = False
+        self.order = order
+        # every wrapper and view of this tensor still alive; empty means no
+        # further read can happen, so its bytes can be copied out
+        self.live: "weakref.WeakSet" = weakref.WeakSet()
+
+    def add(self, box: Optional[Box]) -> None:
+        if box is None or self.full:
+            return
+        if box.offset == 0 and box.nbytes == self.nbytes and box.strides == (1,):
+            self.full = True
+            self.boxes = {box: None}
+            return
+        self.boxes[box] = None
+
+    @property
+    def stored_bytes(self) -> int:
+        return sum(b.nbytes for b in self.boxes)
+
+
+class Recorder:
+    """Collects footprints for every tensor wrapped through it, in yield order."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self.footprints: List[Footprint] = []
+        self.escapes: List[str] = []
+
+    def wrap(self, name: str, tensor: torch.Tensor) -> torch.Tensor:
+        fp = Footprint(name, tuple(tensor.shape), tensor.dtype, len(self.footprints))
+        with self._lock:
+            self.footprints.append(fp)
+        if not tensor.is_contiguous() or tensor.numel() == 0:
+            # Nothing to slice: a non-contiguous base is stored whole.
+            fp.add(full_box(fp.nbytes))
+            return tensor
+        return FootprintTensor(tensor, tensor, fp, self)
+
+    def record(self, fp: Footprint, box: Optional[Box]) -> None:
+        with self._lock:
+            fp.add(box)
+
+    def wrap_iterator(self, weights: Iterable[Tuple[str, torch.Tensor]]) -> Iterator[Tuple[str, torch.Tensor]]:
+        for name, tensor in weights:
+            yield name, self.wrap(name, tensor)
+
+
+class Checker(Recorder):
+    """Like Recorder, but every read must fall inside the boxes stored for it."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.allowed: Dict[int, Tuple[Footprint, "_Coverage"]] = {}
+        self.violations: List[str] = []
+
+    def wrap_stored(self, fp: Footprint, tensor: torch.Tensor) -> torch.Tensor:
+        if fp.full:
+            return tensor  # every byte is real: nothing to check
+        self.allowed[id(fp)] = (fp, _Coverage(list(fp.boxes)))
+        return FootprintTensor(tensor, tensor, fp, self)
+
+    def record(self, fp: Footprint, box: Optional[Box]) -> None:
+        if box is None:
+            return
+        _, coverage = self.allowed[id(fp)]
+        if not coverage.contains(box):
+            with self._lock:
+                self.violations.append(
+                    f"{fp.name}: read bytes [{box.offset}, {box.end}) in a {box.sizes}/{box.strides} "
+                    f"box that the raw preshard did not store"
+                )
+
+
+class _Coverage:
+    """Union of stored boxes, for containment checks."""
+
+    def __init__(self, boxes: List[Box]) -> None:
+        self.exact = set(boxes)
+        self._intervals: Optional[Tuple[torch.Tensor, torch.Tensor]] = None
+        self._boxes = boxes
+
+    def _merged(self) -> Tuple[torch.Tensor, torch.Tensor]:
+        if self._intervals is None:
+            starts, ends = [], []
+            for b in self._boxes:
+                s, n = b.runs()
+                starts.append(s)
+                ends.append(s + n)
+            s = torch.cat(starts)
+            e = torch.cat(ends)
+            order = torch.argsort(s)
+            s, e = s[order], e[order]
+            # merge overlapping or touching intervals
+            ms, me = [], []
+            for a, b in zip(s.tolist(), e.tolist()):
+                if ms and a <= me[-1]:
+                    me[-1] = max(me[-1], b)
+                else:
+                    ms.append(a)
+                    me.append(b)
+            self._intervals = (torch.tensor(ms, dtype=torch.int64), torch.tensor(me, dtype=torch.int64))
+        return self._intervals
+
+    def contains(self, box: Box) -> bool:
+        if box in self.exact:
+            return True
+        ms, me = self._merged()
+        starts, length = box.runs()
+        idx = torch.searchsorted(ms, starts, right=True) - 1
+        if bool((idx < 0).any()):
+            return False
+        return bool((starts + length <= me[idx]).all())
+
+
+def _view_op(func) -> bool:
+    try:
+        return bool(func.is_view)
+    except AttributeError:  # older torch: read the schema
+        return any(r.alias_info is not None for r in func._schema.returns) and not func._schema.is_mutable
+
+
+class FootprintTensor(torch.Tensor):
+    """A checkpoint tensor (or a view of one) whose reads are recorded.
+
+    `_inner` is the real tensor, a view into `_base`'s storage. Engines see an
+    ordinary tensor: shape, dtype, device, strides and contiguity are the inner
+    tensor's own.
+    """
+
+    __torch_function__ = torch._C._disabled_torch_function_impl
+
+    @staticmethod
+    def __new__(cls, inner: torch.Tensor, base: torch.Tensor, fp: Footprint, owner: Recorder):
+        out = torch.Tensor._make_wrapper_subclass(
+            cls,
+            inner.size(),
+            strides=inner.stride(),
+            storage_offset=inner.storage_offset(),
+            dtype=inner.dtype,
+            device=inner.device,
+            requires_grad=False,
+        )
+        out._fp_inner = inner
+        out._fp_base = base
+        out._fp_footprint = fp
+        out._fp_owner = owner
+        fp.live.add(out)
+        return out
+
+    def __repr__(self) -> str:  # printing would read the whole tensor
+        return f"FootprintTensor({self._fp_footprint.name}, shape={tuple(self.shape)}, dtype={self.dtype})"
+
+    def _record_all(self) -> None:
+        self._fp_owner.record(self._fp_footprint, view_box(self._fp_inner, self._fp_base))
+
+    # Reads that never reach the dispatcher.
+    def numpy(self, *args, **kwargs):
+        self._record_all()
+        return self._fp_inner.numpy(*args, **kwargs)
+
+    def tolist(self):
+        self._record_all()
+        return self._fp_inner.tolist()
+
+    def data_ptr(self):
+        self._record_all()
+        return self._fp_inner.data_ptr()
+
+    def untyped_storage(self):
+        self._fp_owner.record(self._fp_footprint, full_box(self._fp_footprint.nbytes))
+        return self._fp_inner.untyped_storage()
+
+    def __array__(self, *args, **kwargs):
+        self._record_all()
+        return self._fp_inner.__array__(*args, **kwargs)
+
+    @classmethod
+    def __torch_dispatch__(cls, func, types, args=(), kwargs=None):
+        kwargs = kwargs or {}
+        wrapped = [x for x in tree_flatten((args, kwargs))[0] if isinstance(x, FootprintTensor)]
+
+        def unwrap(x):
+            return x._fp_inner if isinstance(x, FootprintTensor) else x
+
+        out = func(*tree_map(unwrap, args), **tree_map(unwrap, kwargs))
+
+        if _view_op(func) and wrapped:
+            src = wrapped[0]
+
+            def rewrap(o):
+                if not isinstance(o, torch.Tensor):
+                    return o
+                if _shares_storage(o, src._fp_base):
+                    try:
+                        return FootprintTensor(o, src._fp_base, src._fp_footprint, src._fp_owner)
+                    except RuntimeError:
+                        # e.g. an inference tensor: the view escapes, so count it read
+                        src._fp_owner.record(src._fp_footprint, view_box(o, src._fp_base))
+                        return o
+                # a "view" that had to copy has read its whole input
+                src._fp_owner.record(src._fp_footprint, view_box(src._fp_inner, src._fp_base))
+                return o
+
+            return tree_map(rewrap, out)
+
+        for x in wrapped:
+            x._fp_owner.record(x._fp_footprint, view_box(x._fp_inner, x._fp_base))
+
+        # In-place and out= ops return one of their inputs; hand back its wrapper
+        # so identity (and recording) survives `w.mul_(s)` and friends.
+        by_id = {id(x._fp_inner): x for x in wrapped}
+        return tree_map(lambda o: by_id.get(id(o), o), out)
+
+
+def _element_size(dtype: torch.dtype) -> int:
+    return torch.empty((), dtype=dtype).element_size()
+
+
+def unwrap_module(module: "torch.nn.Module") -> int:
+    """Replace any FootprintTensor a load left inside `module` by its real tensor.
+
+    A loader that keeps the checkpoint tensor itself (`param.data = w`, a buffer
+    set to `w`) would otherwise leave a recording wrapper inside the served
+    model. Each one found is recorded as read in full: the model holds all of it.
+    Returns how many were found.
+    """
+    found = 0
+    for mod in module.modules():
+        for table in (mod._parameters, mod._buffers):
+            for key, value in list(table.items()):
+                if isinstance(value, FootprintTensor):
+                    value._fp_owner.record(value._fp_footprint, full_box(value._fp_footprint.nbytes))
+                    inner = value._fp_inner
+                    if isinstance(value, torch.nn.Parameter) or key in mod._parameters:
+                        inner = torch.nn.Parameter(inner, requires_grad=False)
+                    table[key] = inner
+                    found += 1
+        for key, value in list(vars(mod).items()):
+            if isinstance(value, FootprintTensor):
+                value._fp_owner.record(value._fp_footprint, full_box(value._fp_footprint.nbytes))
+                object.__setattr__(mod, key, value._fp_inner)
+                found += 1
+    return found
+
+
+def _shares_storage(a: torch.Tensor, b: torch.Tensor) -> bool:
+    try:
+        return a.untyped_storage().data_ptr() == b.untyped_storage().data_ptr()
+    except RuntimeError:
+        return False
