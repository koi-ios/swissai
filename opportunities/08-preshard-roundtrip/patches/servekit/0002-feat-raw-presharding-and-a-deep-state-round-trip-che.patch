+"""The SGLang hooks, driven through a stand-in with DefaultModelLoader's signatures."""
+import json
+import os
+import shutil
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("safetensors")
+
+sys.path.insert(0, os.path.dirname(__file__))
+
+from _mini_tp import MiniModel, default_load, iterate_checkpoint, make_checkpoint, save_checkpoint  # noqa: E402
+
+from servekit import deepstate  # noqa: E402
+from servekit.rawshard import sglang_hooks as hooks  # noqa: E402
+
+
+class FakeLoader:
+    """DefaultModelLoader's shape: load_model pulls _get_weights_iterator(source)."""
+
+    def __init__(self, rank=0, world=1):
+        self.rank, self.world = rank, world
+
+    def _get_weights_iterator(self, source, **kwargs):
+        files = sorted(
+            os.path.join(source.model_or_path, f)
+            for f in os.listdir(source.model_or_path)
+            if f.startswith("model-") and f.endswith(".safetensors")
+        )
+        return ((source.prefix + n, t) for n, t in iterate_checkpoint(files))
+
+    def load_model(self, *, model_config, device_config=None):
+        source = SimpleNamespace(model_or_path=model_config.model_path, prefix="", model_config=model_config)
+        with deepstate.deterministic_empty():
+            model = MiniModel(self.rank, self.world)
+            default_load(model, hooked_iterator(self, source))
+        return model
+
+
+def hooked_iterator(loader, source, **kwargs):
+    return hooks.around_weights_iterator(FakeLoader._get_weights_iterator, loader, source, **kwargs)
+
+
+def hooked_load(loader, model_config):
+    return hooks.around_load_model(FakeLoader.load_model, loader, model_config=model_config)
+
+
+def config(path, draft=False):
+    return SimpleNamespace(model_path=str(path), is_draft_model=draft, dtype="torch.bfloat16", quantization=None)
+
+
+@pytest.fixture
+def fresh_state(monkeypatch):
+    monkeypatch.setattr(hooks, "_STATE", hooks._Process())
+    monkeypatch.delenv(hooks.ENV_RECORD, raising=False)
+    monkeypatch.delenv(hooks.ENV_VERIFY, raising=False)
+    yield monkeypatch
+
+
+@pytest.fixture
+def checkpoint(tmp_path):
+    d = tmp_path / "ckpt"
+    save_checkpoint(make_checkpoint(), str(d))
+    (d / "config.json").write_text("{}")
+    return d
+
+
+def _prepare(checkpoint, artifact, monkeypatch, rank=0, world=1):
+    monkeypatch.setenv(hooks.ENV_RECORD, str(artifact))
+    reference = hooked_load(FakeLoader(rank, world), config(checkpoint))
+    monkeypatch.delenv(hooks.ENV_RECORD)
+    shutil.copy(checkpoint / "config.json", artifact / "config.json")
+    monkeypatch.setattr(hooks, "_STATE", hooks._Process())
+    return reference
+
+
+def test_prepare_then_serve_through_the_hooks(checkpoint, tmp_path, fresh_state):
+    artifact = tmp_path / "artifact"
+    reference = _prepare(checkpoint, artifact, fresh_state)
+    index = json.loads((artifact / "servekit-raw-rank-0.json").read_text())
+    assert index["signature"]["world_rank"] == 0 and index["signature"]["world_size"] == 1
+    assert [s["key"] for s in index["streams"]] == ["target/0"]
+
+    served = hooked_load(FakeLoader(), config(artifact))
+    report = deepstate.compare(deepstate.fingerprint(reference), deepstate.fingerprint(served))
+    assert report.ok, report.summary()
+
+
+def test_an_artifact_from_another_layout_is_refused(checkpoint, tmp_path, fresh_state):
+    artifact = tmp_path / "artifact"
+    _prepare(checkpoint, artifact, fresh_state)
+    path = artifact / "servekit-raw-rank-0.json"
+    index = json.loads(path.read_text())
+    index["signature"]["world_size"] = 4
+    path.write_text(json.dumps(index))
+    with pytest.raises(RuntimeError, match="world_size: prepared 4, now 1"):
+        hooked_load(FakeLoader(), config(artifact))
+
+
+def test_a_replay_that_reads_unstored_bytes_refuses_to_serve(checkpoint, tmp_path, fresh_state):
+    artifact = tmp_path / "artifact"
+    _prepare(checkpoint, artifact, fresh_state, rank=0, world=2)
+    # Same world rank as far as torch.distributed knows, but the model slices
+    # for tp_rank 1: exactly the drift the signature cannot see without SGLang.
+    with pytest.raises(RuntimeError, match="did not match its recording"):
+        hooked_load(FakeLoader(rank=1, world=2), config(artifact))
+
+
+def test_verification_can_be_switched_off(checkpoint, tmp_path, fresh_state):
+    artifact = tmp_path / "artifact"
+    _prepare(checkpoint, artifact, fresh_state, rank=0, world=2)
+    fresh_state.setenv(hooks.ENV_VERIFY, "0")
+    hooked_load(FakeLoader(rank=1, world=2), config(artifact))  # silently wrong: why it is on by default
+
+
+def test_other_sources_and_plain_loads_pass_through(checkpoint, fresh_state):
+    loader = FakeLoader()
+    secondary = SimpleNamespace(model_or_path=str(checkpoint), prefix="vision.", model_config=None)
+    names = [n for n, _ in hooked_iterator(loader, secondary)]
+    assert names and all(n.startswith("vision.") for n in names)
+    hooked_load(loader, config(checkpoint))  # no env, no index: an ordinary load
+    assert hooks._STATE.session is None
+
+
+def test_target_and_draft_streams_are_kept_apart(checkpoint, tmp_path, fresh_state):
+    artifact = tmp_path / "artifact"
+    fresh_state.setenv(hooks.ENV_RECORD, str(artifact))
+    hooked_load(FakeLoader(), config(checkpoint))
+    hooked_load(FakeLoader(), config(checkpoint, draft=True))
+    keys = [s["key"] for s in json.loads((artifact / "servekit-raw-rank-0.json").read_text())["streams"]]
+    assert keys == ["target/0", "draft/0"]
+
+
+def test_deepstate_dump_after_the_runner_loads(tmp_path, checkpoint, fresh_state):
+    fresh_state.setenv(hooks.ENV_DEEPSTATE, str(tmp_path / "ds"))
+
+    class Runner:
+        startup_weight_load = None
+        is_draft_worker = False
+        load_config = SimpleNamespace(load_format="auto")
+
+        def load_model(self):
+            self.model = FakeLoader().load_model(model_config=config(checkpoint))
+
+    runner = Runner()
+    hooks.around_runner_load(Runner.load_model, runner)
+    entries = deepstate.load(str(tmp_path / "ds" / "deepstate-target-rank-0.json"))
+    assert "experts.quant_method.w13_weight_triton_tensor.storage.data" in entries
