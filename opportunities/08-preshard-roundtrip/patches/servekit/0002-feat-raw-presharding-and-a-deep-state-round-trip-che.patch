diff --git a/src/servekit/deepstate.py b/src/servekit/deepstate.py
new file mode 100644
index 0000000..0b23c6d
--- /dev/null
+++ b/src/servekit/deepstate.py
@@ -0,0 +1,321 @@
+"""Every tensor a loaded model holds, wherever it hides, as comparable fingerprints.
+
+`state_dict()` is not the model. Engines keep inference-critical tensors where
+it cannot see them: on quantization-method objects (SGLang's MXFP4 triton path
+parks the swizzled experts on `quant_method.w13_weight_triton_tensor`), in
+non-persistent buffers (`GemmaRMSNorm.gemma_weight`), in plain attributes
+(MLA's `w_kc`/`w_vc`), and inside dataclasses such as triton_kernels'
+`PrecisionConfig`. A checkpoint format that round-trips `state_dict()` can
+therefore pass a state_dict comparison and still serve garbage.
+
+`collect` walks the module tree *and* the plain-object graph hanging off every
+module, and `fingerprint` reduces each distinct tensor to (dtype, shape, a
+content digest computed on its own device). Two loads of the same checkpoint
+that should be equivalent -- the engine's default loader and a presharded
+round trip -- must agree on every entry. `compare` says where they do not.
+
+Uninitialized memory is the one source of false alarms: a workspace allocated
+with torch.empty differs between any two loads. `deterministic_empty()` makes
+those allocations deterministic (torch fills them with NaN / max-int) for the
+duration of a load, and `compare` also accepts a third run of the reference
+loader to subtract whatever still varies.
+"""
+from __future__ import annotations
+
+import contextlib
+import dataclasses
+import json
+import os
+import types
+from typing import Any, Dict, Iterable, List, Optional, Tuple
+
+import torch
+
+# Values never worth walking into: they hold no model tensors, or hold the
+# whole runtime (process groups, streams, configs of other processes).
+_SKIP_TYPES: Tuple[type, ...] = (str, bytes, int, float, bool, complex, type(None), type, range,
+                                 types.ModuleType, torch.dtype, torch.device)
+_SKIP_NAMES = {"__class__", "__dict__", "__weakref__", "_forward_hooks", "_forward_pre_hooks",
+               "_backward_hooks", "_backward_pre_hooks", "_state_dict_hooks", "_state_dict_pre_hooks",
+               "_load_state_dict_pre_hooks", "_load_state_dict_post_hooks", "_forward_hooks_with_kwargs",
+               "_forward_pre_hooks_with_kwargs", "_forward_hooks_always_called", "_non_persistent_buffers_set"}
+_CHUNK_WORDS = 1 << 26
+
+
+@dataclasses.dataclass
+class Entry:
+    path: str
+    kind: str  # "param" | "buffer" | "nonpersistent_buffer" | "hidden"
+    dtype: str
+    shape: List[int]
+    device: str
+    digest: str
+    aliases: List[str] = dataclasses.field(default_factory=list)
+
+
+def _identity(t: torch.Tensor) -> Tuple:
+    try:
+        ptr = t.untyped_storage().data_ptr()
+    except (RuntimeError, NotImplementedError):
+        ptr = id(t)
+    return (str(t.device), ptr, t.storage_offset(), tuple(t.shape), tuple(t.stride()), t.dtype)
+
+
+def _is_tensor(x: Any) -> bool:
+    return isinstance(x, torch.Tensor) and not x.is_meta
+
+
+def _children(obj: Any) -> Iterable[Tuple[str, Any]]:
+    """(attribute path segment, value) for the parts of `obj` that may hold tensors."""
+    if isinstance(obj, dict):
+        for k, v in obj.items():
+            if isinstance(k, (str, int)):
+                yield f"[{k!r}]", v
+        return
+    if isinstance(obj, (list, tuple)):
+        for i, v in enumerate(obj):
+            yield f"[{i}]", v
+        return
+    d = getattr(obj, "__dict__", None)
+    if isinstance(d, dict):
+        for k, v in d.items():
+            if k not in _SKIP_NAMES:
+                yield f".{k}", v
+    for slot in getattr(type(obj), "__slots__", ()) or ():
+        if isinstance(slot, str) and slot not in _SKIP_NAMES and hasattr(obj, slot):
+            try:
+                yield f".{slot}", getattr(obj, slot)
+            except Exception:  # noqa: BLE001 - a slot may be unset or raise
+                continue
+
+
+def collect(model: torch.nn.Module, max_depth: int = 6, max_objects: int = 2_000_000) -> Dict[str, Tuple[str, torch.Tensor, List[str]]]:
+    """path -> (kind, tensor, alias paths) for every distinct tensor `model` holds.
+
+    Registered parameters and buffers come first, under their state_dict names,
+    so an alias between a registered and a hidden name is reported under the
+    registered one.
+    """
+    found: Dict[Tuple, str] = {}
+    out: Dict[str, Tuple[str, torch.Tensor, List[str]]] = {}
+
+    def add(path: str, kind: str, t: torch.Tensor) -> None:
+        key = _identity(t)
+        if key in found:
+            out[found[key]][2].append(path)
+            return
+        found[key] = path
+        out[path] = (kind, t, [])
+
+    # remove_duplicate=False: a module registered under two names (MLA's lazily
+    # registered attn_mha.kv_b_proj) must show up under both, as an alias.
+    modules = list(model.named_modules(remove_duplicate=False))
+    module_ids = {id(m) for _, m in modules}
+    for name, mod in modules:
+        prefix = f"{name}." if name else ""
+        nonpersistent = getattr(mod, "_non_persistent_buffers_set", set())
+        for pname, p in mod._parameters.items():
+            if p is not None and _is_tensor(p):
+                add(prefix + pname, "param", p)
+        for bname, b in mod._buffers.items():
+            if b is not None and _is_tensor(b):
+                add(prefix + bname, "nonpersistent_buffer" if bname in nonpersistent else "buffer", b)
+
+    visited = set(module_ids)
+    budget = [max_objects]
+
+    def walk(path: str, obj: Any, depth: int) -> None:
+        if budget[0] <= 0 or depth > max_depth:
+            return
+        if _is_tensor(obj):
+            add(path, "hidden", obj)
+            return
+        if isinstance(obj, _SKIP_TYPES) or callable(obj) and not hasattr(obj, "__dict__"):
+            return
+        if id(obj) in visited:
+            return
+        visited.add(id(obj))
+        budget[0] -= 1
+        mod_name = type(obj).__module__ or ""
+        if mod_name.startswith(("torch.distributed", "torch.cuda", "threading", "multiprocessing", "logging", "zmq")):
+            return
+        for seg, child in _children(obj):
+            walk(path + seg, child, depth + 1)
+
+    walked = set()
+    for name, mod in modules:
+        if id(mod) in walked:
+            continue
+        walked.add(id(mod))
+        prefix = name if name else "<root>"
+        for k, v in vars(mod).items():
+            if k in ("_parameters", "_buffers", "_modules") or k in _SKIP_NAMES:
+                continue
+            if isinstance(v, torch.nn.Module) and id(v) in module_ids:
+                continue  # a registered module, walked under its own name
+            walk(f"{prefix}.{k}", v, 1)
+    return out
+
+
+def digest(t: torch.Tensor) -> str:
+    """A content digest of `t`'s bytes, computed on t's device. Not cryptographic."""
+    if t.numel() == 0:
+        return "empty"
+    try:
+        b = t.detach().contiguous().reshape(-1).view(torch.uint8)
+    except RuntimeError:
+        b = t.detach().to(torch.float64).contiguous().reshape(-1).view(torch.uint8)
+    pad = (-b.numel()) % 4
+    if pad:
+        b = torch.cat([b, torch.zeros(pad, dtype=torch.uint8, device=b.device)])
+    words = b.view(torch.int32)
+    s1 = torch.zeros((), dtype=torch.int64, device=b.device)
+    s2 = torch.zeros((), dtype=torch.int64, device=b.device)
+    for start in range(0, words.numel(), _CHUNK_WORDS):
+        w = words[start:start + _CHUNK_WORDS].to(torch.int64) & 0xFFFFFFFF
+        idx = torch.arange(start, start + w.numel(), dtype=torch.int64, device=b.device)
+        mult = (idx * 2654435761 + 97) % 2147483647 + 1
+        s1 += (w * mult).sum()
+        s2 += w.sum()
+    return f"{int(s1.item()) & 0xFFFFFFFFFFFFFFFF:016x}{int(s2.item()) & 0xFFFFFFFFFFFFFFFF:016x}"
+
+
+def fingerprint(model: torch.nn.Module) -> Dict[str, Entry]:
+    entries = {}
+    for path, (kind, t, aliases) in collect(model).items():
+        entries[path] = Entry(
+            path=path,
+            kind=kind,
+            dtype=str(t.dtype).replace("torch.", ""),
+            shape=list(t.shape),
+            device=str(t.device),
+            digest=digest(t),
+            aliases=sorted(aliases),
+        )
+    return entries
+
+
+def dump(model: torch.nn.Module, path: str, **meta: Any) -> Dict[str, Entry]:
+    entries = fingerprint(model)
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump({"meta": meta, "entries": [dataclasses.asdict(e) for e in entries.values()]}, f)
+    os.replace(tmp, path)
+    return entries
+
+
+def load(path: str) -> Dict[str, Entry]:
+    with open(path) as f:
+        data = json.load(f)
+    return {e["path"]: Entry(**e) for e in data["entries"]}
+
+
+@dataclasses.dataclass
+class Report:
+    missing: List[str]  # in the reference, not in the candidate
+    extra: List[str]  # in the candidate, not in the reference
+    differ: List[str]  # in both, different dtype/shape/content
+    unstable: List[str]  # differ, but also differ between two reference loads
+    kinds: Dict[str, str]
+    alias_changes: List[str]
+
+    @property
+    def ok(self) -> bool:
+        return not (self.missing or self.extra or self.differ or self.alias_changes)
+
+    def by_kind(self, paths: List[str]) -> Dict[str, int]:
+        counts: Dict[str, int] = {}
+        for p in paths:
+            counts[self.kinds.get(p, "?")] = counts.get(self.kinds.get(p, "?"), 0) + 1
+        return counts
+
+    def summary(self, limit: int = 8) -> str:
+        if self.ok:
+            note = f" ({len(self.unstable)} tensors vary between reference loads and were ignored)" if self.unstable else ""
+            return f"round trip exact: every tensor the model holds matches the reference{note}"
+        lines = ["round trip NOT exact:"]
+        for label, paths in (("missing", self.missing), ("extra", self.extra), ("differ", self.differ),
+                             ("alias structure changed", self.alias_changes)):
+            if paths:
+                lines.append(f"  {label}: {len(paths)} {self.by_kind(paths)}")
+                lines.extend(f"    {p}" for p in paths[:limit])
+                if len(paths) > limit:
+                    lines.append(f"    ... {len(paths) - limit} more")
+        return "\n".join(lines)
+
+
+def _registered_names(entries: Dict[str, Entry]) -> Dict[str, str]:
+    """registered name -> the canonical path it is stored under (itself, or an alias)."""
+    names = {}
+    for e in entries.values():
+        if e.kind != "hidden":
+            names[e.path] = e.path
+        for a in e.aliases:
+            names.setdefault(a, e.path)
+    return names
+
+
+def compare(reference: Dict[str, Entry], candidate: Dict[str, Entry],
+            reference_again: Optional[Dict[str, Entry]] = None,
+            only_kinds: Optional[Iterable[str]] = None) -> Report:
+    """Where `candidate` holds different tensors than `reference`.
+
+    `reference_again`, a second load with the reference loader, marks tensors
+    that differ even between two reference loads (scratch buffers, RNG state);
+    those are reported as unstable instead of as differences.
+    `only_kinds` restricts the comparison, e.g. to ("param", "buffer") to see
+    what a state_dict-only check would have caught.
+    """
+    kinds = {p: e.kind for p, e in {**candidate, **reference}.items()}
+    keep = set(only_kinds) if only_kinds is not None else None
+
+    def wanted(e: Entry) -> bool:
+        return keep is None or e.kind in keep
+
+    unstable = set()
+    if reference_again is not None:
+        for p, e in reference.items():
+            o = reference_again.get(p)
+            if o is None or (o.dtype, o.shape, o.digest) != (e.dtype, e.shape, e.digest):
+                unstable.add(p)
+
+    missing = sorted(p for p, e in reference.items() if wanted(e) and p not in candidate and p not in unstable)
+    extra = sorted(p for p, e in candidate.items() if wanted(e) and p not in reference)
+    differ = sorted(
+        p for p, e in reference.items()
+        if wanted(e) and p in candidate and p not in unstable
+        and (candidate[p].dtype, candidate[p].shape, candidate[p].digest) != (e.dtype, e.shape, e.digest)
+    )
+    # A registered name that the reference holds as its own tensor but the
+    # candidate only as an alias of another (or the reverse) is how lazily
+    # created aliases show up.
+    ref_names, cand_names = _registered_names(reference), _registered_names(candidate)
+    alias_changes = sorted(
+        n for n in set(ref_names) & set(cand_names)
+        if (ref_names[n] == n) != (cand_names[n] == n)
+        and (keep is None or kinds.get(n, "param") in keep)
