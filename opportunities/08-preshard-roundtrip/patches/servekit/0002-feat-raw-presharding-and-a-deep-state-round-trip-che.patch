index 0000000..c3f2a67
--- /dev/null
+++ b/tests/_mini_tp.py
@@ -0,0 +1,361 @@
+"""A small tensor-parallel model whose load path has SGLang's shapes, on CPU.
+
+One process plays one rank (`rank`, `world`). The weight loaders slice the
+full checkpoint tensors the way SGLang's layers do (column/row/QKV/merged
+column/vocab-parallel/fused-MoE, plus gpt-oss's fused expert blocks), and the
+model carries the three kinds of state a `state_dict()` round trip loses in
+SGLang 0.5.20:
+
+* `attn.attn_mha.kv_b_proj`: a submodule alias registered on first forward
+  (deepseek_v2.py:1920 and :2070-2071);
+* `experts.quant_method.w13_weight_triton_tensor`: post-processing moves the
+  expert weights onto the quant-method object and deletes them from the layer
+  (mxfp4.py:1015-1043);
+* `norm.gemma_weight`: a non-persistent buffer derived inside the weight
+  loader (layernorm.py:1076-1089).
+
+`post_load_weights` derives MLA-style absorbed weights (`w_kc`, `w_vc`) as
+plain attributes. Everything is deterministic given the checkpoint.
+"""
+from __future__ import annotations
+
+import dataclasses
+import os
+from typing import Dict, Iterable, Iterator, List, Optional, Tuple
+
+import torch
+from torch import nn
+
+H = 16  # hidden
+I = 16  # MoE intermediate per expert
+E = 4  # experts
+V = 37  # vocab, deliberately not divisible by the TP size
+KV_RANK = 8  # MLA latent dim
+HEADS = 4
+HEAD_DIM = 4
+
+
+def make_checkpoint(seed: int = 0) -> Dict[str, torch.Tensor]:
+    g = torch.Generator().manual_seed(seed)
+
+    def r(*shape, dtype=torch.bfloat16):
+        return torch.randn(*shape, generator=g).to(dtype)
+
+    ck = {
+        "embed_tokens.weight": r(V, H),
+        "norm.weight": r(H, dtype=torch.float32),
+        "attn.q_proj.weight": r(HEADS * HEAD_DIM, H),
+        "attn.k_proj.weight": r(HEADS * HEAD_DIM, H),
+        "attn.v_proj.weight": r(HEADS * HEAD_DIM, H),
+        "attn.o_proj.weight": r(H, HEADS * HEAD_DIM),
+        "attn.kv_b_proj.weight": r(HEADS * 2 * HEAD_DIM, KV_RANK),
+        "mlp.gate_proj.weight": r(4 * H, H),
+        "mlp.up_proj.weight": r(4 * H, H),
+        "mlp.down_proj.weight": r(H, 4 * H),
+        # gpt-oss style: one tensor for all experts, gate/up interleaved, uint8 "blocks"
+        "experts.gate_up_proj_blocks": torch.randint(0, 255, (E, 2 * I, H // 4, 4), generator=g, dtype=torch.uint8),
+        "experts.gate_up_proj_scales": torch.randint(110, 130, (E, 2 * I, H // 4), generator=g, dtype=torch.uint8),
+        "experts.down_proj_blocks": torch.randint(0, 255, (E, H, I // 4, 4), generator=g, dtype=torch.uint8),
+        "experts.down_proj_scales": torch.randint(110, 130, (E, H, I // 4), generator=g, dtype=torch.uint8),
+        "router.weight": r(E, H),
+        "k_scale": torch.tensor(0.5, dtype=torch.float32),
+        "lm_head.weight": r(V, H),
+        "unused.rotary_emb.inv_freq": r(H // 2, dtype=torch.float32),
+    }
+    return ck
+
+
+def save_checkpoint(ck: Dict[str, torch.Tensor], directory: str, files: int = 3) -> List[str]:
+    from safetensors.torch import save_file
+
+    os.makedirs(directory, exist_ok=True)
+    names = sorted(ck)
+    paths = []
+    for i in range(files):
+        part = {n: ck[n].contiguous() for n in names[i::files]}
+        path = os.path.join(directory, f"model-{i:05d}-of-{files:05d}.safetensors")
+        save_file(part, path)
+        paths.append(path)
+    return paths
+
+
+def iterate_checkpoint(paths: List[str]) -> Iterator[Tuple[str, torch.Tensor]]:
+    """What SGLang's safetensors_weights_iterator yields: (name, CPU tensor)."""
+    from safetensors import safe_open
+
+    for path in paths:
+        with safe_open(path, framework="pt") as f:
+            for name in f.keys():  # noqa: SIM118
+                yield name, f.get_tensor(name)
+
+
+# ------------------------------------------------------------------ layers
+
+
+class Rank:
+    def __init__(self, rank: int, world: int):
+        self.rank, self.world = rank, world
+
+
+def _param(*shape, dtype=torch.bfloat16) -> nn.Parameter:
+    return nn.Parameter(torch.empty(*shape, dtype=dtype), requires_grad=False)
+
+
+class ColumnParallel(nn.Module):
+    def __init__(self, tp: Rank, n_in: int, n_out: int):
+        super().__init__()
+        self.tp = tp
+        self.weight = _param(n_out // tp.world, n_in)
+        self.weight.weight_loader = self.weight_loader
+
+    def weight_loader(self, param, w, shard_offset: int = 0, shard_size: Optional[int] = None):
+        # linear.py ColumnParallelLinear: narrow the output dim by tp_rank
+        size = param.shape[0] if shard_size is None else shard_size
+        w = w.narrow(0, self.tp.rank * size, size)
+        param.data.narrow(0, shard_offset, size).copy_(w)
+
+
+class QKVParallel(ColumnParallel):
+    SHARDS = {"q": 0, "k": 1, "v": 2}
+
+    def __init__(self, tp: Rank, n_in: int, n_per: int):
+        super().__init__(tp, n_in, 3 * n_per)
+        self.per = n_per // tp.world
+
+    def load_shard(self, shard: str, w):
+        self.weight_loader(self.weight, w, self.SHARDS[shard] * self.per, self.per)
+
+
+class RowParallel(nn.Module):
+    def __init__(self, tp: Rank, n_in: int, n_out: int):
+        super().__init__()
+        self.tp = tp
+        self.weight = _param(n_out, n_in // tp.world)
+        self.weight.weight_loader = self.weight_loader
+
+    def weight_loader(self, param, w):
+        # linear.py RowParallelLinear: narrow the input dim (a strided read)
+        size = param.shape[1]
+        param.data.copy_(w.narrow(1, self.tp.rank * size, size))
+
+
+class VocabParallelEmbedding(nn.Module):
+    def __init__(self, tp: Rank, vocab: int, hidden: int):
+        super().__init__()
+        self.tp = tp
+        self.per = -(-vocab // tp.world)  # padded
+        self.vocab = vocab
+        self.weight = _param(self.per, hidden)
+        self.weight.weight_loader = self.weight_loader
+
+    def weight_loader(self, param, w):
+        start = self.tp.rank * self.per
+        end = min(start + self.per, self.vocab)
+        param.data.zero_()
+        if end > start:
+            param.data[: end - start].copy_(w[start:end])
+
+
+class GemmaNorm(nn.Module):
+    """layernorm.py:1068-1089 GemmaRMSNorm: gemma_weight = weight + 1, in the loader."""
+
+    def __init__(self, hidden: int):
+        super().__init__()
+        self.weight = nn.Parameter(torch.zeros(hidden), requires_grad=False)
+        self.register_buffer("gemma_weight", torch.ones_like(self.weight), persistent=False)
+        self.weight.weight_loader = self._weight_loader
+
+    def _weight_loader(self, param, w):
+        assert param.size() == w.size()
+        param.data.copy_(w)
+        torch.add(param.data, 1.0, out=self.gemma_weight)
+
+    def forward(self, x):
+        x = x.float()
+        x = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + 1e-6)
+        return x * self.gemma_weight  # the fused path reads the derived buffer
+
+
+class RadixAttentionStub(nn.Module):
+    pass
+
+
+class MLAttention(nn.Module):
+    def __init__(self, tp: Rank):
+        super().__init__()
+        self.tp = tp
+        self.qkv = QKVParallel(tp, H, HEADS * HEAD_DIM)
+        self.o_proj = RowParallel(tp, HEADS * HEAD_DIM, H)
+        self.kv_b_proj = ColumnParallel(tp, KV_RANK, HEADS * 2 * HEAD_DIM)
+        self.attn_mha = RadixAttentionStub()
+        self.attn_mha.kv_b_proj = None  # deepseek_v2.py:1920
+        self.w_kc = None  # deepseek_v2.py:1922-1923
+        self.w_vc = None
+        self.k_scale = 1.0
+
+    def post_load_weights(self):
+        # deepseek_v2 post_load_weights: absorb kv_b_proj into w_kc / w_vc
+        w = self.kv_b_proj.weight.unflatten(0, (-1, 2 * HEAD_DIM))
+        w_kc, w_vc = w.split([HEAD_DIM, HEAD_DIM], dim=1)
+        self.w_kc = w_kc.transpose(1, 2).contiguous()
+        self.w_vc = w_vc.contiguous()
+
+    def forward(self, x):
+        if self.attn_mha.kv_b_proj is None and hasattr(self, "kv_b_proj"):  # deepseek_v2.py:2070
+            self.attn_mha.kv_b_proj = self.kv_b_proj
+        q = (x @ self.qkv.weight.t().float())[..., : self.qkv.per]
+        k = torch.einsum("nr,hrd->nhd", x[..., :KV_RANK], self.w_kc.float()).flatten(1)
+        heads = (q + k) * self.k_scale
+        return heads @ self.o_proj.weight.t().float()
+
+
+@dataclasses.dataclass
+class StorageStub:  # triton_kernels.tensor.Storage
+    data: torch.Tensor
+
+
+@dataclasses.dataclass
+class TritonTensorStub:  # triton_kernels.tensor.Tensor
+    storage: StorageStub
+
+
+@dataclasses.dataclass
+class PrecisionConfigStub:  # triton_kernels.matmul.PrecisionConfig
+    b_mx_scale: TritonTensorStub
+
+
+class Mxfp4TritonStub:
+    """The shape of mxfp4.py:1015-1043: swizzle, park on self, delete from layer."""
+
+    def __init__(self):
+        self.w13_weight_triton_tensor = None
+        self.w13_precision_config = None
+
+    def process_weights_after_loading(self, layer):
+        swizzled = layer.w13_weight.data.flip(-1).contiguous()  # stand-in for _swizzle_mxfp4
+        scale = layer.w13_weight_scale.data.flip(-1).contiguous()
+        self.w13_precision_config = PrecisionConfigStub(TritonTensorStub(StorageStub(scale)))
+        self.w13_weight_triton_tensor = TritonTensorStub(StorageStub(swizzled))
+        del layer.w13_weight
+
+
+class FusedMoE(nn.Module):
+    def __init__(self, tp: Rank, ep: bool = False, triton: bool = True):
+        super().__init__()
+        self.tp = tp
+        self.ep = ep
+        tp_world = 1 if ep else tp.world
+        self.local = list(range(E))[tp.rank :: tp.world] if ep else list(range(E))
+        n = len(self.local)
+        self.w13_weight = _param(n, 2 * I // tp_world, H, dtype=torch.uint8)
+        self.w13_weight_scale = _param(n, 2 * I // tp_world, H // 4, dtype=torch.uint8)
+        self.w2_weight = _param(n, H, I // tp_world, dtype=torch.uint8)
+        self.w2_weight_scale = _param(n, H, I // 4 // tp_world, dtype=torch.uint8)
+        self.quant_method = Mxfp4TritonStub() if triton else None
+
+    def load_fused(self, name: str, w: torch.Tensor):
+        # gpt_oss.py-style: flatten blocks, slice this rank's rows of the
+        # interleaved gate/up dim, then copy per local expert
+        tp_world = 1 if self.ep else self.tp.world
+        r = 0 if self.ep else self.tp.rank
+        if name.endswith("gate_up_proj_blocks"):
+            w = w.view(E, 2 * I, -1)
+            per = 2 * I // tp_world
+            w = w[:, r * per : (r + 1) * per, ...]
+            for j, e in enumerate(self.local):
+                self.w13_weight.data[j].copy_(w[e])
+        elif name.endswith("gate_up_proj_scales"):
+            per = 2 * I // tp_world
+            for j, e in enumerate(self.local):
+                self.w13_weight_scale.data[j].copy_(w[e, r * per : (r + 1) * per])
+        elif name.endswith("down_proj_blocks"):
+            w = w.view(E, H, -1)
+            per = w.shape[-1] // tp_world
+            for j, e in enumerate(self.local):
+                self.w2_weight.data[j].copy_(w[e, :, r * per : (r + 1) * per])
+        elif name.endswith("down_proj_scales"):
+            per = w.shape[-1] // tp_world
+            for j, e in enumerate(self.local):
+                self.w2_weight_scale.data[j].copy_(w[e, :, r * per : (r + 1) * per])
+
+
+class MiniModel(nn.Module):
+    def __init__(self, rank: int = 0, world: int = 1, ep: bool = False, triton: bool = True):
+        super().__init__()
+        tp = Rank(rank, world)
+        self.tp = tp
+        self.embed_tokens = VocabParallelEmbedding(tp, V, H)
+        self.norm = GemmaNorm(H)
+        self.attn = MLAttention(tp)
+        self.gate_up = ColumnParallel(tp, H, 2 * 4 * H)
+        self.down = RowParallel(tp, 4 * H, H)
+        self.experts = FusedMoE(tp, ep=ep, triton=triton)
+        self.router = nn.Linear(H, E, bias=False, dtype=torch.bfloat16)
+        self.router.weight.requires_grad_(False)
+        self.lm_head = VocabParallelEmbedding(tp, V, H)
+        self.workspace = None
+        self._stash: Dict[str, torch.Tensor] = {}
+
+    def load_weights(self, weights: Iterable[Tuple[str, torch.Tensor]]) -> None:
+        stacked = {"q_proj": "q", "k_proj": "k", "v_proj": "v"}
+        for name, w in weights:
+            if "rotary_emb.inv_freq" in name:
+                continue  # skipped by name, never read
+            if name.startswith("attn.") and any(k in name for k in stacked):
+                shard = stacked[name.split(".")[1]]
+                self.attn.qkv.load_shard(shard, w)
+            elif name == "attn.o_proj.weight":
+                self.attn.o_proj.weight_loader(self.attn.o_proj.weight, w)
+            elif name == "attn.kv_b_proj.weight":
+                self.attn.kv_b_proj.weight_loader(self.attn.kv_b_proj.weight, w)
+            elif name in ("mlp.gate_proj.weight", "mlp.up_proj.weight"):
+                # merged column: stash the first, load both when the pair is complete
+                self._stash[name] = w
+                if len(self._stash) == 2:
+                    per = self.gate_up.weight.shape[0] // 2
+                    self.gate_up.weight_loader(self.gate_up.weight, self._stash.pop("mlp.gate_proj.weight"), 0, per)
+                    self.gate_up.weight_loader(self.gate_up.weight, self._stash.pop("mlp.up_proj.weight"), per, per)
+            elif name == "mlp.down_proj.weight":
+                self.down.weight_loader(self.down.weight, w)
+            elif name.startswith("experts."):
+                self.experts.load_fused(name, w)
+            elif name == "embed_tokens.weight":
+                self.embed_tokens.weight_loader(self.embed_tokens.weight, w)
+            elif name == "lm_head.weight":
+                self.lm_head.weight_loader(self.lm_head.weight, w)
+            elif name == "norm.weight":
+                self.norm.weight.weight_loader(self.norm.weight, w)
+            elif name == "router.weight":
+                self.router.weight.data.copy_(w.view(torch.int16).view(torch.bfloat16))  # a dtype view
+            elif name == "k_scale":
+                self.attn.k_scale = float(w.item())  # a scalar read
+            else:
+                raise KeyError(name)
+
+    def post_load_weights(self):
+        self.attn.post_load_weights()
+
+    def process_weights_after_loading(self):
+        qm = self.experts.quant_method
+        if qm is not None:
+            qm.process_weights_after_loading(self.experts)
+        self.workspace = torch.empty(64)  # scratch: never initialized
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        x = self.embed_tokens.weight[ids.clamp(max=self.embed_tokens.weight.shape[0] - 1)].float()
+        x = self.norm(x)
+        x = x + self.attn(x)
+        x = x @ self.gate_up.weight.t().float()
+        x = x[..., : self.down.weight.shape[1]] @ self.down.weight.t().float()
+        qm = self.experts.quant_method
+        experts = qm.w13_weight_triton_tensor.storage.data if qm is not None else self.experts.w13_weight
+        x = x + experts.float().mean() / 255.0
+        return x @ self.lm_head.weight.t().float()
+
+
+def default_load(model: MiniModel, weights: Iterable[Tuple[str, torch.Tensor]]) -> MiniModel:
+    """SGLang's DefaultModelLoader order: load_weights (incl. post_load), then post-process."""
+    model.load_weights(weights)
+    model.post_load_weights()
+    model.process_weights_after_loading()
+    return model
diff --git a/tests/test_deepstate.py b/tests/test_deepstate.py
new file mode 100644
index 0000000..c83aa00
--- /dev/null
+++ b/tests/test_deepstate.py
@@ -0,0 +1,94 @@
+"""The generic round-trip checker: every tensor a model holds, not just state_dict()."""
+import os
+import sys
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("safetensors")
+
+sys.path.insert(0, os.path.dirname(__file__))
+
+from _mini_tp import MiniModel, default_load, iterate_checkpoint, make_checkpoint, save_checkpoint  # noqa: E402
+
+from servekit import deepstate  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    return save_checkpoint(make_checkpoint(), str(tmp_path_factory.mktemp("ckpt")))
+
+
+def _state_dict_round_trip(reference: MiniModel, rank: int, world: int) -> MiniModel:
+    """What a post-processed-state_dict format does on reload (sharded_state's shape):
+    post-process the fresh placeholders, then copy the saved state_dict into them."""
+    saved = {k: v.clone() for k, v in reference.state_dict().items()}
+    fresh = MiniModel(rank, world)
+    fresh.process_weights_after_loading()  # on placeholders, before any data
+    target = fresh.state_dict()
+    for k, v in saved.items():
+        target[k].copy_(v)
+    assert set(target) == set(saved)  # the key check passes: nothing is "missing"
+    fresh.post_load_weights()
+    return fresh
+
+
+def test_a_state_dict_check_passes_where_the_model_is_broken(checkpoint):
+    with deepstate.deterministic_empty():
+        reference = default_load(MiniModel(0, 2), iterate_checkpoint(checkpoint))
+        reloaded = _state_dict_round_trip(reference, 0, 2)
+    ref, got = deepstate.fingerprint(reference), deepstate.fingerprint(reloaded)
+
+    registered_only = deepstate.compare(ref, got, only_kinds=("param", "buffer"))
+    assert registered_only.ok, registered_only.summary()
+
+    full = deepstate.compare(ref, got)
+    assert not full.ok
+    assert "experts.quant_method.w13_weight_triton_tensor.storage.data" in full.differ
+    assert "experts.quant_method.w13_precision_config.b_mx_scale.storage.data" in full.differ
+    assert "norm.gemma_weight" in full.differ
+    assert full.kinds["norm.gemma_weight"] == "nonpersistent_buffer"
+    ids = torch.tensor([1, 2, 3])
+    assert not torch.equal(reference(ids), reloaded(ids))
+
+
+def test_uninitialized_scratch_is_unstable_rather_than_different(checkpoint):
+    loads = [default_load(MiniModel(0, 1), iterate_checkpoint(checkpoint)) for _ in range(3)]
+    for m in loads:  # make the scratch visibly different between loads
+        m.workspace.copy_(torch.randn(64))
+    a, b, c = (deepstate.fingerprint(m) for m in loads)
+    plain = deepstate.compare(a, b)
+    assert plain.differ == ["<root>.workspace"]
+    tolerant = deepstate.compare(a, b, reference_again=c)
+    assert tolerant.ok and tolerant.unstable == ["<root>.workspace"]
+
+
+def test_deterministic_empty_makes_scratch_comparable(checkpoint):
+    with deepstate.deterministic_empty():
+        a = deepstate.fingerprint(default_load(MiniModel(0, 1), iterate_checkpoint(checkpoint)))
+        b = deepstate.fingerprint(default_load(MiniModel(0, 1), iterate_checkpoint(checkpoint)))
+    assert deepstate.compare(a, b).ok
+    assert not torch.are_deterministic_algorithms_enabled()
+
+
+def test_aliases_are_reported_once_under_the_registered_name(checkpoint):
+    m = default_load(MiniModel(0, 1), iterate_checkpoint(checkpoint))
+    m(torch.tensor([1]))  # first forward registers attn.attn_mha.kv_b_proj
+    entries = deepstate.fingerprint(m)
+    assert "attn.kv_b_proj.weight" in entries
+    assert "attn.attn_mha.kv_b_proj.weight" in entries["attn.kv_b_proj.weight"].aliases
+
+
+def test_a_single_flipped_bit_changes_the_digest():
+    t = torch.randn(1000).to(torch.bfloat16)
+    u = t.clone()
+    u.view(torch.int16)[517] ^= 1
+    assert deepstate.digest(t) != deepstate.digest(u)
+    assert deepstate.digest(t) == deepstate.digest(t.clone())
+
+
+def test_dump_and_load(tmp_path, checkpoint):
+    m = default_load(MiniModel(0, 1), iterate_checkpoint(checkpoint))
+    path = str(tmp_path / "fp.json")
+    written = deepstate.dump(m, path, loader="default")
+    assert deepstate.load(path) == written
diff --git a/tests/test_raw_integration.py b/tests/test_raw_integration.py
new file mode 100644
index 0000000..0883459
--- /dev/null
+++ b/tests/test_raw_integration.py
@@ -0,0 +1,156 @@
+"""The raw preshard format through servekit's own surface: guard, prepare, launch, CLI."""
+import json
+import os
+import sys
+
+import pytest
+
+from servekit.cli import main
+from servekit.manifest import Manifest
+from servekit.prepare import _missing_shards, prepare
+from servekit.profile import ProfileReport
+from servekit.quant_guard import Setup, check, check_command
+from servekit.stage import StageResult
+from servekit.topology import Topology, raw_glob
+
+GPT_OSS = {"architectures": ["GptOssForCausalLM"], "quantization_config": {"quant_method": "mxfp4"}}
+
+
+def _model(tmp_path, config, name="gpt-oss-20b"):
+    src = tmp_path / name
+    src.mkdir()
+    (src / "config.json").write_text(json.dumps(config))
+    return src
+
+
+# --- the guard ---------------------------------------------------------------
+
+def test_gpt_oss_with_no_backend_flag_is_the_triton_kernel_path():
+    # SGLang 0.5.20 resolves auto to triton_kernel for gpt-oss below SM100
+    # (arg_groups/model_overrides/gpt_oss.py:106-125), so this is #34448 too.
+    assert check(Setup(quant_method="mxfp4", architectures=("GptOssForCausalLM",)))
+    assert check(Setup(quant_method="mxfp4", architectures=("GptOssForCausalLM",), moe_runner_backend="marlin")) == []
+
+
+def test_a_bare_gpt_oss_launch_is_refused_for_sharded_state_but_not_for_raw(tmp_path):
+    src = _model(tmp_path, GPT_OSS)
+    command = ["python", "-m", "sglang.launch_server", "--model-path", str(src)]
+    assert check_command(src, command)
+    assert check_command(src, command, "raw") == []
+
+
+# --- prepare -----------------------------------------------------------------
+
+FAKE_RAW_SHARDER = '''
+import json, os, sys
+args = sys.argv[1:]
+def arg(name):
+    return args[args.index(name) + 1]
+out, tp = arg("--output"), int(arg("--tensor-parallel-size"))
+assert arg("--servekit-format") == "raw"
+assert os.environ["SERVEKIT_RAW_RECORD_DIR"] == out
+for r in range(tp):
+    open(os.path.join(out, f"servekit-raw-rank-{r}.json"), "w").write("{}")
+    open(os.path.join(out, f"servekit-raw-rank-{r}-part-0.safetensors"), "wb").write(b"bytes")
+resolved = {"engine": "sglang", "engine_version": "0.5.20", "tp_size": tp, "pp_size": 1,
+            "dp_size": 1, "dtype": "bfloat16", "quantization": "mxfp4"}
+json.dump(resolved, open(arg("--servekit-resolved-out"), "w"))
+'''
+
+
+def test_prepare_raw_records_through_the_hooks_and_writes_a_raw_manifest(tmp_path, monkeypatch):
+    script = tmp_path / "fake.py"
+    script.write_text(FAKE_RAW_SHARDER)
+    monkeypatch.setattr("servekit.prepare.SAVE_SCRIPT", script)
+    src = _model(tmp_path, GPT_OSS)
+    out = tmp_path / "artifact"
+    assert prepare(src, out, tp=2, fmt="raw", cache_root=tmp_path / "cache") == 0
+    manifest = json.loads((out / "servekit.json").read_text())
+    assert manifest["format"] == "raw" and manifest["tp_size"] == 2
+
+
+def test_a_missing_raw_rank_is_caught(tmp_path):
+    (tmp_path / "servekit-raw-rank-0.json").write_text("{}")
+    assert _missing_shards(tmp_path, 2, 1, "raw") == ["servekit-raw-rank-1.json"]
+
+
+def test_an_unknown_format_is_refused(tmp_path):
+    assert prepare(tmp_path, tmp_path / "out", tp=1, fmt="pickle") == 2
+
+
+# --- launch ------------------------------------------------------------------
+
+@pytest.fixture
+def fake_engine(monkeypatch, tmp_path):
+    seen = {}
+
+    def fake_stage(src, dest, slices=64, file_pattern="*"):
+        seen["pattern"] = file_pattern
+        return StageResult(dest=dest, wall_s=0.1, gbps=1.0, bytes=1)
+
+    def fake_run_profile(command, ready_timeout=1800.0, on_ready=None, head=True, env=None):
+        seen["command"] = command
+        return ProfileReport(command="", started_at=0.0, ready_at=1.0, success=True, framework="sglang")
+
+    monkeypatch.setattr("servekit.launch.stage", fake_stage)
+    monkeypatch.setattr("servekit.launch.run_profile", fake_run_profile)
+    monkeypatch.setattr("servekit.launch.apply_all", lambda: None)
+    monkeypatch.setattr("servekit.launch.DEFAULT_ROOT", tmp_path / "shm")
+    monkeypatch.setattr("servekit.launch.DEFAULT_CACHE_ROOT", tmp_path / "cache-root")
+    return seen
+
+
+def _raw_artifact(tmp_path, src):
+    art = tmp_path / "gpt-oss-raw"
+    art.mkdir()
+    (art / "config.json").write_text(json.dumps(GPT_OSS))
+    (art / "servekit-raw-rank-0.json").write_text("{}")
+    (art / "servekit-raw-rank-0-part-0.safetensors").write_bytes(b"bytes")
+    Manifest(format="raw", engine="sglang", engine_version="0.5.20", tp_size=1, pp_size=1, dp_size=1,
+             dtype="bfloat16", quantization="mxfp4", source=str(src)).write(art)
+    return art
+
+
+def test_a_raw_artifact_serves_on_the_ordinary_loader_and_is_not_refused(tmp_path, fake_engine):
+    src = _model(tmp_path, GPT_OSS)
+    art = _raw_artifact(tmp_path, src)
+    rc = main(["launch", "--servekit-artifact-path", str(art), "--out", str(tmp_path / "r.json"),
+               "--", "python", "-m", "sglang.launch_server", "--model-path", str(src)])
+    assert rc == 0
+    assert fake_engine["command"] == ["python", "-m", "sglang.launch_server", "--model-path", str(tmp_path / "shm" / art.name)]
+
+
+def test_asking_for_another_format_than_the_artifacts_falls_back(tmp_path, fake_engine, capsys):
+    src = _model(tmp_path, GPT_OSS)
+    art = _raw_artifact(tmp_path, src)
+    rc = main(["launch", "--servekit-artifact-path", str(art), "--out", str(tmp_path / "r.json"),
+               "--preshard-format", "sharded_state",
+               "--", "python", "-m", "sglang.launch_server", "--model-path", str(src)])
+    assert rc == 0
+    assert "format: the artifact is raw" in capsys.readouterr().out
+    assert fake_engine["command"][-1] == str(src)  # served from the source, untouched
+
+
+def test_a_node_stages_only_its_own_raw_ranks():
+    topo = Topology(nnodes=2, node_rank=1, tp_size=8, pp_size=1, dist_init_addr="h:1")
+    assert raw_glob(topo) == "servekit-raw-rank-[4-7]-part-*.safetensors"
+
+
+# --- the deepstate command ---------------------------------------------------
+
+def _dump(path, digest):
+    entry = {"path": "w", "kind": "param", "dtype": "bfloat16", "shape": [2], "device": "cpu",
+             "digest": digest, "aliases": []}
+    path.write_text(json.dumps({"meta": {}, "entries": [entry]}))
+
+
+def test_the_deepstate_command_exits_on_a_difference(tmp_path, capsys):
+    for d in ("ref", "same", "other"):
+        (tmp_path / d).mkdir()
+    _dump(tmp_path / "ref" / "deepstate-target-rank-0.json", "aa")
+    _dump(tmp_path / "same" / "deepstate-target-rank-0.json", "aa")
+    _dump(tmp_path / "other" / "deepstate-target-rank-0.json", "bb")
+    assert main(["deepstate", str(tmp_path / "ref"), str(tmp_path / "same")]) == 0
+    assert main(["deepstate", str(tmp_path / "ref"), str(tmp_path / "other"), "--out", str(tmp_path / "r.json")]) == 1
+    assert "differ: 1" in capsys.readouterr().out
+    assert json.loads((tmp_path / "r.json").read_text())["deepstate-target-rank-0.json"]["differ"] == ["w"]
