+
+@contextlib.contextmanager
+def deterministic_empty():
+    """Make torch.empty & co. fill memory deterministically inside the block.
+
+    Torch fills uninitialized memory with NaN (floats) or the max value (ints)
+    while deterministic algorithms are on; warn_only keeps ops without a
+    deterministic kernel running. Restores both settings on exit.
+    """
+    was_on = torch.are_deterministic_algorithms_enabled()
+    was_warn = torch.is_deterministic_algorithms_warn_only_enabled()
+    fill = getattr(torch.utils, "deterministic", None)
+    was_fill = getattr(fill, "fill_uninitialized_memory", None) if fill is not None else None
+    torch.use_deterministic_algorithms(True, warn_only=True)
+    if fill is not None:
+        fill.fill_uninitialized_memory = True
+    try:
+        yield
+    finally:
+        torch.use_deterministic_algorithms(was_on, warn_only=was_warn)
+        if fill is not None and was_fill is not None:
+            fill.fill_uninitialized_memory = was_fill
