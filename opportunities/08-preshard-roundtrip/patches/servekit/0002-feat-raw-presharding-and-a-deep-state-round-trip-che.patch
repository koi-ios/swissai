+++ b/src/servekit/rawshard/sglang_hooks.py
@@ -0,0 +1,282 @@
+"""SGLang hooks for raw presharding and for the deep-state round-trip check.
+
+Installed from servekit's SGLang plugin (`servekit._shim.install`), so they run
+in every scheduler process. Each hook is a pass-through unless asked:
+
+* `SERVEKIT_RAW_RECORD_DIR=<dir>`: the ordinary load records, per rank, which
+  checkpoint bytes it reads, and writes them to <dir> (`servekit prepare`).
+* the model directory holds `servekit-raw-rank-*.json`: the ordinary load pulls
+  its weights from that raw preshard instead of the checkpoint (`servekit
+  launch`). Every reader, post-processing hook and lazy alias then runs exactly
+  as in a default load. With `SERVEKIT_RAW_VERIFY=1` (the default) every read
+  is checked against what was stored, and the load fails if one falls outside.
+* `SERVEKIT_DEEPSTATE_DIR=<dir>`: after the model loads, every tensor it holds
+  -- parameters, buffers, and the hidden ones on quantization objects -- is
+  fingerprinted to <dir>/deepstate-<target|draft>-rank-<r>.json, whatever the
+  load format. Comparing two such dumps is the generic round-trip check.
+
+Hook targets exist from SGLang 0.5.11 (plugin framework) and are checked
+against v0.5.20: loader.py:577 (_get_weights_iterator), :964 (load_model),
+:855 (commit_model_weights, the opt-in startup-overlap path) and
+model_runner.py ModelRunner.load_model.
+
+No SGLang or torch import at module scope: servekit's own process imports the
+plugin package and must not pay for either.
+"""
+from __future__ import annotations
+
+import contextlib
+import json
+import logging
+import os
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger("servekit.rawshard")
+
+ENV_RECORD = "SERVEKIT_RAW_RECORD_DIR"
+ENV_VERIFY = "SERVEKIT_RAW_VERIFY"
+ENV_DEEPSTATE = "SERVEKIT_DEEPSTATE_DIR"
+ENV_DEEPSTATE_DETERMINISTIC = "SERVEKIT_DEEPSTATE_DETERMINISTIC"
+
+ITER_TARGET = "sglang.srt.model_loader.loader.DefaultModelLoader._get_weights_iterator"
+LOAD_TARGET = "sglang.srt.model_loader.loader.DefaultModelLoader.load_model"
+COMMIT_TARGET = "sglang.srt.model_loader.loader.DefaultModelLoader.commit_model_weights"
+RUNNER_TARGET = "sglang.srt.model_executor.model_runner.ModelRunner.load_model"
+
+# Names on SGLang's ParallelContext that decide which slice of each checkpoint
+# tensor a rank reads. Mirrors PreshardedModelLoader._collect_shard_config
+# (loader.py:1930) plus the ranks themselves. Unknown names are skipped, so the
+# list can only grow stricter on newer SGLang.
+_PARALLEL_NAMES = (
+    "tp_rank", "tp_size", "pp_rank", "pp_size",
+    "attn_tp_rank", "attn_tp_size", "attn_dp_rank", "attn_dp_size", "attn_cp_rank", "attn_cp_size",
+    "moe_ep_rank", "moe_ep_size", "moe_tp_rank", "moe_tp_size", "moe_dp_size",
+    "moe_dense_tp_size", "enable_dp_lm_head", "dp_size", "ep_size",
+)
+
+
+class _Process:
+    """Per-process state; one load at a time per process (target, then draft)."""
+
+    def __init__(self) -> None:
+        self.session = None  # RecordSession
+        self.indexes: Dict[str, Any] = {}  # directory -> RawIndex
+        self.used: List[Any] = []  # indexes replayed by the load in progress
+        self.counters: Dict[str, int] = {}
+        self.signature: Optional[Dict[str, Any]] = None
+
+
+_STATE = _Process()
+
+
+def world_rank() -> int:
+    try:
+        import torch.distributed as dist
+
+        if dist.is_available() and dist.is_initialized():
+            return dist.get_rank()
+    except Exception:  # noqa: BLE001 - outside a process group this is rank 0
+        pass
+    return 0
+
+
+def parallel_signature(model_config: Any = None) -> Dict[str, Any]:
+    """Everything that decides which checkpoint bytes this rank reads."""
+    sig: Dict[str, Any] = {"world_rank": world_rank()}
+    try:
+        import torch.distributed as dist
+
+        sig["world_size"] = dist.get_world_size() if dist.is_available() and dist.is_initialized() else 1
+    except Exception:  # noqa: BLE001
+        sig["world_size"] = 1
+    try:
+        from sglang.srt.runtime_context import get_parallel
+
+        parallel = get_parallel()
+        for name in _PARALLEL_NAMES:
+            try:
+                value = getattr(parallel, name)
+            except Exception:  # noqa: BLE001 - absent on this version, or not published
+                continue
+            if isinstance(value, (int, bool, str)) or value is None:
+                sig[name] = value
+    except Exception:  # noqa: BLE001 - pre-0.5.14 SGLang
+        pass
+    try:
+        from sglang.srt.layers.moe.utils import get_moe_a2a_backend, get_moe_runner_backend
+
+        sig["moe_runner_backend"] = str(get_moe_runner_backend())
+        sig["moe_a2a_backend"] = str(get_moe_a2a_backend())
+    except Exception:  # noqa: BLE001
+        pass
+    if model_config is not None:
+        sig["dtype"] = str(getattr(model_config, "dtype", None))
+        sig["quantization"] = getattr(model_config, "quantization", None)
+        sig["is_draft_model"] = bool(getattr(model_config, "is_draft_model", False))
+    try:
+        import sglang
+
+        sig["sglang_version"] = getattr(sglang, "__version__", "unknown")
+    except Exception:  # noqa: BLE001
+        pass
+    return sig
+
+
+def _stream_kind(source: Any) -> Optional[str]:
+    """'target' / 'draft' for the model's own checkpoint, None for anything else.
+
+    Secondary sources (a separate vision tower, an adapter) keep loading from
+    where they live; only the primary checkpoint is presharded.
+    """
+    model_config = getattr(source, "model_config", None)
+    if model_config is None:
+        return None
+    here = os.path.normpath(str(getattr(source, "model_or_path", "")))
+    if here != os.path.normpath(str(getattr(model_config, "model_path", ""))):
+        return None
+    return "draft" if getattr(model_config, "is_draft_model", False) else "target"
+
+
+def _next_key(kind: str) -> str:
+    n = _STATE.counters.get(kind, 0)
+    _STATE.counters[kind] = n + 1
+    return f"{kind}/{n}"
+
+
+def verify_enabled() -> bool:
+    return os.environ.get(ENV_VERIFY, "1") not in ("0", "false", "no", "")
+
+
+def _open_index(directory: str, model_config: Any):
+    from .store import RawIndex
+
+    if directory not in _STATE.indexes:
+        index = RawIndex(directory, world_rank())
+        recorded = index.index.get("signature") or {}
+        current = parallel_signature(model_config)
+        diff = {
+            k: (recorded.get(k), current.get(k))
+            for k in sorted(set(recorded) | set(current))
+            if k not in ("is_draft_model",) and recorded.get(k) != current.get(k)
+        }
+        if diff:
+            lines = ", ".join(f"{k}: prepared {a!r}, now {b!r}" for k, (a, b) in diff.items())
+            raise RuntimeError(
+                f"[SERVEKIT] the raw preshard in {directory} was recorded under a different "
+                f"parallel layout or engine ({lines}); re-run servekit prepare for this command"
+            )
+        _STATE.indexes[directory] = index
+    return _STATE.indexes[directory]
+
+
+def around_weights_iterator(original, self, source, *args, **kwargs):
+    kind = _stream_kind(source)
+    if kind is None:
+        return original(self, source, *args, **kwargs)
+    from .store import has_raw_preshard
+
+    directory = str(source.model_or_path)
+    if has_raw_preshard(directory):
+        index = _open_index(directory, source.model_config)
+        if index not in _STATE.used:
+            _STATE.used.append(index)
+        key = _next_key(kind)
+        logger.info("[SERVEKIT] rank %d: replaying raw preshard stream %s from %s", world_rank(), key, directory)
+        return index.replay_key(key, verify=verify_enabled())
+    record_dir = os.environ.get(ENV_RECORD)
+    if record_dir:
+        from .store import RecordSession
+
+        if _STATE.session is None:
+            _STATE.session = RecordSession(record_dir, world_rank())
+            _STATE.signature = parallel_signature(source.model_config)
+        key = _next_key(kind)
+        return _STATE.session.stream(key, original(self, source, *args, **kwargs),
+                                     source=directory, prefix=getattr(source, "prefix", ""))
+    return original(self, source, *args, **kwargs)
+
+
+def after_load(model: Any) -> None:
+    """Close what the load opened: write the recording, judge the replay."""
+    if _STATE.session is not None and model is not None:
+        stats = _STATE.session.finish(model, signature=_STATE.signature)
+        logger.info(
+            "[SERVEKIT] rank %d: raw preshard recorded %.2f of %.2f GB read (%d full, %d sliced, %d unread tensors)",
+            world_rank(), stats["stored_bytes"] / 1e9, stats["checkpoint_bytes"] / 1e9,
+            stats["tensors_full"], stats["tensors_partial"], stats["tensors_unread"],
+        )
+    used, _STATE.used = _STATE.used, []
+    problems: List[str] = []
+    for index in used:
+        problems.extend(index.verdict(model))
+    if problems:
+        shown = "\n  ".join(problems[:20])
+        raise RuntimeError(
+            f"[SERVEKIT] raw preshard replay on rank {world_rank()} did not match its recording "
+            f"({len(problems)} problem(s)); refusing to serve:\n  {shown}"
+        )
+
+
+def around_load_model(original, self, *args, **kwargs):
+    model = original(self, *args, **kwargs)
+    after_load(model)
+    return model
+
+
+def around_commit_model_weights(original, self, *args, **kwargs):
+    result = original(self, *args, **kwargs)
+    after_load(kwargs.get("model"))
+    return result
+
+
+def around_runner_load(original, self, *args, **kwargs):
+    directory = os.environ.get(ENV_DEEPSTATE)
+    if not directory:
+        return original(self, *args, **kwargs)
+    ctx: Any = contextlib.nullcontext()
+    if os.environ.get(ENV_DEEPSTATE_DETERMINISTIC) == "1":
+        from servekit import deepstate
+
+        ctx = deepstate.deterministic_empty()
+    with ctx:
+        result = original(self, *args, **kwargs)
+    if getattr(self, "startup_weight_load", None) is not None:
+        # overlap mode: the real weights land later, in commit_model_weights
+        logger.warning("[SERVEKIT] deep-state dump skipped: startup_weight_load_mode=overlap")
+        return result
+    dump_deepstate(self.model, directory, draft=bool(getattr(self, "is_draft_worker", False)),
+                   load_format=str(getattr(getattr(self, "load_config", None), "load_format", "?")))
+    return result
+
+
+def dump_deepstate(model: Any, directory: str, draft: bool = False, **meta: Any) -> str:
+    from servekit import deepstate
+
+    os.makedirs(directory, exist_ok=True)
+    kind = "draft" if draft else "target"
+    path = os.path.join(directory, f"deepstate-{kind}-rank-{world_rank()}.json")
+    entries = deepstate.dump(model, path, rank=world_rank(), **meta)
+    logger.info("[SERVEKIT] rank %d: fingerprinted %d tensors to %s", world_rank(), len(entries), path)
+    return path
+
+
+def install() -> None:
+    from sglang.srt.plugins.hook_registry import HookRegistry, HookType
+
+    HookRegistry.register(ITER_TARGET, around_weights_iterator, HookType.AROUND)
+    HookRegistry.register(LOAD_TARGET, around_load_model, HookType.AROUND)
+    HookRegistry.register(COMMIT_TARGET, around_commit_model_weights, HookType.AROUND)
+    HookRegistry.register(RUNNER_TARGET, around_runner_load, HookType.AROUND)
+
+
+def describe(directory: str) -> Dict[str, Any]:
+    """Totals across every rank's index in a raw preshard directory."""
+    totals: Dict[str, Any] = {"ranks": 0, "stored_bytes": 0, "checkpoint_bytes": 0}
+    for name in sorted(os.listdir(directory)):
+        if name.startswith("servekit-raw-rank-") and name.endswith(".json"):
+            with open(os.path.join(directory, name)) as f:
+                stats = json.load(f)["stats"]
+            totals["ranks"] += 1
+            totals["stored_bytes"] += stats["stored_bytes"]
+            totals["checkpoint_bytes"] += stats["checkpoint_bytes"]
+    return totals
diff --git a/src/servekit/rawshard/store.py b/src/servekit/rawshard/store.py
new file mode 100644
index 0000000..c369ac5
--- /dev/null
+++ b/src/servekit/rawshard/store.py
@@ -0,0 +1,326 @@
+"""The raw preshard on disk: per rank, the checkpoint bytes that rank reads.
+
+Layout of an artifact directory (next to config.json, tokenizer files, ...):
+
+    servekit-raw-rank-{rank}.json                 what to replay, in order
+    servekit-raw-rank-{rank}-part-{part}.safetensors   the bytes, as uint8 chunks
+
+`rank` is the torch.distributed world rank of the process that recorded it.
+Each JSON lists the weight streams that rank's load pulled (one per call of the
+engine's weights iterator), and for every tensor in yield order: its name,
+shape, dtype and the byte boxes stored for it. Replaying a stream yields the
+same names in the same order, each as a full-shape tensor whose stored boxes
+hold the original bytes. The rest of the tensor is never read by that rank --
+that is what recording established -- and is left unallocated: torch.empty
+on the CPU is backed by lazily committed pages.
+
+Writing is incremental. A tensor's boxes are copied out as soon as no wrapper
+of it is alive anymore, and parts are flushed at `max_part_bytes`, so peak
+memory is about one part rather than the rank's whole share of the model.
+"""
+from __future__ import annotations
+
+import json
+import math
+import os
+from dataclasses import dataclass, field
+from typing import Any, Dict, Iterator, List, Optional, Tuple
+
+import torch
+
+from .footprint import Box, Checker, Footprint, FootprintTensor, Recorder, unwrap_module
+
+FORMAT = "servekit-raw"
+VERSION = 1
+INDEX_PATTERN = "servekit-raw-rank-{rank}.json"
+PART_PATTERN = "servekit-raw-rank-{rank}-part-{part}.safetensors"
+DEFAULT_MAX_PART_BYTES = 5 * 1024**3
+
+_DTYPES = {
+    str(dt).replace("torch.", ""): dt
+    for dt in (
+        torch.float64, torch.float32, torch.float16, torch.bfloat16,
+        torch.int64, torch.int32, torch.int16, torch.int8, torch.uint8, torch.bool,
+        torch.complex64, torch.complex128,
+    )
+}
+for _name in ("float8_e4m3fn", "float8_e5m2", "float8_e4m3fnuz", "float8_e5m2fnuz",
+              "float8_e8m0fnu", "float4_e2m1fn_x2", "uint16", "uint32", "uint64"):
+    if hasattr(torch, _name):
+        _DTYPES[_name] = getattr(torch, _name)
+
+
+def dtype_name(dtype: torch.dtype) -> str:
+    return str(dtype).replace("torch.", "")
+
+
+def dtype_from_name(name: str) -> torch.dtype:
+    try:
+        return _DTYPES[name]
+    except KeyError:
+        raise ValueError(f"raw preshard: unknown dtype {name!r}") from None
+
+
+def index_path(directory: str, rank: int) -> str:
+    return os.path.join(directory, INDEX_PATTERN.format(rank=rank))
+
+
+def has_raw_preshard(directory: str) -> bool:
+    try:
+        return any(n.startswith("servekit-raw-rank-") and n.endswith(".json") for n in os.listdir(directory))
+    except OSError:
+        return False
+
+
+def _as_bytes(t: torch.Tensor) -> torch.Tensor:
+    """A flat uint8 view of a contiguous tensor's own bytes."""
+    if t.dim() == 0:
+        t = t.reshape(1)
+    return t.reshape(-1).view(torch.uint8)
+
+
+def _extract(base: torch.Tensor, box: Box) -> torch.Tensor:
+    """The bytes of `box` as a fresh, contiguous, CPU uint8 tensor."""
+    flat = _as_bytes(base)
+    view = flat.as_strided(box.sizes, box.strides, flat.storage_offset() + box.offset)
+    return view.to("cpu").clone(memory_format=torch.contiguous_format).reshape(-1)
+
+
+# ---------------------------------------------------------------------- record
+
+
+@dataclass
+class _Stream:
+    index: int
+    key: str
+    meta: Dict[str, Any]
+    entries: List[Dict[str, Any]] = field(default_factory=list)
+
+
+class _PartWriter:
+    def __init__(self, directory: str, rank: int, max_part_bytes: int):
+        self.directory = directory
+        self.rank = rank
+        self.max_part_bytes = max_part_bytes
+        self.part = 0
+        self.pending: Dict[str, torch.Tensor] = {}
+        self.pending_bytes = 0
+        self.written_bytes = 0
+        self.files: List[str] = []
+
+    def add(self, key: str, chunk: torch.Tensor) -> int:
+        """Queue `chunk` under `key`; returns the part it will land in."""
+        n = chunk.numel()
+        if self.pending and self.pending_bytes + n > self.max_part_bytes:
+            self.flush()
+        self.pending[key] = chunk
+        self.pending_bytes += n
+        return self.part
+
+    def flush(self) -> None:
+        if not self.pending:
+            return
+        from safetensors.torch import save_file
+
+        name = PART_PATTERN.format(rank=self.rank, part=self.part)
+        save_file(self.pending, os.path.join(self.directory, name))
+        self.files.append(name)
+        self.written_bytes += self.pending_bytes
+        self.pending, self.pending_bytes = {}, 0
+        self.part += 1
+
+
+class RecordSession:
+    """One rank's recording: wrap the weights a load pulls, then write them out."""
+
+    def __init__(self, directory: str, rank: int, max_part_bytes: int = DEFAULT_MAX_PART_BYTES):
+        os.makedirs(directory, exist_ok=True)
+        self.directory = directory
+        self.rank = rank
+        self.recorder = Recorder()
+        self.streams: List[_Stream] = []
+        self._writer = _PartWriter(directory, rank, max_part_bytes)
+        # id(footprint) -> (stream, footprint, base tensor); dropped once written
+        self._pending: Dict[int, Tuple[_Stream, Footprint, torch.Tensor]] = {}
+        self.checkpoint_bytes = 0
+        self.stored_bytes = 0
+        self.n_full = 0
+        self.n_partial = 0
+        self.n_unread = 0
+
+    def stream(self, key: str, weights, **meta) -> Iterator[Tuple[str, torch.Tensor]]:
+        s = _Stream(index=len(self.streams), key=key, meta=meta)
+        self.streams.append(s)
+        return self._wrap(s, weights)
+
+    def _wrap(self, s: _Stream, weights) -> Iterator[Tuple[str, torch.Tensor]]:
+        for name, tensor in weights:
+            self._finalize_dead()
+            wrapped = self.recorder.wrap(name, tensor)
+            fp = self.recorder.footprints[-1]
+            self._pending[id(fp)] = (s, fp, tensor)
+            yield name, wrapped
+            del wrapped  # the generator frame must not keep the wrapper alive
+        self._finalize_dead()
+
+    def _finalize_dead(self) -> None:
+        for key in [k for k, (_, fp, _) in self._pending.items() if len(fp.live) == 0]:
+            self._finalize(key)
+
+    def _finalize(self, key: int) -> None:
+        s, fp, base = self._pending.pop(key)
+        boxes = []
+        for j, box in enumerate(fp.boxes):
+            chunk_key = f"{s.index}.{fp.order}.{j}"
+            part = self._writer.add(chunk_key, _extract(base, box))
+            boxes.append(box.to_json() + [part, chunk_key])
+        s.entries.append({
+            "name": fp.name,
+            "shape": list(fp.shape),
+            "dtype": dtype_name(fp.dtype),
+            "order": fp.order,
+            "full": fp.full,
+            "boxes": boxes,
+        })
+        self.checkpoint_bytes += fp.nbytes
+        self.stored_bytes += fp.stored_bytes
+        if fp.full:
+            self.n_full += 1
+        elif fp.boxes:
+            self.n_partial += 1
+        else:
+            self.n_unread += 1
+
+    def finish(self, model: Optional[torch.nn.Module] = None, **meta) -> Dict[str, Any]:
+        """After a load returned: write what it read, and (re)write the index.
+
+        Callable once per load in the process (the target model, then a draft
+        model); each call rewrites the index with every stream so far.
+        """
+        leaked = unwrap_module(model) if model is not None else 0
+        self._leaked = getattr(self, "_leaked", 0) + leaked
+        for key in list(self._pending):
+            self._finalize(key)
+        self._writer.flush()
+        for s in self.streams:
+            s.entries.sort(key=lambda e: e["order"])
+        index = {
+            "format": FORMAT,
+            "version": VERSION,
+            "rank": self.rank,
+            "files": self._writer.files,
+            "streams": [{"key": s.key, "meta": s.meta, "entries": s.entries} for s in self.streams],
+            "stats": {
+                "checkpoint_bytes": self.checkpoint_bytes,
+                "stored_bytes": self.stored_bytes,
+                "tensors_full": self.n_full,
+                "tensors_partial": self.n_partial,
+                "tensors_unread": self.n_unread,
+                "wrappers_left_in_model": self._leaked,
+                "escapes": list(self.recorder.escapes),
+            },
+            **meta,
+        }
+        tmp = index_path(self.directory, self.rank) + ".tmp"
+        with open(tmp, "w") as f:
+            json.dump(index, f)
+        os.replace(tmp, index_path(self.directory, self.rank))
+        return index["stats"]
+
+
+# ---------------------------------------------------------------------- replay
+
+
+class RawIndex:
+    """One rank's raw preshard, ready to replay through the ordinary load."""
+
+    def __init__(self, directory: str, rank: int):
+        path = index_path(directory, rank)
+        if not os.path.isfile(path):
+            raise FileNotFoundError(
+                f"no raw preshard for rank {rank} in {directory} ({os.path.basename(path)} missing); "
+                f"the artifact was prepared for a different world size"
+            )
+        with open(path) as f:
+            self.index = json.load(f)
+        if self.index.get("format") != FORMAT or self.index.get("version") != VERSION:
+            raise ValueError(f"{path} is not a servekit raw preshard v{VERSION}")
+        self.directory = directory
+        self.rank = rank
+        self._handles: Dict[int, Any] = {}
+        self.checker: Optional[Checker] = None
+        self.served: List[str] = []
+
+    @property
+    def streams(self) -> List[Dict[str, Any]]:
+        return self.index["streams"]
+
+    def _handle(self, part: int):
+        if part not in self._handles:
+            from safetensors import safe_open
+
+            name = PART_PATTERN.format(rank=self.rank, part=part)
+            self._handles[part] = safe_open(os.path.join(self.directory, name), framework="pt")
+        return self._handles[part]
+
+    def tensor(self, entry: Dict[str, Any]) -> torch.Tensor:
+        dtype = dtype_from_name(entry["dtype"])
+        shape = tuple(entry["shape"])
+        elem = torch.empty((), dtype=dtype).element_size()
+        nbytes = math.prod(shape) * elem
+        if entry["full"] and len(entry["boxes"]) == 1:
+            *_, part, key = entry["boxes"][0]
+            data = self._handle(part).get_tensor(key)
+            return data.view(dtype).reshape(shape)
+        flat = torch.empty(max(nbytes, 1), dtype=torch.uint8)
+        for offset, sizes, strides, part, key in entry["boxes"]:
+            data = self._handle(part).get_tensor(key)
+            flat.as_strided(tuple(sizes), tuple(strides), offset).copy_(data.view(tuple(sizes)))
+        return flat[:nbytes].view(dtype).reshape(shape)
+
+    def replay(self, stream: int, verify: bool = False) -> Iterator[Tuple[str, torch.Tensor]]:
+        if stream >= len(self.streams):
+            raise RuntimeError(
+                f"raw preshard for rank {self.rank} recorded {len(self.streams)} weight stream(s), "
+                f"but this load asks for stream {stream}: the engine is loading differently than "
+                f"when the artifact was prepared"
+            )
+        return self.replay_key(self.streams[stream]["key"], verify=verify)
+
+    def replay_key(self, key: str, verify: bool = False) -> Iterator[Tuple[str, torch.Tensor]]:
+        by_key = {s["key"]: s for s in self.streams}
+        if key not in by_key:
+            raise RuntimeError(
+                f"raw preshard for rank {self.rank} has no weight stream {key!r} (recorded: "
+                f"{sorted(by_key)}): the engine is loading differently than when it was prepared"
+            )
+        if verify and self.checker is None:
+            self.checker = Checker()
+        self.served.append(key)
+        return self._entries(by_key[key], verify)
+
+    def _entries(self, stream: Dict[str, Any], verify: bool) -> Iterator[Tuple[str, torch.Tensor]]:
+        for entry in stream["entries"]:
+            t = self.tensor(entry)
+            if verify:
+                fp = Footprint(entry["name"], tuple(entry["shape"]), t.dtype, entry["order"])
+                fp.full = entry["full"]
+                fp.boxes = {Box.from_json(b[:3]): None for b in entry["boxes"]}
+                t = self.checker.wrap_stored(fp, t)
+            yield entry["name"], t
+
+    def verdict(self, model: Optional[torch.nn.Module] = None) -> List[str]:
+        """Reads that fell outside what was stored (empty: the replay was exact)."""
+        problems: List[str] = []
+        if self.checker is not None:
+            if model is not None:
+                unwrap_module(model)
+            problems.extend(self.checker.violations)
+        kinds = {k.split("/")[0] for k in self.served}
+        unserved = [s["key"] for s in self.streams if s["key"].split("/")[0] in kinds and s["key"] not in self.served]
+        if unserved:
+            problems.append(f"the load never pulled recorded weight stream(s) {unserved}")
+        return problems
+
+    def close(self) -> None:
+        self._handles.clear()
