index 0000000..8c3542d
--- /dev/null
+++ b/tests/test_rawshard.py
@@ -0,0 +1,198 @@
+"""Raw presharding: record one ordinary load per rank, replay it through the ordinary load."""
+import os
+import sys
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("safetensors")
+
+sys.path.insert(0, os.path.dirname(__file__))
+
+from _mini_tp import MiniModel, default_load, iterate_checkpoint, make_checkpoint, save_checkpoint  # noqa: E402
+
+from servekit import deepstate  # noqa: E402
+from servekit.rawshard.footprint import Box, Recorder, canonical_box  # noqa: E402
+from servekit.rawshard.store import RawIndex, RecordSession  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def checkpoint(tmp_path_factory):
+    d = tmp_path_factory.mktemp("ckpt")
+    return save_checkpoint(make_checkpoint(), str(d))
+
+
+def _plain(paths, rank, world, **kw):
+    with deterministic():
+        return default_load(MiniModel(rank, world, **kw), iterate_checkpoint(paths))
+
+
+def deterministic():
+    return deepstate.deterministic_empty()
+
+
+def _record(paths, out, rank, world, max_part_bytes=1 << 30, **kw):
+    session = RecordSession(str(out), rank, max_part_bytes=max_part_bytes)
+    with deterministic():
+        model = MiniModel(rank, world, **kw)
+        default_load(model, session.stream("target/0", iterate_checkpoint(paths), source="ckpt"))
+    stats = session.finish(model)
+    return model, stats
+
+
+def _replay(out, rank, world, verify=False, **kw):
+    index = RawIndex(str(out), rank)
+    with deterministic():
+        model = default_load(MiniModel(rank, world, **kw), index.replay(0, verify=verify))
+    return model, index
+
+
+@pytest.mark.parametrize("world", [1, 2, 4])
+def test_replay_reproduces_every_tensor_of_the_default_load(checkpoint, tmp_path, world):
+    for rank in range(world):
+        reference = deepstate.fingerprint(_plain(checkpoint, rank, world))
+        recorded, _ = _record(checkpoint, tmp_path, rank, world)
+        replayed, index = _replay(tmp_path, rank, world, verify=True)
+
+        assert deepstate.compare(reference, deepstate.fingerprint(recorded)).ok, "recording perturbed the load"
+        report = deepstate.compare(reference, deepstate.fingerprint(replayed))
+        assert report.ok, report.summary()
+        assert index.verdict(replayed) == []
+        ids = torch.tensor([0, 5, 36])
+        assert torch.equal(recorded(ids), replayed(ids))
+
+
+def test_each_rank_stores_only_its_share(checkpoint, tmp_path):
+    world = 4
+    stats = [_record(checkpoint, tmp_path, r, world)[1] for r in range(world)]
+    total = stats[0]["checkpoint_bytes"]
+    stored = sum(s["stored_bytes"] for s in stats)
+    # sharded tensors are split four ways; norms, router, scalars are replicated
+    assert stored < 1.6 * total, (stored, total)
+
+    entries = {e["name"]: e for e in RawIndex(str(tmp_path), 2).streams[0]["entries"]}
+    o_proj = entries["attn.o_proj.weight"]
+    assert not o_proj["full"]
+    (offset, sizes, strides, _part, _key), = o_proj["boxes"]
+    # rank 2 of a row-parallel [16, 16] bf16 weight: columns 8..11 of every row
+    assert (offset, sizes, strides) == (2 * 4 * 2, [16, 8], [32, 1])
+    assert entries["unused.rotary_emb.inv_freq"]["boxes"] == []
+    assert entries["k_scale"]["full"] and entries["router.weight"]["full"]
+
+
+def test_expert_parallel_ranks_store_only_their_experts(checkpoint, tmp_path):
+    _, stats = _record(checkpoint, tmp_path, 1, 2, ep=True)
+    entries = {e["name"]: e for e in RawIndex(str(tmp_path), 1).streams[0]["entries"]}
+    blocks = entries["experts.gate_up_proj_blocks"]
+    assert len(blocks["boxes"]) == 2  # experts 1 and 3, one box each
+    replayed, index = _replay(tmp_path, 1, 2, verify=True, ep=True)
+    reference = deepstate.fingerprint(_plain(checkpoint, 1, 2, ep=True))
+    assert deepstate.compare(reference, deepstate.fingerprint(replayed)).ok
+    assert index.verdict(replayed) == []
+
+
+def test_replaying_another_ranks_preshard_is_caught(checkpoint, tmp_path):
+    _record(checkpoint, tmp_path, 0, 2)
+    index = RawIndex(str(tmp_path), 0)
+    with deterministic():
+        wrong = default_load(MiniModel(1, 2), index.replay(0, verify=True))
+    problems = index.verdict(wrong)
+    assert problems and any("attn.o_proj.weight" in p for p in problems), problems
+
+
+def test_small_parts_still_replay_exactly(checkpoint, tmp_path):
+    _, stats = _record(checkpoint, tmp_path, 1, 2, max_part_bytes=512)
+    index = RawIndex(str(tmp_path), 1)
+    assert len(index.index["files"]) > 3
+    replayed, _ = _replay(tmp_path, 1, 2)
+    reference = deepstate.fingerprint(_plain(checkpoint, 1, 2))
+    assert deepstate.compare(reference, deepstate.fingerprint(replayed)).ok
+
+
+def test_threaded_weight_loading_is_recorded(checkpoint, tmp_path):
+    class Threaded(MiniModel):
+        def load_weights(self, weights):
+            items = list(weights)  # materialize, then load from a pool
+            with ThreadPoolExecutor(4) as pool:
+                list(pool.map(lambda nw: MiniModel.load_weights(self, [nw]), [i for i in items if not i[0].startswith("mlp.")]))
+            MiniModel.load_weights(self, [i for i in items if i[0].startswith("mlp.")])
+
+    session = RecordSession(str(tmp_path), 0)
+    with deterministic():
+        model = default_load(Threaded(0, 2), session.stream("target/0", iterate_checkpoint(checkpoint)))
+    session.finish(model)
+    replayed, index = _replay(tmp_path, 0, 2, verify=True)
+    reference = deepstate.fingerprint(_plain(checkpoint, 0, 2))
+    assert deepstate.compare(reference, deepstate.fingerprint(replayed)).ok
+    assert index.verdict(replayed) == []
+
+
+def test_a_loader_that_keeps_the_checkpoint_tensor_is_unwrapped(tmp_path):
+    from servekit.rawshard.footprint import FootprintTensor
+
+    class Keeper(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.register_buffer("kept", None)
+
+        def load_weights(self, weights):
+            for _, w in weights:
+                self.kept = w  # zero-copy: the model holds the checkpoint tensor
+
+    session = RecordSession(str(tmp_path), 0)
+    model = Keeper()
+    model.load_weights(session.stream("target/0", iter([("kept", torch.arange(6.0))])))
+    assert isinstance(model.kept, FootprintTensor)
+    stats = session.finish(model)
+    assert not isinstance(model.kept, FootprintTensor)
+    assert stats["wrappers_left_in_model"] == 1 and stats["tensors_full"] == 1
+
+
+def test_asking_for_a_stream_that_was_never_recorded_fails_loudly(checkpoint, tmp_path):
+    _record(checkpoint, tmp_path, 0, 1)
+    with pytest.raises(RuntimeError, match="stream 1"):
+        next(RawIndex(str(tmp_path), 0).replay(1))
+
+
+def test_a_missing_rank_names_the_world_size_problem(tmp_path):
+    with pytest.raises(FileNotFoundError, match="different world size"):
+        RawIndex(str(tmp_path), 3)
+
+
+# ------------------------------------------------------------- footprint units
+
+
+def _reads(fn, base):
+    rec = Recorder()
+    fn(rec.wrap("w", base))
+    return list(rec.footprints[0].boxes), rec.footprints[0].full
+
+
+def test_narrow_records_a_box_not_the_tensor():
+    boxes, full = _reads(lambda w: torch.zeros(4, 3).copy_(w.narrow(1, 3, 3)), torch.zeros(4, 6))
+    assert not full and boxes == [Box(12, (4, 12), (24, 1))]
+
+
+def test_dtype_views_scalars_and_cat_are_reads():
+    base = torch.arange(8, dtype=torch.float32)
+    assert _reads(lambda w: w.view(torch.int32).sum(), base)[1]
+    assert _reads(lambda w: w[3].item(), base)[0] == [Box(12, (4,), (1,))]
+    boxes, _ = _reads(lambda w: torch.cat([w[:2], w[6:]]), base)
+    assert boxes == [Box(0, (8,), (1,)), Box(24, (8,), (1,))]
+
+
+def test_methods_that_leave_the_dispatcher_count_as_full_reads():
+    for fn in (lambda w: w.numpy(), lambda w: w.tolist(), lambda w: w.data_ptr()):
+        assert _reads(fn, torch.arange(4.0))[1]
+
+
+def test_views_alone_read_nothing():
+    boxes, full = _reads(lambda w: (w.t(), w[1:], w.view(-1), w.chunk(2)), torch.zeros(2, 2))
+    assert boxes == [] and not full
+
+
+def test_canonical_boxes_merge_contiguous_dims():
+    assert canonical_box(0, [2, 3, 4], [12, 4, 1]) == Box(0, (24,), (1,))
+    assert canonical_box(8, [4, 1, 2], [16, 99, 1]) == Box(8, (4, 2), (16, 1))
+    assert canonical_box(0, [0, 4], [4, 1]) is None
