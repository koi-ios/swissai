+package crdt_test
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	crdt "opentela/internal/protocol/go-ds-crdt"
+
+	cid "github.com/ipfs/go-cid"
+	ds "github.com/ipfs/go-datastore"
+	dssync "github.com/ipfs/go-datastore/sync"
+	ipld "github.com/ipfs/go-ipld-format"
+	logging "github.com/ipfs/go-log/v2"
+)
+
+// bus is an in-memory pubsub topic: a broadcast reaches every other member that
+// has joined. Members can join late and leave, which a pipe pair cannot model.
+type bus struct {
+	mu      sync.Mutex
+	members map[*busMember]struct{}
+}
+
+type busMember struct {
+	bus   *bus
+	inbox chan []byte
+	done  chan struct{}
+	once  sync.Once
+}
+
+func newBus() *bus { return &bus{members: map[*busMember]struct{}{}} }
+
+// member returns a broadcaster that neither sends nor receives until join.
+func (b *bus) member() *busMember {
+	return &busMember{bus: b, inbox: make(chan []byte, 1024), done: make(chan struct{})}
+}
+
+func (m *busMember) join() {
+	m.bus.mu.Lock()
+	m.bus.members[m] = struct{}{}
+	m.bus.mu.Unlock()
+}
+
+func (m *busMember) leave() {
+	m.bus.mu.Lock()
+	delete(m.bus.members, m)
+	m.bus.mu.Unlock()
+	m.once.Do(func() { close(m.done) })
+}
+
+func (m *busMember) Broadcast(ctx context.Context, data []byte) error {
+	m.bus.mu.Lock()
+	defer m.bus.mu.Unlock()
+	if _, joined := m.bus.members[m]; !joined {
+		return nil // not on the topic yet: the message goes nowhere
+	}
+	for other := range m.bus.members {
+		if other == m {
+			continue
+		}
+		select {
+		case other.inbox <- append([]byte(nil), data...):
+		default: // a full inbox drops, like a slow gossipsub peer
+		}
+	}
+	return nil
+}
+
+func (m *busMember) Next(ctx context.Context) ([]byte, error) {
+	select {
+	case b := <-m.inbox:
+		return b, nil
+	case <-m.done:
+		return nil, crdt.ErrNoMoreBroadcast
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+// historyGate serves the first `allow` distinct blocks a replica fetches and
+// holds every later fetch until released. A replica walks a branch from its
+// tip downwards, so the gate lets it merge the newest part of the history while
+// the rest of the walk is still pending, the state a restarted node is in for
+// minutes while it pulls a long DAG over bitswap.
+type historyGate struct {
+	ipld.DAGService
+	allow int
+
+	mu      sync.Mutex
+	served  map[cid.Cid]struct{}
+	held    int
+	open    chan struct{}
+	release sync.Once
+}
+
+func newHistoryGate(base ipld.DAGService, allow int) *historyGate {
+	return &historyGate{DAGService: base, allow: allow, served: map[cid.Cid]struct{}{}, open: make(chan struct{})}
+}
+
+func (g *historyGate) Release() { g.release.Do(func() { close(g.open) }) }
+
+func (g *historyGate) heldFetches() int {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.held
+}
+
+func (g *historyGate) admit(ctx context.Context, c cid.Cid) error {
+	g.mu.Lock()
+	if _, ok := g.served[c]; ok || len(g.served) < g.allow {
+		g.served[c] = struct{}{}
+		g.mu.Unlock()
+		return nil
+	}
+	g.held++
+	g.mu.Unlock()
+	select {
+	case <-g.open:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (g *historyGate) Get(ctx context.Context, c cid.Cid) (ipld.Node, error) {
+	if err := g.admit(ctx, c); err != nil {
+		return nil, err
+	}
+	return g.DAGService.Get(ctx, c)
+}
+
+func (g *historyGate) GetMany(ctx context.Context, cids []cid.Cid) <-chan *ipld.NodeOption {
+	out := make(chan *ipld.NodeOption, len(cids))
+	go func() {
+		defer close(out)
+		for _, c := range cids {
+			if err := g.admit(ctx, c); err != nil {
+				out <- &ipld.NodeOption{Err: err}
+				continue
+			}
+			nd, err := g.DAGService.Get(ctx, c)
+			out <- &ipld.NodeOption{Node: nd, Err: err}
+		}
+	}()
+	return out
+}
+
+func restartTestOptions(name string) *crdt.Options {
+	o := crdt.DefaultOptions()
+	o.Logger = logging.Logger(name)
+	o.RebroadcastInterval = 200 * time.Millisecond
+	o.DAGSyncerTimeout = time.Minute
+	o.MultiHeadProcessing = true // as in OpenTela (internal/protocol/crdt.go)
+	return o
+}
+
+func waitValue(ctx context.Context, store *crdt.Datastore, key ds.Key, want []byte, d time.Duration) bool {
+	deadline := time.Now().Add(d)
+	for time.Now().Before(deadline) {
+		if v, err := store.Get(ctx, key); err == nil && bytes.Equal(v, want) {
+			return true
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	return false
+}
+
+func valueOf(ctx context.Context, store *crdt.Datastore, key ds.Key) string {
+	v, err := store.Get(ctx, key)
+	if err != nil {
+		return "<" + err.Error() + ">"
+	}
+	return string(v)
+}
+
+// TestRestartedReplicaRowOutranksItsPreviousIncarnation reproduces
+// eth-easl/OpenTela#73 at the CRDT layer.
+//
+// A worker that restarts keeps its peer ID but starts from an empty store
+// (cleanslate defaults to true, and shutdown wipes the store as well). The rest
+// of the mesh still holds the row of its previous incarnation, its own LEFT
+// record from AnnounceLeave, at the height the mesh had reached. The restarted
+// worker writes at height 1, 2, ... and setValue on every peer drops those
+// writes as stale until the worker has walked the entire history, which on a
+// long-lived mesh takes minutes.
+//
+// The worker does merge the LEFT record early: it sits near the tip of the DAG,
+// which is where the walk starts. A write the worker makes after that merge
+// must win, whether or not the rest of the walk has finished.
+func TestRestartedReplicaRowOutranksItsPreviousIncarnation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	shared := newSharedDAG() // every block is fetchable: the head never leaves
+	topic := newBus()
+	rowKey := ds.NewKey("/worker")
+
+	// The head, and the worker's first incarnation.
+	headBC := topic.member()
+	headBC.join()
+	head, err := crdt.New(dssync.MutexWrap(ds.NewMapDatastore()), ds.NewKey("/ocf-crdt"), shared, headBC, restartTestOptions("head"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer head.Close()
+
+	w1BC := topic.member()
+	w1BC.join()
+	w1, err := crdt.New(dssync.MutexWrap(ds.NewMapDatastore()), ds.NewKey("/ocf-crdt"), shared, w1BC, restartTestOptions("worker-1"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Mesh history: other rows written over the life of the mesh.
+	const history = 40
+	for i := 0; i < history; i++ {
+		if err := head.Put(ctx, ds.NewKey(fmt.Sprintf("/peer-%d", i)), []byte("row")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !waitHas(ctx, w1, ds.NewKey(fmt.Sprintf("/peer-%d", history-1)), 10*time.Second) {
+		t.Fatal("worker-1 never synced the mesh history")
+	}
+
+	// worker-1 registers, then shuts down gracefully (AnnounceLeave).
+	ready1, left1 := []byte(`{"status":"ready","life":1}`), []byte(`{"status":"left","life":1}`)
+	if err := w1.Put(ctx, rowKey, ready1); err != nil {
+		t.Fatal(err)
+	}
+	if !waitValue(ctx, head, rowKey, ready1, 10*time.Second) {
+		t.Fatalf("head never saw worker-1's ready row; has %s", valueOf(ctx, head, rowKey))
+	}
+	if err := w1.Put(ctx, rowKey, left1); err != nil {
+		t.Fatal(err)
+	}
+	if !waitValue(ctx, head, rowKey, left1, 10*time.Second) {
+		t.Fatalf("head never saw worker-1's LEFT row; has %s", valueOf(ctx, head, rowKey))
+	}
+	w1BC.leave()
+	_ = w1.Close()
+
+	// The mesh keeps writing while the worker is down.
+	const whileDown = 3
+	for i := 0; i < whileDown; i++ {
+		if err := head.Put(ctx, ds.NewKey(fmt.Sprintf("/later-%d", i)), []byte("row")); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// worker-2: same row key, empty store. The gate serves the newest blocks,
+	// enough to reach the LEFT record, and holds the rest of the walk.
+	gate := newHistoryGate(shared, whileDown+4)
+	defer gate.Release()
+	w2BC := topic.member()
+	w2, err := crdt.New(dssync.MutexWrap(ds.NewMapDatastore()), ds.NewKey("/ocf-crdt"), gate, w2BC, restartTestOptions("worker-2"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		gate.Release()
+		w2BC.leave()
+		_ = w2.Close()
+	}()
+
+	// Like InitializeMyself, worker-2 writes its row before it has heard from
+	// anyone. Nothing can make this first write win: worker-2 knows nothing.
+	if err := w2.Put(ctx, rowKey, []byte(`{"status":"pending","life":2}`)); err != nil {
+		t.Fatal(err)
+	}
+	w2BC.join()
+
+	// worker-2 merges the tip of the history, LEFT record included. On its own
+	// store the previous incarnation's row now outranks the row it just wrote.
+	if !waitValue(ctx, w2, rowKey, left1, 10*time.Second) {
+		t.Fatalf("worker-2 never merged its previous incarnation's row; has %s", valueOf(ctx, w2, rowKey))
+	}
+
+	// It announces itself again, as OpenTela's self-row guard does on seeing a
+	// row it did not write.
+	ready2 := []byte(`{"status":"ready","life":2}`)
+	if err := w2.Put(ctx, rowKey, ready2); err != nil {
+		t.Fatal(err)
+	}
+	if gate.heldFetches() == 0 {
+		t.Fatal("test setup: worker-2 finished walking the history; the gate did not hold it")
+	}
+
+	if !waitValue(ctx, head, rowKey, ready2, 5*time.Second) {
+		t.Fatalf("head still holds %s for the restarted worker after its post-merge write "+
+			"(worker-2 max height %d, history walk still pending): a write made after merging "+
+			"the LEFT record lost to it",
+			valueOf(ctx, head, rowKey), w2.InternalStats(ctx).MaxHeight)
+	}
+	if !waitValue(ctx, w2, rowKey, ready2, 5*time.Second) {
+		t.Fatalf("worker-2 does not see its own row; has %s", valueOf(ctx, w2, rowKey))
+	}
+
+	// Once the walk completes nothing changes: both replicas keep the new row.
+	gate.Release()
+	if !waitHas(ctx, w2, ds.NewKey("/peer-0"), 10*time.Second) {
+		t.Fatal("worker-2 never finished the history walk after release")
+	}
+	time.Sleep(500 * time.Millisecond)
+	if got := valueOf(ctx, head, rowKey); got != string(ready2) {
+		t.Fatalf("head row regressed to %s after the walk completed", got)
+	}
+	if got := valueOf(ctx, w2, rowKey); got != string(ready2) {
+		t.Fatalf("worker-2 row regressed to %s after the walk completed", got)
+	}
+}
