index 06d3c95..923e0f6 100644
--- a/src/internal/protocol/go-ds-crdt/set.go
+++ b/src/internal/protocol/go-ds-crdt/set.go
@@ -297,6 +297,30 @@ func (s *set) getPriority(ctx context.Context, key string) (uint64, error) {
 	return prio - 1, nil
 }
 
+// maxPriority returns the highest priority among the current values of the
+// keys in elems, or 0 if none of them has a value. It holds putElemsMux so a
+// merge in progress, which batches its priority writes, is either complete or
+// not yet started.
+func (s *set) maxPriority(ctx context.Context, elems []*pb.Element) (uint64, error) {
+	if len(elems) == 0 {
+		return 0, nil
+	}
+	s.putElemsMux.Lock()
+	defer s.putElemsMux.Unlock()
+
+	var highest uint64
+	for _, e := range elems {
+		prio, err := s.getPriority(ctx, e.GetKey())
+		if err != nil {
+			return 0, err
+		}
+		if prio > highest {
+			highest = prio
+		}
+	}
+	return highest, nil
+}
+
 func (s *set) setPriority(ctx context.Context, writeStore ds.Write, key string, prio uint64) error {
 	prioK := s.priorityKey(key)
 	buf := make([]byte, binary.MaxVarintLen64)
