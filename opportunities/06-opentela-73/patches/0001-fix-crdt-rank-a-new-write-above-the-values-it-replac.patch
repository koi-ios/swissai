diff --git a/src/internal/protocol/go-ds-crdt/crdt.go b/src/internal/protocol/go-ds-crdt/crdt.go
index 6d6dcc5..d89c67f 100644
--- a/src/internal/protocol/go-ds-crdt/crdt.go
+++ b/src/internal/protocol/go-ds-crdt/crdt.go
@@ -1402,6 +1402,22 @@ func (store *Datastore) addDAGNode(ctx context.Context, delta *pb.Delta) (cid.Ci
 	}
 	height = height + 1 // This implies our minimum height is 1
 
+	// A replica can hold a value at a priority above its own heads: it has
+	// merged the block carrying the value but not yet walked the branch below
+	// it, so that branch's root is not a head. A node that restarts with an
+	// empty store sits in this state for as long as it takes to pull the
+	// whole history. A write made at height+1 would rank below a value it has
+	// already merged, and setValue on every replica would drop the write as
+	// stale (eth-easl/OpenTela#73). Rank the write above every value it
+	// replaces, the way a Lamport clock moves past each timestamp it receives.
+	replaced, err := store.set.maxPriority(ctx, delta.GetElements())
+	if err != nil {
+		return cid.Undef, fmt.Errorf("error reading current priorities: %w", err)
+	}
+	if replaced >= height {
+		height = replaced + 1
+	}
+
 	delta.Priority = height
 
 	// for _, e := range delta.GetElements() {
