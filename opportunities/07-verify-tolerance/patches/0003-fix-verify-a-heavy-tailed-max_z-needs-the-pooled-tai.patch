+def test_gpd_tail_quantile_recovers_known_tails():
+    rng = random.Random(0)
+    expo = [rng.expovariate(1.0) for _ in range(20000)]  # exponential: xi = 0, quantile = -ln p
+    q, xi = vs.gpd_tail_quantile(expo, 1e-5)
+    assert abs(xi) < 0.1 and q == pytest.approx(-math.log(1e-5), rel=0.1)
+    pareto = [rng.paretovariate(3.0) for _ in range(20000)]  # Pareto(3): xi = 1/3, quantile = p^(-1/3)
+    q, xi = vs.gpd_tail_quantile(pareto, 1e-5)
+    assert xi == pytest.approx(1 / 3, abs=0.12) and q == pytest.approx(1e-5 ** (-1 / 3), rel=0.35)
+    assert vs.gpd_tail_quantile([1.0] * 10, 1e-3) == (None, None)
+
+
+def test_one_fragile_token_under_a_rare_setting_does_not_alarm():
+    """The MXFP4 failure of the first version: a confident token that moves 10 sigma under a setting
+    calibration never sampled. The pooled-tail max_z threshold must absorb it."""
+    ref = _ref()
+    m = _model(ref, k=16)
+    rng = random.Random(5)
+    alarms = 0
+    for i in range(40):
+        cap = _noisy(ref, 2000 + i)
+        if rng.random() < 0.1:  # a rare setting moves one confident token by 10 sigma
+            p = cap["prompts"][3]
+            ref_lps = ref["prompts"][3]["token_logprobs"]
+            j = min((j for j, lp in enumerate(ref_lps) if lp > -0.01), key=lambda j: ref_lps[j])
+            lp = ref_lps[j]
+            p["token_logprobs"][j] = lp - 10 * m.scale * (-math.expm1(lp))
+        alarms += not vs.decide_statistical(ref, cap, m).passed
+    assert alarms <= 2
+    assert m.tail_shape is not None
