+def gpd_tail_quantile(xs: Sequence[float], p: float, tail_frac: float = TAIL_FRACTION,
+                      min_exceed: int = 50) -> Tuple[Optional[float], Optional[float]]:
+    """The value `xs`' distribution exceeds with probability `p`, extrapolated past the data.
+
+    Peaks over threshold: a generalized Pareto distribution fitted to the top
+    `tail_frac` of `xs` by probability-weighted moments (Hosking & Wallis 1987).
+    Returns (quantile, shape xi), or (None, None) without enough tail samples.
+    """
+    xs = sorted(xs)
+    n = len(xs)
+    k_n = max(min_exceed, int(tail_frac * n))
+    if n < 2 * k_n or k_n < min_exceed:
+        return None, None
+    u = xs[n - k_n - 1]
+    y = [x - u for x in xs[n - k_n:]]
+    m = len(y)
+    a0 = sum(y) / m
+    a1 = sum(yj * (m - 1 - j) / (m - 1) for j, yj in enumerate(y)) / m  # E[Y (1 - F(Y))]
+    if a0 <= 0 or a0 - 2 * a1 <= 0:
+        return None, None
+    k = a0 / (a0 - 2 * a1) - 2  # Hosking's shape, k = -xi
+    scale = 2 * a0 * a1 / (a0 - 2 * a1)
+    r = p / (k_n / n)  # exceedance probability beyond u
+    if r >= 1:
+        return u, -k
+    yq = -scale * math.log(r) if abs(k) < 1e-9 else scale / k * (1 - r ** k)
+    return u + yq, -k
+
+
