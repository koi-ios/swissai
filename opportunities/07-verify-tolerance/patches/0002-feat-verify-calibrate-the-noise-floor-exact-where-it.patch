+# --------------------------------------------------------------------------
+# aligning captures
+
+
+def _top(entry) -> List[Tuple[str, float]]:
+    """A top-logprobs entry as [(token, logprob)] sorted best first; accepts pairs or a {token: lp} dict."""
+    if not entry:
+        return []
+    items = entry.items() if isinstance(entry, dict) else [tuple(x) for x in entry]
+    return sorted(((str(t), float(v)) for t, v in items if v is not None), key=lambda x: -x[1])
+
+
+@dataclass
+class Aligned:
+    """Per-token data of one capture against the reference, prompt by prompt."""
+
+    prompts: List[dict] = field(default_factory=list)  # {key, ref, got, ref_top, got_top, tokens}
+    failures: List[str] = field(default_factory=list)  # structural: absent prompts, tokenization changes
+
+
+def align(reference: dict, captured: dict) -> Aligned:
+    out = Aligned()
+    by_key = {p["key"]: p for p in captured.get("prompts", [])}
+    for exp in reference.get("prompts", []):
+        key = exp["key"]
+        got = by_key.get(key)
+        if got is None:
+            out.failures.append(f"{key}: absent from the captured run")
+            continue
+        if got.get("n_tokens") != exp.get("n_tokens") or len(got["token_logprobs"]) != len(exp["token_logprobs"]):
+            out.failures.append(
+                f"{key}: tokenized to {got.get('n_tokens')} tokens, the reference got {exp.get('n_tokens')} "
+                f"-- nothing below is comparable"
+            )
+            continue
+        out.prompts.append({
+            "key": key,
+            "ref": [float(v) for v in exp["token_logprobs"]],
+            "got": [float(v) for v in got["token_logprobs"]],
+            "tokens": exp.get("tokens"),
+            "ref_top": exp.get("top_logprobs"),
+            "got_top": got.get("top_logprobs"),
+            "ref_greedy": exp.get("greedy_tokens"),
+            "got_greedy": got.get("greedy_tokens"),
+            "ref_greedy_top": exp.get("greedy_top_logprobs"),
+        })
