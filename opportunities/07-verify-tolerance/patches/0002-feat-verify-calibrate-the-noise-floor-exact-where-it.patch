+        tops = p.get("ref_greedy_top")
+        margin = None
+        if tops and first < len(tops):
+            r = _top(tops[first])
+            if len(r) >= 2:
+                margin = r[0][1] - r[1][1]
+        same = sum(1 for x, y in zip(ga, gb) if x == y)
+        if margin is not None and margin <= margin_tau:
+            explained += 1
+            status[p["key"]] = f"tie@{first}"
+            continue
+        bad += 1
+        status[p["key"]] = f"{same}/{max(len(ga), len(gb))}"
+        why = "no margin recorded" if margin is None else f"the reference led by {margin:.3f} > {margin_tau:.3f}"
+        notes.append(
+            f"{p['key']}: greedy continuation diverged at token {first} ({ga[first:first + 1]} vs "
+            f"{gb[first:first + 1]}); {why}"
+        )
+    return bad, explained, notes, status
+
+
+@dataclass
+class RunStats:
+    max_z: float
+    rms_z: float
+    shift: float
+    max_abs_delta: float
+    n_tokens: int
+    flips: int = 0
+    flips_checked: int = 0
+    greedy_bad: int = 0
+    greedy_explained: int = 0
+    bitwise_equal: bool = False
+    worst: List[dict] = field(default_factory=list)
+    notes: List[str] = field(default_factory=list)
+    greedy_status: Dict[str, str] = field(default_factory=dict)
+    per_prompt: Dict[str, dict] = field(default_factory=dict)
+
+    def get(self, name: str) -> float:
+        return getattr(self, name)
+
+
+def run_stats(al: Aligned, scale: float, abs_floor: float, margin_tau: float, top_n: int = 5) -> RunStats:
+    rows = normalized_deltas(al, scale, abs_floor)
+    if not rows:
+        return RunStats(0.0, 0.0, 0.0, 0.0, 0, bitwise_equal=not al.failures)
+    zs = [z for *_, z in rows]
+    max_z = max(abs(z) for z in zs)
+    rms_z = math.sqrt(sum(z * z for z in zs) / len(zs))
+    shift = -sum(zs) / len(zs)
+    max_abs = max(abs(d) for _, _, d, _ in rows)
+    bitwise = all(d == 0.0 for _, _, d, _ in rows)
+    worst = sorted(rows, key=lambda r: -abs(r[3]))[:top_n]
+    tok_of = {p["key"]: p.get("tokens") for p in al.prompts}
+    ref_of = {p["key"]: p["ref"] for p in al.prompts}
+    stats = RunStats(max_z=max_z, rms_z=rms_z, shift=shift, max_abs_delta=max_abs, n_tokens=len(rows),
+                     bitwise_equal=bitwise and not al.failures)
+    for key, pos, d, z in worst:
+        toks = tok_of.get(key)
+        stats.worst.append({"prompt": key, "position": pos, "token": toks[pos] if toks and pos < len(toks) else None,
+                            "ref_logprob": ref_of[key][pos], "delta": d, "z": z})
+    per: Dict[str, dict] = {}
+    for key, _, d, z in rows:
+        e = per.setdefault(key, {"n": 0, "max_abs_delta": 0.0, "max_z": 0.0, "sum_d": 0.0})
+        e["n"] += 1
+        e["max_abs_delta"] = max(e["max_abs_delta"], abs(d))
+        e["max_z"] = max(e["max_z"], abs(z))
+        e["sum_d"] += d
+    stats.per_prompt = {k: {"n": v["n"], "max_abs_delta": v["max_abs_delta"], "max_z": v["max_z"],
+                            "nll_delta": -v["sum_d"] / v["n"]} for k, v in per.items()}
+    stats.flips, stats.flips_checked, fnotes = _flips(al, margin_tau)
+    stats.greedy_bad, stats.greedy_explained, gnotes, stats.greedy_status = _greedy(al, margin_tau)
+    stats.notes = fnotes + gnotes
+    return stats
+
+
+# --------------------------------------------------------------------------
+# calibration
+
+
+@dataclass
+class NoiseModel:
+    scale: float
+    margin_tau: float
+    abs_floor: float
+    alpha: float
+    n_runs: int
+    thresholds: Dict[str, float]
+    null: Dict[str, List[float]]
+    deterministic: bool  # the reference schedule reproduced bitwise
+    batch_invariant: bool  # every perturbed capture reproduced bitwise too
+    max_abs_delta: float
+    warnings: List[str] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        return {
+            "scale": self.scale,
+            "margin_tau": self.margin_tau,
+            "abs_floor": self.abs_floor,
+            "alpha": self.alpha,
+            "n_runs": self.n_runs,
+            "thresholds": self.thresholds,
+            "null": self.null,
+            "deterministic": self.deterministic,
+            "batch_invariant": self.batch_invariant,
+            "calibration_max_abs_delta": self.max_abs_delta,
+            "warnings": self.warnings,
+        }
+
+
+def _bound(xs: List[float], alpha: float, log: bool) -> Tuple[float, Optional[str]]:
+    """Upper (1 - alpha) prediction bound for one more draw like `xs`, never below max(xs)."""
+    top = max(xs)
+    k = len(xs)
+    if k < 3:
+        return FALLBACK_FACTOR * top if top > 0 else 0.0, (
+            f"{k} calibration run(s): thresholds are {FALLBACK_FACTOR:g}x the largest null value, not a "
+            f"prediction bound; use --calibrate 8 or more")
+    if log:
+        if top <= 0:
+            return 0.0, None
+        pos = [x for x in xs if x > 0]
+        if len(pos) < 3:
+            return FALLBACK_FACTOR * top, "too few nonzero calibration statistics for a log-normal bound"
+        ys = [math.log(x) for x in pos]
+    else:
+        ys = list(xs)
+    mean = statistics.fmean(ys)
+    sd = statistics.stdev(ys) if len(ys) > 1 else 0.0
+    t = t_ppf(1.0 - alpha, len(ys) - 1)
+    b = mean + t * sd * math.sqrt(1.0 + 1.0 / len(ys))
+    b = math.exp(b) if log else b
+    return max(b, top), None
+
+
+def fit(reference: dict, calibration: Sequence[dict], alpha: float = 0.01) -> NoiseModel:
+    """The noise model and per-statistic thresholds from calibration captures.
+
+    Captures whose schedule is "repeat" (the reference's own) only probe
+    determinism; the perturbed ones are the null samples.
+    """
+    if not calibration:
+        raise ValueError("no calibration captures; record with --calibrate N")
+    abs_floor = _abs_floor(reference, *calibration)
+    aligned = [align(reference, c) for c in calibration]
+    for c, al in zip(calibration, aligned):
+        if al.failures:
+            raise ValueError(f"calibration capture {c.get('schedule', {})} does not align: {al.failures[0]}")
+        if not all(math.isfinite(v) for p in al.prompts for v in p["ref"] + p["got"]):
+            raise ValueError(f"calibration capture {c.get('schedule', {})} has non-finite logprobs; "
+                             f"a trusted server should not produce those")
+    repeats = [al for c, al in zip(calibration, aligned) if c.get("schedule", {}).get("kind") == "repeat"]
+    perturbed = [al for c, al in zip(calibration, aligned) if c.get("schedule", {}).get("kind") != "repeat"]
+    u_all = [pooled_u(al) for al in aligned]
+    max_abs = max((abs(g - r) for al in aligned for p in al.prompts for r, g in zip(p["ref"], p["got"])), default=0.0)
+    deterministic = bool(repeats) and all(all(x == 0.0 for x in u) for al, u in zip(aligned, u_all) if al in repeats)
+    batch_invariant = bool(perturbed) and all(all(x == 0.0 for x in pooled_u(al)) for al in perturbed)
+    margin_tau = 2.0 * MARGIN_SAFETY * max_abs
+
+    pert_u = [pooled_u(al) for al in perturbed]
+    pooled = [x for u in pert_u for x in u]
+    scale = _quantile(pooled, SCALE_QUANTILE) if pooled else 0.0
+    warnings: List[str] = []
+    null: Dict[str, List[float]] = {s: [] for s in CONTINUOUS}
+    if len(perturbed) >= 2 and scale > 0:
+        for k, al in enumerate(perturbed):
+            others = [x for j, u in enumerate(pert_u) if j != k for x in u]
+            s_k = _quantile(others, SCALE_QUANTILE) or scale
+            st = run_stats(al, s_k, abs_floor, margin_tau)
+            for name in CONTINUOUS:
+                null[name].append(st.get(name))
+    elif perturbed and scale > 0:
+        st = run_stats(perturbed[0], scale, abs_floor, margin_tau)
+        for name in CONTINUOUS:
+            null[name].append(st.get(name))
+
+    thresholds: Dict[str, float] = {}
+    a = alpha / len(CONTINUOUS)
+    for name in CONTINUOUS:
+        xs = null[name]
+        if not xs:
+            thresholds[name] = 0.0
+            continue
+        b, warn = _bound(xs, a, log=(name != "shift"))
+        thresholds[name] = b
+        if warn and warn not in warnings:
+            warnings.append(warn)
+    if not perturbed:
+        warnings.append("no perturbed calibration captures: only exact comparison is possible")
+    return NoiseModel(scale=scale, margin_tau=margin_tau, abs_floor=abs_floor, alpha=alpha,
+                      n_runs=len(perturbed), thresholds=thresholds, null=null, deterministic=deterministic,
+                      batch_invariant=batch_invariant, max_abs_delta=max_abs, warnings=warnings)
+
+
+# --------------------------------------------------------------------------
+# decisions
+
+
+@dataclass
+class Decision:
+    passed: bool
+    mode: str
+    stats: Optional[RunStats]
+    failures: List[str] = field(default_factory=list)
+    info: List[str] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        st = self.stats
+        return {
+            "passed": self.passed,
+            "mode": self.mode,
+            "failures": self.failures,
+            "info": self.info,
+            "stats": None if st is None else {
+                "max_z": st.max_z, "rms_z": st.rms_z, "shift": st.shift, "max_abs_delta": st.max_abs_delta,
+                "n_tokens": st.n_tokens, "flips": st.flips, "flips_checked": st.flips_checked,
+                "greedy_unexplained": st.greedy_bad, "greedy_explained": st.greedy_explained,
+                "bitwise_equal": st.bitwise_equal, "worst_tokens": st.worst, "greedy": st.greedy_status,
+                "per_prompt": st.per_prompt,
+            },
+        }
+
+
+def decide_exact(reference: dict, captured: dict) -> Decision:
+    """Bitwise equality of every logprob and every greedy token."""
+    al = align(reference, captured)
+    st = run_stats(al, 1.0, _abs_floor(reference, captured), 0.0)
+    failures = list(al.failures)
+    # Format-1 references were rounded to 6 decimals: equal means equal once rounded the same way.
+    same = (lambda r, g: round(g, 6) == r) if reference.get("format", 1) < 2 else (lambda r, g: r == g)
+    for p in al.prompts:
+        diff = [i for i, (r, g) in enumerate(zip(p["ref"], p["got"])) if not same(r, g)]
+        if diff:
+            i = max(diff, key=lambda j: abs(p["got"][j] - p["ref"][j]))
+            failures.append(f"{p['key']}: {len(diff)}/{len(p['ref'])} logprobs differ; worst at token {i} by "
+                            f"{p['got'][i] - p['ref'][i]:+.3g}")
+        if p.get("ref_greedy") is not None and p.get("got_greedy") != p.get("ref_greedy"):
+            failures.append(f"{p['key']}: greedy continuation differs")
+    return Decision(passed=not failures, mode="exact", stats=st, failures=failures)
+
+
+def decide_statistical(reference: dict, captured: dict, model: NoiseModel) -> Decision:
+    al = align(reference, captured)
+    st = run_stats(al, model.scale if model.scale > 0 else 1.0, model.abs_floor, model.margin_tau)
+    failures = list(al.failures)
+    info = [f"noise model: scale {model.scale:.3g} x (1 - p), {model.n_runs} perturbed calibration runs, "
+            f"margin_tau {model.margin_tau:.3g}, alpha {model.alpha:g}"]
+    info += model.warnings
+    if model.scale <= 0:
+        # Calibration saw no noise at all: anything else than equality is unexplained.
+        if not st.bitwise_equal:
+            failures.append(f"calibration showed no noise, yet logprobs moved by up to {st.max_abs_delta:.3g}")
+    else:
+        for name in CONTINUOUS:
+            val, thr = st.get(name), model.thresholds.get(name, 0.0)
+            if val > thr:
+                worst = st.worst[0] if st.worst else {}
+                extra = ""
+                if name == "max_z" and worst:
+                    extra = (f" (worst: {worst['prompt']}[{worst['position']}] {worst.get('token')!r}, "
+                             f"delta {worst['delta']:+.4g} from {worst['ref_logprob']:.4g})")
+                failures.append(f"{name} {val:.3g} > calibrated threshold {thr:.3g}{extra}")
+    if st.flips:
+        failures.append(f"{st.flips} top-1 flips at positions whose reference margin exceeds {model.margin_tau:.3g}")
+    if st.greedy_bad:
+        failures.append(f"{st.greedy_bad} greedy continuations diverged where the reference had a clear winner")
+    failures += [n for n in st.notes if n not in failures]
+    if st.greedy_explained:
+        info.append(f"{st.greedy_explained} greedy divergence(s) at near-ties (margin <= {model.margin_tau:.3g}), "
+                    f"explained by noise")
+    return Decision(passed=not failures, mode="statistical", stats=st, failures=failures, info=info)
+
+
+def choose_mode(requested: str, model: Optional[NoiseModel]) -> str:
+    """'auto' is exact where calibration proved the engine deterministic, statistical otherwise."""
+    if requested in ("exact", "statistical", "legacy"):
+        return requested
+    if model is None:
+        return "legacy"
+    return "exact" if model.deterministic else "statistical"
