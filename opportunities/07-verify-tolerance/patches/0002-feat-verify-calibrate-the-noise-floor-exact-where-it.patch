+"""How far may a capture drift from its reference before it is a fault, not noise?
+
+`servekit verify --reference` used to demand |delta logprob| <= 1e-6 per token,
+which is bitwise equality in practice. That holds when the candidate runs the
+same kernels on the same batch shapes as the reference, and fails on a correct
+load whenever it does not: another TP degree, another GPU, a kernel whose
+reduction order depends on the batch, FP4 MoE paths. This module replaces the
+fixed tolerance with one measured on the reference server itself.
+
+Calibration. Next to the reference capture, `--record --calibrate N` takes N
+more captures from the same trusted server while perturbing what a serving
+engine perturbs: concurrency and batch composition, which move split-K and
+split-KV choices, chunked-prefill boundaries and CUDA-graph buckets. Their
+differences from the reference are the noise floor.
+
+Noise model. A token's logprob moves by
+    d log p_y = (1 - p_y) dz_y - sum_{j != y} p_j dz_j
+for logit perturbations dz, so its noise scales with (1 - p_y): near-certain
+tokens barely move, uncertain ones move by about the logit noise. In the
+Llama-3.1-70B TP4-vs-TP8 fixtures |delta|/(1 - p) has the same spread across
+six decades of (1 - p), so one pooled scale s fits every token:
+    z_i = delta_i / sigma_i,   sigma_i = max(s * max(1 - p_i, REL_FLOOR), ABS_FLOOR)
+
+Statistics. Three continuous ones, each with a threshold calibrated at
+alpha/3 (Bonferroni):
+    max_z   the largest |z|: a fault that hits few tokens hard (one MoE expert,
+            one vocab shard, a few flipped exponent bits)
+    rms_z   root-mean-square z: a fault that moves every token a little
+    shift   mean of -z, one-sided: the candidate finds the reference text less
+            likely, which is what damaged weights do on average
+and two rules with no tolerance beyond the noise floor:
+    flips   the candidate's top-1 token differs where the reference's top-1
+            led its runner-up by more than `margin_tau`
+    greedy  a free-running greedy continuation diverges at a step where the
+            reference's margin exceeded `margin_tau`
+`margin_tau` is twice the largest logprob movement seen in calibration (times
+a safety factor): a margin that wide cannot close under that noise.
+
+Thresholds. Each calibration run is scored against the reference like a
+candidate, with the scale estimated from the other runs (leave-one-out), giving
+K null samples per statistic. The threshold is the upper (1 - alpha/3)
+prediction bound of a normal fitted to them (on log scale for max_z and rms_z):
+mean + t_{K-1} * sd * sqrt(1 + 1/K), and never below the largest null sample.
+The false-alarm rate is then alpha for a candidate whose benign variation
+matches the calibration's -- the assumption to check, and what the Modal
+study measures for restarts, other TP degrees and other kernels.
+
+Exact mode. If a repeat capture with the reference's own schedule is bitwise
+identical, the engine is deterministic for this setup and nothing but equality
+is needed or accepted; if the perturbed captures are identical too, the engine
+is batch-invariant (SGLang --enable-deterministic-inference, vLLM
+VLLM_BATCH_INVARIANT=1) and verify can run on a loaded server.
+
+Stdlib only, like the rest of verify.
+"""
+from __future__ import annotations
+
+import math
+import statistics
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Sequence, Tuple
+
+REL_FLOOR = 1e-4  # (1 - p) below this counts as this: float32 logprobs near 0 carry ~1e-7 absolute error
+ABS_FLOOR = 1e-6  # the rounding of format-1 references
+SCALE_QUANTILE = 0.9
+MARGIN_SAFETY = 1.5
+FALLBACK_FACTOR = 2.0  # thresholds from fewer than 3 calibration runs: this x the largest null sample
+CONTINUOUS = ("max_z", "rms_z", "shift")
+
+
+# --------------------------------------------------------------------------
+# Student-t quantile, for prediction bounds from a handful of runs
+
+
+def _betacf(a: float, b: float, x: float) -> float:
+    fpmin = 1e-300
+    qab, qap, qam = a + b, a + 1.0, a - 1.0
+    c, d = 1.0, 1.0 - qab * x / qap
+    d = 1.0 / (d if abs(d) > fpmin else fpmin)
+    h = d
+    for m in range(1, 400):
+        m2 = 2 * m
+        aa = m * (b - m) * x / ((qam + m2) * (a + m2))
+        d = 1.0 + aa * d
+        d = 1.0 / (d if abs(d) > fpmin else fpmin)
+        c = 1.0 + aa / c
+        c = c if abs(c) > fpmin else fpmin
+        h *= d * c
+        aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2))
+        d = 1.0 + aa * d
+        d = 1.0 / (d if abs(d) > fpmin else fpmin)
+        c = 1.0 + aa / c
+        c = c if abs(c) > fpmin else fpmin
+        de = d * c
+        h *= de
+        if abs(de - 1.0) < 1e-15:
+            break
+    return h
+
+
+def _betainc(a: float, b: float, x: float) -> float:
+    """Regularized incomplete beta I_x(a, b)."""
+    if x <= 0.0:
+        return 0.0
+    if x >= 1.0:
+        return 1.0
+    lbt = math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b) + a * math.log(x) + b * math.log1p(-x)
+    if x < (a + 1.0) / (a + b + 2.0):
+        return math.exp(lbt) * _betacf(a, b, x) / a
+    return 1.0 - math.exp(lbt) * _betacf(b, a, 1.0 - x) / b
+
+
+def t_cdf(t: float, df: float) -> float:
+    x = df / (df + t * t)
+    tail = 0.5 * _betainc(df / 2.0, 0.5, x)
+    return 1.0 - tail if t >= 0 else tail
+
+
+def t_ppf(p: float, df: float) -> float:
+    """Quantile of Student's t with `df` degrees of freedom, by bisection on the CDF."""
+    if not 0.0 < p < 1.0:
+        raise ValueError(f"p={p} outside (0, 1)")
+    if p < 0.5:
+        return -t_ppf(1.0 - p, df)
+    lo, hi = 0.0, 1.0
+    while t_cdf(hi, df) < p:
+        hi *= 2.0
+    for _ in range(200):
+        mid = 0.5 * (lo + hi)
+        if t_cdf(mid, df) < p:
+            lo = mid
+        else:
+            hi = mid
+    return 0.5 * (lo + hi)
+
