+"""Tests for the calibrated verify statistics, on synthetic captures with known noise."""
+import json
+import math
+import random
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from servekit import verify_stats as vs
+from servekit.cli import main
+from servekit.verify import check, compare_weights
+
+from test_bench import _start_server
+
+LENGTHS = {"a": 40, "b": 120, "c": 25, "d": 300}
+
+
+def _ref(seed=0, n_greedy=8):
+    rng = random.Random(seed)
+    prompts = []
+    for key, n in LENGTHS.items():
+        lps = []
+        for _ in range(n):
+            u = rng.random()
+            lps.append(-rng.expovariate(1 / 1e-3) if u < 0.5 else -rng.expovariate(1 / 2.5))
+        tops = []
+        for lp in lps:
+            best = max(lp, -rng.expovariate(1.0))
+            tops.append([["best", best], ["second", best - rng.choice([0.0, 0.01, 0.5, 3.0, 8.0])]])
+        greedy_top = [[["g%d" % i, -0.1], ["alt", -0.1 - m]] for i, m in enumerate([5.0] * 10 + [0.001] + [5.0] * 5)]
+        prompts.append({"key": key, "n_tokens": n, "tokens": ["t%d" % i for i in range(n)], "token_logprobs": lps,
+                        "top_logprobs": tops, "greedy_tokens": ["g%d" % i for i in range(16)],
+                        "greedy_top_logprobs": greedy_top})
+    return {"format": 2, "model": "m", "prompts": prompts, "schedule": {"kind": "reference"}}
+
+
+def _noisy(ref, seed, s=0.05, kind="perturbed"):
+    """A capture whose logprobs move by s * (1 - p) * (student-t noise): the model the stats assume."""
+    rng = random.Random(seed)
+    cap = json.loads(json.dumps(ref))
+    cap["schedule"] = {"kind": kind, "seed": seed}
+    for p in cap["prompts"]:
+        new = []
+        for lp in p["token_logprobs"]:
+            t = rng.gauss(0, 1) / math.sqrt(max(rng.gammavariate(2.5, 1 / 2.5), 1e-3))
+            new.append(min(0.0, lp + s * (-math.expm1(lp)) * t))
+        p["token_logprobs"] = new
+    return cap
+
+
+def _model(ref, k=8, alpha=0.01, s=0.05):
+    calib = [_noisy(ref, 0, s=0.0, kind="repeat")] + [_noisy(ref, 100 + i, s=s) for i in range(k)]
+    return vs.fit(ref, calib, alpha=alpha)
+
+
+@pytest.mark.parametrize("p,df,expect", [(0.975, 5, 2.570582), (0.999, 9, 4.296806), (0.995, 19, 2.860935),
+                                         (0.99, 1, 31.820516), (0.9, 100, 1.290075)])
+def test_t_ppf_matches_tables(p, df, expect):
+    assert vs.t_ppf(p, df) == pytest.approx(expect, rel=1e-5)
+    assert vs.t_ppf(1 - p, df) == pytest.approx(-expect, rel=1e-5)
+
+
+def test_fit_reports_determinism_and_scale():
+    ref = _ref()
+    m = _model(ref)
+    assert m.deterministic and not m.batch_invariant
+    assert m.n_runs == 8
+    assert 0.0 < m.scale < 0.5
+    assert set(m.thresholds) == set(vs.CONTINUOUS)
+    for name in vs.CONTINUOUS:
+        assert m.thresholds[name] >= max(m.null[name])
+
+
+def test_false_alarm_rate_is_near_alpha_on_held_out_benign_runs():
+    ref = _ref()
+    m = _model(ref, k=16, alpha=0.05)
+    alarms = sum(not vs.decide_statistical(ref, _noisy(ref, 1000 + i), m).passed for i in range(200))
+    assert alarms / 200 <= 0.10  # nominal 0.05; the bound is conservative but K=16 is small
+
+
+def test_identical_capture_passes_every_mode():
+    ref = _ref()
+    m = _model(ref)
+    same = json.loads(json.dumps(ref))
+    assert vs.decide_statistical(ref, same, m).passed
+    assert vs.decide_exact(ref, same).passed
+
+
+def test_a_few_hard_hit_tokens_fail_max_z():
+    ref = _ref()
+    m = _model(ref)
+    bad = _noisy(ref, 7)
+    for i in (3, 50, 77):
+        bad["prompts"][1]["token_logprobs"][i] -= 2.0
+    d = vs.decide_statistical(ref, bad, m)
+    assert not d.passed
+    assert any(f.startswith("max_z") and "b[" in f for f in d.failures)
+
+
+def test_a_small_consistent_drift_fails_shift_but_not_max_z():
+    ref = _ref()
+    m = _model(ref)
+    bad = _noisy(ref, 8)
+    for p in bad["prompts"]:
+        p["token_logprobs"] = [lp - 0.4 * m.scale * max(-math.expm1(lp), vs.REL_FLOOR) for lp in p["token_logprobs"]]
+    d = vs.decide_statistical(ref, bad, m)
+    assert not d.passed
+    assert any(f.startswith("shift") for f in d.failures)
+    assert not any(f.startswith("max_z") for f in d.failures)
+
+
+def test_greedy_divergence_at_a_near_tie_is_explained_and_at_a_clear_winner_is_not():
+    ref = _ref()
+    m = _model(ref)
+    tie = json.loads(json.dumps(ref))
+    tie["prompts"][0]["greedy_tokens"] = tie["prompts"][0]["greedy_tokens"][:10] + ["alt"] + ["x"] * 5
+    d = vs.decide_statistical(ref, tie, m)
+    assert d.passed and d.stats.greedy_explained == 1
+    clear = json.loads(json.dumps(ref))
+    clear["prompts"][0]["greedy_tokens"] = clear["prompts"][0]["greedy_tokens"][:4] + ["alt"] * 12
+    d = vs.decide_statistical(ref, clear, m)
+    assert not d.passed and any("greedy continuation diverged at token 4" in f for f in d.failures)
+
+
+def test_top1_flip_only_counts_at_clear_winners():
+    ref = _ref()
+    m = _model(ref)
+    cap = json.loads(json.dumps(ref))
+    tops = ref["prompts"][3]["top_logprobs"]
+    clear = next(i for i, t in enumerate(tops) if t[0][1] - t[1][1] > m.margin_tau)
+    near = next(i for i, t in enumerate(tops) if t[0][1] - t[1][1] == 0.01)
+    for i in (near,):
+        cap["prompts"][3]["top_logprobs"][i] = [["second", -0.1], ["best", -0.11]]
+    assert vs.decide_statistical(ref, cap, m).passed
+    cap["prompts"][3]["top_logprobs"][clear] = [["second", -0.1], ["best", -0.2]]
+    d = vs.decide_statistical(ref, cap, m)
+    assert not d.passed and d.stats.flips == 1
+
+
+def test_non_finite_logprobs_fail():
+    ref = _ref()
+    m = _model(ref)
+    bad = json.loads(json.dumps(ref))
+    bad["prompts"][2]["token_logprobs"][5] = float("nan")
