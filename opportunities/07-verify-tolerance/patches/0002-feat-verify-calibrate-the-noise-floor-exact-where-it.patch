+            best = g[0][1]
+            leaders = {t for t, v in g if v >= best}
+            if r[0][0] not in leaders:
+                bad += 1
+                if len(notes) < 5:
+                    notes.append(f"{p['key']}[{i}]: top-1 {g[0][0]!r} replaced {r[0][0]!r}, which led by {margin:.3f}")
