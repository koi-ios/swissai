+
+
+def _one_minus_p(lp: float) -> float:
+    return -math.expm1(min(lp, 0.0))
+
+
+def _abs_floor(*captures: dict) -> float:
+    # format-1 captures were rounded to 6 decimals; format 2 keeps full precision
+    return ABS_FLOOR if any(c.get("format", 1) < 2 for c in captures) else ABS_FLOOR / 10
+
+
+def normalized_deltas(al: Aligned, scale: float, abs_floor: float) -> List[Tuple[str, int, float, float]]:
+    """[(prompt key, position, delta, z)] for every token.
+
+    A NaN or infinite logprob is a model that lost the token entirely: it
+    counts as an infinite drop, so every statistic sees it.
+    """
+    out = []
+    for p in al.prompts:
+        for i, (r, g) in enumerate(zip(p["ref"], p["got"])):
+            if not (math.isfinite(g) and math.isfinite(r)):
+                out.append((p["key"], i, -math.inf, -math.inf))
+                continue
+            d = g - r
+            sigma = max(scale * max(_one_minus_p(r), REL_FLOOR), abs_floor)
+            out.append((p["key"], i, d, d / sigma))
+    return out
+
+
+def pooled_u(al: Aligned) -> List[float]:
+    """|delta| / max(1 - p, REL_FLOOR) for every token: the unscaled noise."""
+    return [abs(g - r) / max(_one_minus_p(r), REL_FLOOR) for p in al.prompts for r, g in zip(p["ref"], p["got"])]
+
+
+def _quantile(xs: Sequence[float], q: float) -> float:
+    xs = sorted(xs)
+    if not xs:
+        return 0.0
+    pos = q * (len(xs) - 1)
+    lo, hi = int(math.floor(pos)), int(math.ceil(pos))
+    return xs[lo] + (xs[hi] - xs[lo]) * (pos - lo)
+
+
+# --------------------------------------------------------------------------
+# statistics of one capture
+
+
+def _flips(al: Aligned, margin_tau: float) -> Tuple[int, int, List[str]]:
+    """(unexplained top-1 flips, positions checked, descriptions)."""
