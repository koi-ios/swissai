+
+
+def _greedy(al: Aligned, margin_tau: float) -> Tuple[int, int, List[str], Dict[str, str]]:
+    """(unexplained divergences, explained ones, descriptions, per-prompt status)."""
+    bad, explained, notes, status = 0, 0, [], {}
