+    bad["prompts"][2]["token_logprobs"][5] = float("-inf")
+    assert not vs.decide_statistical(ref, bad, m).passed
+
+
+def test_batch_invariant_calibration_means_exact():
+    ref = _ref()
+    calib = [_noisy(ref, 0, s=0.0, kind="repeat")] + [_noisy(ref, i, s=0.0) for i in range(4)]
+    m = vs.fit(ref, calib)
