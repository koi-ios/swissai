+class _Fillers:
+    """Background requests that keep a server's batches mixed while a capture runs.
+
+    What a serving engine computes for one request depends on what else is in
+    its batch: GEMM split-K and attention split-KV choices, chunked-prefill
+    boundaries, CUDA-graph buckets. Fillers of random lengths make those vary
+    the way production load does. Their own results are thrown away, and a
+    failed filler is not an error.
+    """
+
+    def __init__(self, base_url: str, model: str, n: int, seed: int, timeout: float):
+        self.base_url, self.model, self.n, self.seed, self.timeout = base_url, model, n, seed, timeout
+        self.stop = threading.Event()
+        self.threads: List[threading.Thread] = []
+
+    def _loop(self, idx: int) -> None:
+        rng = Random(self.seed * 1009 + idx)
+        while not self.stop.is_set():
+            words = rng.choice((8, 24, 64, 160, 400, 900))
+            prompt = " ".join(rng.choice(_VOCAB) for _ in range(words))
+            try:
+                _completions(self.base_url, self.model, prompt,
+                             {"max_tokens": rng.randint(1, 48), "temperature": 0.0}, self.timeout)
+            except Exception:  # noqa: BLE001 -- load generator, best effort
+                pass
+
+    def __enter__(self):
+        for i in range(self.n):
+            t = threading.Thread(target=self._loop, args=(i,), daemon=True)
+            t.start()
+            self.threads.append(t)
+        return self
+
+    def __exit__(self, *exc):
+        self.stop.set()
+        for t in self.threads:
+            t.join(timeout=self.timeout)
+
+
+# (concurrency of the probed requests, filler threads), cycled over calibration runs
