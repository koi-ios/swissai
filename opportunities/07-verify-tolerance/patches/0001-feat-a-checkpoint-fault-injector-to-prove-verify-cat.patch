+    for mode, expect in (("roll", None), ("ones", np.ones((1, 2))), ("factor", np.array([[2e-3, 4e-3]]))):
+        t = _load(ckpt)
+        faults.apply(t, FaultSpec(kind="scale_blocks", mode=mode, match=r"scale_inv$", dim=1, factor=2.0))
