+@pytest.mark.parametrize("bit,pos", [("exp_msb", 14), ("exp_lsb", 7), ("mant_msb", 6), ("sign", 15)])
+def test_bitflip_flips_exactly_n_bits(ckpt, bit, pos):
+    t = _load(ckpt)
+    name = "model.layers.0.self_attn.q_proj.weight"
+    old = t[name].data.copy()
+    rep = faults.apply(t, FaultSpec(kind="bitflip", match=r"q_proj", bit=bit, n=7, seed=3))
