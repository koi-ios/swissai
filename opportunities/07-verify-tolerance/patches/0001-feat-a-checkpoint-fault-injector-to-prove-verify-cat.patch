+def test_validate_agrees_with_inject_without_reading_data(ckpt, tmp_path):
+    meta = {n: (d, s) for n, (_, d, s) in faults.tensor_index(ckpt).items()}
+    specs = [
+        FaultSpec(kind="zero_slice", match=r"(q|k)_proj", count=0, tp=4, shard=1),
+        FaultSpec(kind="bitflip", match=r"router", n=1, bit="exp_lsb"),
+        FaultSpec(kind="swap_experts", match=r"layers\.3\.mlp\.experts", experts=(0, 2)),
+        FaultSpec(kind="mxfp4_scales", mode="shift", match=r"up_proj\.weight_scales$"),
+    ]
+    for i, spec in enumerate(specs):
+        touched = faults.validate(spec, meta)
+        rep = faults.inject(ckpt, tmp_path / f"v{i}", spec)
+        assert sorted(touched) == sorted({c.name for c in rep.changes} | set(rep.dropped))
+    with pytest.raises(ValueError, match="square"):
+        faults.validate(FaultSpec(kind="transpose", match=r"q_proj", tp=4), meta)
+    with pytest.raises(ValueError, match="split"):
+        faults.validate(FaultSpec(kind="zero_slice", match=r"k_proj", tp=3), meta)
+    with pytest.raises(ValueError, match="E8M0"):
+        faults.validate(FaultSpec(kind="mxfp4_scales", match=r"q_proj"), meta)
