+def test_prune_keeps_the_newest_namespaces_and_always_this_one(tmp_path, monkeypatch):
+    artifact = tmp_path / "a"
+    keys = [_key(packages={"sglang": f"0.5.{v}"}) for v in (16, 17, 18, 19)]
+    clock = iter(range(100, 200))
+    monkeypatch.setattr(jit_cache.time, "time", lambda: next(clock))
+    for key in keys:
+        jit_cache.persist(_build(tmp_path / key.name, {"triton/k": b"k"}), artifact, key, keep=10)
+    _build(artifact / jit_cache.CACHE_DIR_NAME, {"triton/legacy.cubin": b"old"})
+
+    removed = jit_cache.prune(artifact, keep=2, current=keys[0])
+
+    left = sorted(p.name for p in (artifact / jit_cache.CACHE_DIR_NAME).iterdir())
+    assert left == sorted([keys[0].name, keys[2].name, keys[3].name])
+    assert keys[1].name in removed and any("unkeyed" in r for r in removed)
+
