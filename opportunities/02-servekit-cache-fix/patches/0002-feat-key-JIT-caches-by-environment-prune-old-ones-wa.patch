+
+# --- the validity key -----------------------------------------------------------
+
+# Packages whose version decides whether a compiled kernel still applies. Absent
+# ones are left out, so one list serves every image.
+KEY_PACKAGES = (
+    "sglang", "sglang-kernel", "sgl-kernel", "vllm", "torch", "triton", "apache-tvm-ffi",
+    "flashinfer-python", "flashinfer-cubin", "flashinfer-jit-cache", "nvidia-cutlass-dsl",
+    "flash-attn-4", "quack-kernels", "sgl-deep-gemm", "deep-gemm", "nvidia-mathdx", "tilelang",
+)
+
+# The upstream sglang images set these (docker/Dockerfile): free precision when present.
+_IMAGE_VARS = ("SGLANG_IMAGE_TAG", "SGLANG_BUILD_COMMIT")
+
+# Fallback when nvidia-smi is missing; run in a child so servekit's own process
+# never initializes CUDA. 75/76: CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR/MINOR.
+_LIBCUDA_PROBE = """
+import ctypes, sys
+cuda = ctypes.CDLL("libcuda.so.1")
+n = ctypes.c_int()
+if cuda.cuInit(0) or cuda.cuDeviceGetCount(ctypes.byref(n)):
+    sys.exit(1)
+for i in range(n.value):
+    dev, major, minor = ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
+    if not cuda.cuDeviceGet(ctypes.byref(dev), i):
+        cuda.cuDeviceGetAttribute(ctypes.byref(major), 75, dev)
+        cuda.cuDeviceGetAttribute(ctypes.byref(minor), 76, dev)
+        print(f"{major.value}.{minor.value}")
+"""
+
+
+@dataclass(frozen=True)
+class CacheKey:
+    """What a compiled cache is valid for, and the namespace it is kept under."""
+
+    material: Mapping[str, object]
+
+    @property
+    def name(self) -> str:
+        """Readable first, exact last: sglang-0.5.20-sm90-aarch64-<sha256[:12]>."""
+        m = self.material
+        engine = str(m.get("engine"))
+        version = m.get("packages", {}).get(engine, "unknown")
+        gpu = "+".join("sm" + cap.replace(".", "") for cap in m.get("gpu") or []) or "nogpu"
+        digest = hashlib.sha256(json.dumps(m, sort_keys=True).encode()).hexdigest()[:12]
+        return "-".join(re.sub(r"[^\w.+]", "_", str(p)) for p in (engine, version, gpu, m.get("cpu"), digest))
+
+    def summary(self) -> str:
+        m = self.material
+        pkgs = m.get("packages", {})
+        shown = [f"{p} {pkgs[p]}" for p in ("sglang", "vllm", "torch", "flashinfer-python") if p in pkgs]
+        return ", ".join(shown + [f"GPU {','.join(m.get('gpu') or ['none'])}", f"{m.get('cpu')}"])
+
+
+def gpu_capabilities() -> Tuple[str, ...]:
+    """Compute capabilities of this node's GPUs, e.g. ("9.0",); empty if unreadable.
+
+    Never imports torch, which alone costs seconds.
+    """
+    probes = [[sys.executable, "-I", "-c", _LIBCUDA_PROBE]]
+    smi = shutil.which("nvidia-smi")
+    if smi:
+        probes.insert(0, [smi, "--query-gpu=compute_cap", "--format=csv,noheader"])
+    for probe in probes:
+        try:
+            out = subprocess.run(probe, capture_output=True, text=True, timeout=60)
+        except (OSError, subprocess.SubprocessError):
+            continue
+        caps = {line.strip() for line in out.stdout.splitlines() if re.fullmatch(r"\d+\.\d+", line.strip())}
+        if out.returncode == 0 and caps:
+            return tuple(sorted(caps))
+    return ()
+
+
+def _package_versions() -> Dict[str, str]:
+    versions = {}
+    for name in KEY_PACKAGES:
+        try:
+            versions[name] = metadata.version(name)
+        except metadata.PackageNotFoundError:
+            continue
+    return versions
+
+
+def _cuda_toolkit(environ: Mapping[str, str]) -> Optional[str]:
+    """The toolkit nvcc builds with, off its version.json: a file read, not a subprocess."""
+    for home in (environ.get("CUDA_HOME"), environ.get("CUDA_PATH"), "/usr/local/cuda"):
+        try:
+            return str(json.loads((Path(home) / "version.json").read_text())["cuda"]["version"])
+        except (TypeError, OSError, ValueError, KeyError):
+            continue
+    return None
+
+
+def validity_key(engine: str, environ: Optional[Mapping[str, str]] = None) -> CacheKey:
+    """The key this environment's compiled caches are valid under.
+
+    Cheap enough for every launch: package metadata, one nvidia-smi query, a
+    file read. Imports no engine.
+    """
+    environ = os.environ if environ is None else environ
+    material: Dict[str, object] = {
+        "layout": LAYOUT_VERSION,
+        "engine": engine,
+        "packages": _package_versions(),
+        "gpu": list(gpu_capabilities()),
+        "cpu": platform.machine(),
+        "python": "%d.%d" % sys.version_info[:2],
+        "cuda": _cuda_toolkit(environ),
+        "image": {var: environ[var] for var in _IMAGE_VARS if environ.get(var)},
+    }
+    return CacheKey(material)
+
+
+def key_differences(ours: Mapping[str, object], theirs: Mapping[str, object]) -> List[str]:
+    """What separates two keys, in words, the engine's own version first: why
+    another environment's caches were not staged."""
+    a, b = theirs.get("packages") or {}, ours.get("packages") or {}
+    engine = str(ours.get("engine"))
+    packages = sorted(set(a) | set(b), key=lambda p: (p != engine, p))
+    diffs = [f"{p} {a.get(p, 'absent')} -> {b.get(p, 'absent')}" for p in packages if a.get(p) != b.get(p)]
+    for name in ("gpu", "cpu", "python", "cuda", "image", "engine", "layout"):
+        if theirs.get(name) != ours.get(name):
+            diffs.append(f"{name} {theirs.get(name)} -> {ours.get(name)}")
+    return diffs
+
+
+# --- namespaces in the artifact -------------------------------------------------
+
+@dataclass
+class Namespace:
+    path: Path
+    material: Optional[Mapping[str, object]]  # None: the unkeyed layout from before keys
+    created: float
+
+    @property
+    def legacy(self) -> bool:
+        return self.material is None
+
+
+def namespaces(artifact: Path) -> List[Namespace]:
+    """The artifact's caches, newest first; the unkeyed layout, if any, last."""
+    root = Path(artifact) / CACHE_DIR_NAME
+    found: List[Namespace] = []
+    if not root.is_dir():
+        return found
+    for entry in root.iterdir():
+        if entry.name.startswith(".") or not (entry / KEY_FILE).is_file():
+            continue
+        try:
+            data = json.loads((entry / KEY_FILE).read_text())
+            found.append(Namespace(entry, data["material"], float(data["created"])))
+        except (OSError, ValueError, KeyError, TypeError):
+            continue
+    found.sort(key=lambda ns: ns.created, reverse=True)
+    if any((root / sub).is_dir() for sub in _LEGACY_SUBDIRS):
+        found.append(Namespace(root, None, 0.0))
+    return found
+
+
+def has_namespace(artifact: Path, key: CacheKey) -> bool:
+    return (Path(artifact) / CACHE_DIR_NAME / key.name / KEY_FILE).is_file()
+
+
+@dataclass
+class Staged:
+    source: str  # "namespace", "legacy" or "none"
+    root: Path  # node-local directory every cache variable points under
+    env: Dict[str, str]
+    left_alone: Dict[str, str]
+    others: List[Namespace] = field(default_factory=list)
+    files: int = 0
+    error: Optional[str] = None
+
+
+def stage(artifact: Path, cache_root: Path, key: CacheKey, environ: Optional[Mapping[str, str]] = None) -> Staged:
+    """Give the engine a node-local, writable copy of the artifact's caches for `key`.
+
+    The copy, not the artifact, is what the engine writes to, so a read-only
+    artifact serves and concurrent jobs share nothing. With no namespace for
+    this key, an artifact from before keys is staged the way it always was (its
+    kernels' own hashes still decide what is reused). With neither, the engine
+    JITs from cold into the same node-local directory, where a later
+    --only-prepare can see it.
+    """
+    environ = os.environ if environ is None else environ
+    artifact = Path(artifact)
+    base = node_local(cache_root, artifact.name)
+    present = namespaces(artifact)
+    ours = artifact / CACHE_DIR_NAME / key.name
+    staged = Staged(
+        source="none", root=base / key.name, env={}, left_alone=left_to_environment(environ),
+        others=[ns for ns in present if ns.path != ours],
+    )
+    copy = dict(symlinks=True, dirs_exist_ok=True, copy_function=_copy_atomically)
+    try:
+        if has_namespace(artifact, key):
+            staged.source = "namespace"
+            shutil.copytree(ours, staged.root, ignore=shutil.ignore_patterns(KEY_FILE), **copy)
+        elif any(ns.legacy for ns in present):
+            # Only the directories it ever had: namespaces of other
+            # environments sit beside them and are not ours to stage.
+            staged.source, staged.root = "legacy", base
+            for sub in _LEGACY_SUBDIRS:
+                if (ours.parent / sub).is_dir():
+                    shutil.copytree(ours.parent / sub, base / sub, **copy)
+    except (OSError, shutil.Error) as e:
+        # A prune racing the copy, or /tmp filling up. Every file that made it
+        # is whole, and each cache rebuilds what it is missing: slower, not wrong.
+        staged.error = str(e)
+    if staged.source != "none":
+        staged.files = sum(1 for p in staged.root.rglob("*") if p.is_file())
+    staged.env = create(staged.root, environ)
+    return staged
+
+
+def _copy_atomically(src: str, dst: str) -> str:
+    """copy2, except that a copy cut short never leaves a truncated file under a cache's name."""
+    tmp = f"{dst}.servekit-{uuid.uuid4().hex[:8]}"
+    shutil.copy2(src, tmp)
+    os.replace(tmp, dst)
+    return dst
+
+
+def _copy_persistable(src: Path, dest: Path) -> int:
+    n = 0
+    for directory, dirnames, filenames in os.walk(src):
+        links = [d for d in dirnames if os.path.islink(os.path.join(directory, d))]
+        for name in filenames + links:
+            path = Path(directory) / name
+            rel = path.relative_to(src).as_posix()
+            if _NOT_PERSISTED.search(rel):
+                continue
+            target = dest / rel
+            target.parent.mkdir(parents=True, exist_ok=True)
+            if path.is_symlink():
+                os.symlink(os.readlink(path), target)
+            else:
+                shutil.copy2(path, target)
+            n += 1
+    return n
+
+
+def persist(build_root: Path, artifact: Path, key: CacheKey, keep: int = DEFAULT_KEEP) -> Tuple[Path, int, List[str]]:
+    """Publish `build_root` as the artifact's namespace for `key`, then prune.
+
+    Only after the engine that filled `build_root` has exited, so no file is
+    copied mid-write. Readers never see a half-written namespace: it is copied
+    beside the others and renamed into place, and one it replaces is renamed
+    away before it is deleted.
+
+    Returns (the namespace, files kept, namespaces pruned).
+    """
