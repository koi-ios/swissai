+
+    staged = jit_cache.stage(artifact, tmp_path / "node", _key(), environ={})
+
+    # The path it was built at, which ninja and Triton's group files baked in.
+    assert staged.source == "legacy" and staged.root == tmp_path / "node" / artifact.name
+    assert (staged.root / "triton/k.cubin").read_bytes() == b"cubin"
+    assert staged.env == jit_cache.env_for(staged.root)
+
+
+def test_a_stage_cut_short_leaves_whole_files_only(tmp_path, monkeypatch):
+    artifact = tmp_path / "llama70b-tp4"
+    jit_cache.persist(_build(tmp_path / "b", {"triton/a.cubin": b"a" * 10, "triton/b.cubin": b"b" * 10}), artifact, _key())
+    copy2 = jit_cache.shutil.copy2
+
+    def full_disk(src, dst, **kwargs):
+        if src.endswith("b.cubin"):
+            Path(dst).write_bytes(b"b" * 3)
+            raise OSError(28, "No space left on device")
+        return copy2(src, dst, **kwargs)
+
+    monkeypatch.setattr(jit_cache.shutil, "copy2", full_disk)
+    staged = jit_cache.stage(artifact, tmp_path / "node", _key(), environ={})
+
+    assert "No space left" in staged.error
+    assert (staged.root / "triton" / "a.cubin").read_bytes() == b"a" * 10
+    assert not (staged.root / "triton" / "b.cubin").exists()
+    assert staged.env == jit_cache.env_for(staged.root)
+
