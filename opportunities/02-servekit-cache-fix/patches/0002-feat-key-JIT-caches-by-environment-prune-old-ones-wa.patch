+# --- namespaces: stage, persist, prune ---------------------------------------------------------------
+
+
+def _build(root: Path, files: dict) -> Path:
+    for rel, data in files.items():
+        (root / rel).parent.mkdir(parents=True, exist_ok=True)
+        (root / rel).write_bytes(data)
+    return root
+
+
+def test_a_namespace_is_staged_only_into_the_environment_that_built_it(tmp_path):
+    artifact = tmp_path / "llama70b-tp4"
+    jit_cache.persist(_build(tmp_path / "b", {"sglang-jit/sm90/m.so": b"so"}), artifact, _key())
+
+    hit = jit_cache.stage(artifact, tmp_path / "node", _key(), environ={})
+    other = _key(packages={"sglang": "0.5.21"})
+    miss = jit_cache.stage(artifact, tmp_path / "node", other, environ={})
+
+    assert hit.source == "namespace" and hit.root == tmp_path / "node" / artifact.name / _key().name
+    assert (hit.root / "sglang-jit/sm90/m.so").read_bytes() == b"so"
+    assert not (hit.root / jit_cache.KEY_FILE).exists()
+    assert hit.env == jit_cache.env_for(hit.root)
+    assert miss.source == "none" and miss.files == 0
+    assert miss.root == tmp_path / "node" / artifact.name / other.name
+    assert [ns.path.name for ns in miss.others] == [_key().name]
+
+
+def test_an_artifact_from_before_keys_is_staged_the_way_it_always_was(tmp_path):
+    artifact = tmp_path / "llama70b-tp4"
