+        "sglang-jit/sm90/m/build-1/.staging-ab12/m.so": b"half",
+        "sglang-jit/sm90/m/build-1/deps-2/m.so": b"so",
+        "sglang-jit/sm90/m/build-1/.lock": b"x",
+        "triton/KEY/tmp.pid_7_ab/k.cubin": b"half",
+        "triton/KEY/k.cubin": b"cubin",
+        "tilelang/tmp/k.cu": b"src",
+    })
+
+    namespace, n, _ = jit_cache.persist(build, tmp_path / "a", _key())
+
+    kept = sorted(p.relative_to(namespace).as_posix() for p in namespace.rglob("*") if p.is_file())
+    assert kept == [jit_cache.KEY_FILE, "sglang-jit/sm90/m/build-1/deps-2/m.so", "triton/KEY/k.cubin"]
