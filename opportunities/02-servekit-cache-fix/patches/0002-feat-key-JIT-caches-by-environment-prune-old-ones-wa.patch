+# --- --only-prepare builds a new environment's caches without re-sharding ---------------------------
+
+FAKE_WARMUP = '''
+import json, os, sys
+from pathlib import Path
+json.dump(sys.argv[1:], open(os.environ["CALLS"] + f".{len(os.listdir(os.path.dirname(os.environ['CALLS'])))}", "w"))
+leaf = Path(os.environ["SGLANG_JIT_CACHE_DIR"]) / "sm90" / "comm" / "build-0" / "deps-0"
+leaf.mkdir(parents=True, exist_ok=True)
+(leaf / "comm.so").write_bytes(b"so")
+'''
+
+
+@pytest.fixture
+def prepared(tmp_path, monkeypatch):
+    model = tmp_path / "Llama-3.1-70B-Instruct"
+    model.mkdir()
+    artifact = tmp_path / "llama70b-tp4"
+    artifact.mkdir()
+    (artifact / "config.json").write_text("{}")
+    (artifact / "model-rank-0-part-0.safetensors").write_bytes(b"weights")
+    Manifest(
+        format="sharded_state", engine="sglang", engine_version="0.5.16", tp_size=1, pp_size=1,
+        dp_size=1, dtype="bfloat16", quantization=None, source=str(model),
+    ).write(artifact)
+    # Caches from the image before the upgrade.
+    jit_cache.persist(_build(tmp_path / "old", {"tvm-ffi/m.so": b"so"}), artifact, _key(packages={"sglang": "0.5.16"}))
+
+    script = tmp_path / "fake_warmup.py"
+    script.write_text(FAKE_WARMUP)
+    (tmp_path / "calls").mkdir()
+    monkeypatch.setenv("CALLS", str(tmp_path / "calls" / "call"))
+    monkeypatch.setattr("servekit.prepare.SAVE_SCRIPT", script)
+    monkeypatch.setattr("servekit.launch.DEFAULT_CACHE_ROOT", tmp_path / "node-local")
+    return model, artifact
+
+
+def _only_prepare(model, artifact):
+    return main([
+        "launch", "--servekit-artifact-path", str(artifact), "--only-prepare",
+        "--", "python", "-m", "sglang.launch_server", "--model-path", str(model),
+    ])
+
+
+def test_only_prepare_builds_this_environments_caches_without_resharding(tmp_path, prepared):
+    model, artifact = prepared
+    weights = (artifact / "model-rank-0-part-0.safetensors").stat()
+
+    assert _only_prepare(model, artifact) == 0
+
+    key = jit_cache.validity_key("sglang")
+    argv = json.loads(next((tmp_path / "calls").iterdir()).read_text())
+    assert "--servekit-warm-only" in argv
+    assert argv[-4:] == ["--model-path", str(artifact), "--load-format", "sharded_state"]
+    assert (artifact / jit_cache.CACHE_DIR_NAME / key.name / "sglang-jit/sm90/comm/build-0/deps-0/comm.so").is_file()
+    assert (artifact / "model-rank-0-part-0.safetensors").stat().st_mtime_ns == weights.st_mtime_ns
+    assert len(jit_cache.namespaces(artifact)) == 2  # the old image's stays, within --jit-cache-keep
+
+
+def test_only_prepare_does_nothing_once_this_environment_has_caches(tmp_path, prepared):
+    model, artifact = prepared
+    assert _only_prepare(model, artifact) == 0
+    assert _only_prepare(model, artifact) == 0
+    assert len(list((tmp_path / "calls").iterdir())) == 1
+
+
+def test_only_prepare_says_so_when_it_cannot_write_the_caches(tmp_path, prepared, capsys):
+    model, artifact = prepared
+    caches = artifact / jit_cache.CACHE_DIR_NAME
+    os.chmod(caches, 0o555)
+    try:
+        assert _only_prepare(model, artifact) == 1
+    finally:
+        os.chmod(caches, 0o755)
+    assert "cannot write JIT caches" in capsys.readouterr().err
+
