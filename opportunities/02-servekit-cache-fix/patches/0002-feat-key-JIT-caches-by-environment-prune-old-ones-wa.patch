+def env_for(root: Path, environ: Optional[Mapping[str, str]] = None) -> Dict[str, str]:
+    """The variables that put every cache under `root`.
+
+    One `environ` already sets is left out: whoever set it chose where that
+    cache lives (a shared per-image cache, say), and servekit does not move it.
+    """
+    environ = environ or {}
+    return {c.var: str(root / c.subdir) for c in CACHES if c.var not in environ}
+
+
+def left_to_environment(environ: Mapping[str, str]) -> Dict[str, str]:
+    return {c.var: environ[c.var] for c in CACHES if c.var in environ}
+
+
+def create(root: Path, environ: Optional[Mapping[str, str]] = None) -> Dict[str, str]:
+    env = env_for(root, environ)
+    for path in env.values():
+        Path(path).mkdir(parents=True, exist_ok=True)
+    return env
