+    "changed, said",
+    [
+        (_key(packages={"sglang": "0.5.16"}), "sglang 0.5.16 -> 0.5.20"),
+        (_key(packages={"torch": "2.12.0"}), "torch 2.12.0 -> 2.13.0"),
+        (_key(packages={"flashinfer-python": "0.6.17"}), "flashinfer-python 0.6.17 -> 0.6.18"),
+        (_key(gpu=["8.0"]), "gpu ['8.0'] -> ['9.0']"),
+        (_key(cpu="x86_64"), "cpu x86_64 -> aarch64"),
+        (_key(python="3.10"), "python 3.10 -> 3.12"),
+        (_key(cuda="12.9.1"), "cuda 12.9.1 -> 13.0.3"),
+    ],
+)
+def test_anything_that_decides_validity_moves_the_namespace(changed, said):
+    assert changed.name != _key().name
+    assert said in jit_cache.key_differences(_key().material, changed.material)
+
+
+def test_the_key_reads_package_metadata_and_never_imports_the_engine(tmp_path, monkeypatch):
+    installed = {"sglang": "0.5.20", "torch": "2.13.0", "sglang-kernel": "0.4.7"}
+
+    def version(name):
+        if name not in installed:
+            raise jit_cache.metadata.PackageNotFoundError(name)
+        return installed[name]
+
+    monkeypatch.setattr(jit_cache.metadata, "version", version)
+    cuda = tmp_path / "cuda"
+    cuda.mkdir()
+    (cuda / "version.json").write_text(json.dumps({"cuda": {"name": "CUDA SDK", "version": "13.0.3"}}))
+
+    key = jit_cache.validity_key("sglang", {"CUDA_HOME": str(cuda), "SGLANG_IMAGE_TAG": "lmsysorg/sglang:v0.5.20"})
+
+    assert key.material["packages"] == installed
+    assert key.material["gpu"] == ["9.0"]
+    assert key.material["cuda"] == "13.0.3"
+    assert key.material["image"] == {"SGLANG_IMAGE_TAG": "lmsysorg/sglang:v0.5.20"}
+    assert "sglang" not in sys.modules
+
