+"""Keep each test off the machine it runs on: its home, its temp dir, its GPUs.
+
+launch and prepare key the JIT caches by the node's GPUs, and the fake engines
+here compile into $HOME. On a developer's machine those are real, and not
+what CI has.
+"""
+import tempfile
+
+import pytest
+
+from servekit import jit_cache
+
+
+@pytest.fixture(autouse=True)
+def isolated_machine(request, tmp_path_factory, monkeypatch):
+    if request.node.get_closest_marker("e2e"):
+        return None  # a real cluster job: its environment must stay the submitter's
+    root = tmp_path_factory.mktemp("machine")
+    (root / "home").mkdir()
+    (root / "tmp").mkdir()
+    monkeypatch.setenv("HOME", str(root / "home"))
+    monkeypatch.setenv("USER", "tester")
+    monkeypatch.delenv("XDG_CACHE_HOME", raising=False)
+    monkeypatch.setattr(tempfile, "tempdir", str(root / "tmp"))
+    for cache in jit_cache.CACHES:
+        monkeypatch.delenv(cache.var, raising=False)
+    monkeypatch.setattr(jit_cache, "gpu_capabilities", lambda: ("9.0",))
+    return root
