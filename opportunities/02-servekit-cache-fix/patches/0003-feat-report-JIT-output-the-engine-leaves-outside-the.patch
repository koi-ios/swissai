diff --git a/src/servekit/jit_audit.py b/src/servekit/jit_audit.py
new file mode 100644
index 0000000..833111f
--- /dev/null
+++ b/src/servekit/jit_audit.py
@@ -0,0 +1,233 @@
+"""What an engine compiled where servekit does not keep it.
+
+Snapshot the engine's default cache locations before it starts; once it is
+ready, anything new there is JIT output the next cold start pays for again.
+Each finding comes with its size and the variable that would have moved it, so
+a cache a new engine release adds is a log line on its first launch instead of
+a regression nobody sees. sglang 0.5.20's SGLANG_JIT_CACHE_DIR would have been
+one: `~/.cache/sglang/jit`, every launch.
+"""
+from __future__ import annotations
+
+import os
+import tempfile
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Dict, List, Mapping, Optional, Sequence, Tuple
+
+from .jit_cache import CACHES, left_to_environment
+
+# Downloads and package managers, not compiled output.
+IGNORED = ("huggingface", "modelscope", "pip", "uv")
+
+# The temp dir is also full of runtime scratch (IPC endpoints, Prometheus
+# multiprocess files, profiler dumps), so there only a known cache, or a file
+# that is compiled code, counts. sglang 0.5.20 builds two extensions under it
+# that no variable moves: symm_allocator (--enable-symm-mem) and sgl_bump_arena.
+COMPILED = (".so", ".cubin", ".ptx", ".fatbin", ".o", ".hsaco")
+
+# A home or temp dir bigger than this is not audited past it, and says so.
+DEFAULT_LIMIT = 200_000
+
+
+def watched_roots(environ: Mapping[str, str]) -> List[Path]:
+    """Where an engine writes the caches nobody pointed elsewhere."""
+    home = Path(environ.get("HOME") or Path.home())
+    roots = [home / ".cache", home / ".triton", home / ".nv", home / ".tilelang", Path(tempfile.gettempdir())]
+    if environ.get("XDG_CACHE_HOME"):
+        roots.append(Path(environ["XDG_CACHE_HOME"]))
+    return list(dict.fromkeys(roots))
+
+
+@dataclass
+class Snapshot:
+    roots: Tuple[Path, ...]
+    skip: Tuple[Path, ...]
+    files: Dict[str, Tuple[int, int]]  # path -> (size, mtime_ns)
+    truncated: bool = False
+
+
+def _under(path: Path, parents: Sequence[Path]) -> bool:
+    return any(path == p or p in path.parents for p in parents)
+
+
+def _scan(roots: Sequence[Path], skip: Sequence[Path], limit: int) -> Tuple[Dict[str, Tuple[int, int]], bool]:
+    files: Dict[str, Tuple[int, int]] = {}
+    stack = [r for r in roots if not _under(r, skip)]
+    seen = set()
+    while stack:
+        directory = stack.pop()
+        try:
+            real = os.path.realpath(directory)
+            if real in seen:
+                continue
+            seen.add(real)
+            entries = list(os.scandir(directory))
+        except OSError:
+            continue
+        for entry in entries:
+            try:
+                if entry.is_dir(follow_symlinks=False):
+                    if not _under(Path(entry.path), skip):
+                        stack.append(Path(entry.path))
+                    continue
+                # Sockets, FIFOs and symlinks are not cache entries; empty files are locks.
+                if not entry.is_file(follow_symlinks=False):
+                    continue
+                st = entry.stat(follow_symlinks=False)
+            except OSError:
+                continue
+            if st.st_size:
+                files[entry.path] = (st.st_size, st.st_mtime_ns)
+                if len(files) >= limit:
+                    return files, True
+    return files, False
+
+
+def snapshot(roots: Sequence[Path], skip: Sequence[Path] = (), limit: int = DEFAULT_LIMIT) -> Snapshot:
+    roots, skip = tuple(Path(r) for r in roots), tuple(Path(s) for s in skip)
+    files, truncated = _scan(roots, skip, limit)
+    return Snapshot(roots, skip, files, truncated)
+
+
+def _changed(before: Snapshot, limit: int) -> Tuple[Dict[str, int], bool]:
+    after, truncated = _scan(before.roots, before.skip, limit)
+    new = {path: size for path, (size, mtime) in after.items() if before.files.get(path) != (size, mtime)}
+    return new, truncated or before.truncated
+
+
+@dataclass
+class Drift:
+    """New compiled output under one directory the engine was not pointed at."""
+
+    path: str
+    files: int
+    bytes: int
+    variable: Optional[str] = None  # the variable whose default this is, if one is known
+
+
+@dataclass
+class Audit:
+    watched: Snapshot
+    covered_root: Optional[Path]
+    covered: Optional[Snapshot]
+    scratch: Tuple[Path, ...] = ()
+
+
+@dataclass
+class Result:
+    # Outside every directory servekit persists: lost when the job ends.
+    drift: List[Drift]
+    # Inside the node-local caches but not staged into them: what this run compiled.
+    compiled: Dict[str, Dict[str, int]]
+    truncated: bool = False
+
+    def to_dict(self) -> dict:
+        return {"drift": [asdict(d) for d in self.drift], "compiled": self.compiled, "truncated": self.truncated}
+
+
+def start(
+    covered_root: Optional[Path],
+    skip: Sequence[Path] = (),
+    environ: Optional[Mapping[str, str]] = None,
+    limit: int = DEFAULT_LIMIT,
+) -> Audit:
+    """Snapshot the default cache locations and the node-local caches before the engine runs.
+
+    `skip` is servekit's own (the node-local caches, the staged weights, the
+    artifact). A cache variable the environment set is the environment's
+    business, so where it points is skipped too.
+    """
+    environ = os.environ if environ is None else environ
+    roots = watched_roots(environ)
+    theirs = [Path(v) for v in left_to_environment(environ).values() if v]
+    downloads = [root / name for root in roots for name in IGNORED]
+    watched = snapshot(roots, [*skip, *theirs, *downloads], limit)
+    covered = snapshot([covered_root], (), limit) if covered_root is not None else None
+    return Audit(watched, covered_root, covered, scratch=(Path(tempfile.gettempdir()),))
+
+
+def _expand(template: str, home: Path, tmp: Path, user: str) -> Path:
+    path = template.replace("<user>", user)
+    if path.startswith("~/"):
+        return home / path[2:]
+    if path.startswith("<tmp>/"):
+        return tmp / path[len("<tmp>/"):]
+    return Path(path)
+
+
+def _known_default(path: Path, home: Path, tmp: Path, user: str) -> Tuple[Optional[Path], Optional[str]]:
+    """The deepest cache default `path` is under, and the variable that moves it."""
+    hits = [
+        (_expand(t, home, tmp, user), cache.var)
+        for cache in CACHES
+        for t in cache.defaults
+        if _under(path, [_expand(t, home, tmp, user)])
+    ]
+    return max(hits, key=lambda hit: len(hit[0].parts)) if hits else (None, None)
+
+
+def finish(audit: Audit, environ: Optional[Mapping[str, str]] = None, limit: int = DEFAULT_LIMIT) -> Result:
+    environ = os.environ if environ is None else environ
+    home = Path(environ.get("HOME") or Path.home())
+    tmp = Path(tempfile.gettempdir())
+    user = environ.get("USER") or environ.get("LOGNAME") or "user"
+
+    new, truncated = _changed(audit.watched, limit)
+    groups: Dict[Path, Drift] = {}
+    for name, size in new.items():
+        path = Path(name)
+        root = next((r for r in audit.watched.roots if _under(path, [r])), None)
+        rel = path.relative_to(root).parts if root is not None else ()
+        if not rel:
+            continue
+        default, var = _known_default(path, home, tmp, user)
+        if root in audit.scratch and default is None and path.suffix not in COMPILED:
+            continue
+        # An unknown cache is named by its first two directories under the root.
+        group = default or root.joinpath(*rel[: min(2, len(rel) - 1) or 1])
+        shown = "~/" + group.relative_to(home).as_posix() if home in group.parents else str(group)
+        entry = groups.setdefault(group, Drift(shown, 0, 0, var))
+        entry.files += 1
+        entry.bytes += size
+
+    compiled: Dict[str, Dict[str, int]] = {}
+    if audit.covered is not None:
+        inside, more = _changed(audit.covered, limit)
+        truncated = truncated or more
+        for name, size in inside.items():
+            sub = Path(name).relative_to(audit.covered_root).parts[0]
+            slot = compiled.setdefault(sub, {"files": 0, "bytes": 0})
+            slot["files"] += 1
+            slot["bytes"] += size
+
+    drift = sorted(groups.values(), key=lambda d: (-d.bytes, d.path))
+    return Result(drift, dict(sorted(compiled.items())), truncated)
+
+
+def human(nbytes: int) -> str:
+    for unit, scale in (("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
+        if nbytes >= scale:
+            return f"{nbytes / scale:.1f} {unit}"
+    return f"{nbytes} B"
+
+
+def report(result: Result, set_by_servekit: Mapping[str, str], log=None) -> None:
+    """Log what `finish` found: compiled output kept, and compiled output lost."""
+    log = log or (lambda line: print(line, flush=True))
+    if result.compiled:
+        kept = ", ".join(f"{sub} {human(v['bytes'])}" for sub, v in result.compiled.items())
+        log(f"[SERVEKIT] compiled during this run into the node-local caches: {kept}")
+    if result.truncated:
+        log(f"[SERVEKIT] warning: more than {DEFAULT_LIMIT} files under the default cache dirs; not all were audited")
+    if not result.drift:
+        return
+    log("[SERVEKIT] warning: the engine compiled into directories servekit does not keep:")
+    for d in result.drift:
+        if d.variable and d.variable in set_by_servekit:
+            why = f"servekit set {d.variable}, and the engine wrote to its default anyway"
+        elif d.variable:
+            why = f"{d.variable}'s default"
+        else:
+            why = "no variable servekit knows moves this: add it to servekit.jit_cache.CACHES"
+        log(f"[SERVEKIT]   {human(d.bytes):>9} in {d.files:>5} files  {d.path}  ({why})")
