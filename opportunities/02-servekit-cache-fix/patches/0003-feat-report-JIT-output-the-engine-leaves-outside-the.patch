diff --git a/tests/test_jit_audit.py b/tests/test_jit_audit.py
new file mode 100644
index 0000000..1dd3c6f
--- /dev/null
+++ b/tests/test_jit_audit.py
@@ -0,0 +1,205 @@
+"""Tests for the JIT audit: compiled output a run leaves where servekit does not
+keep it is reported with its size, and with --jit-cache-strict stops the run."""
+import json
+import os
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+from servekit import jit_audit, jit_cache
+from servekit.cli import main
+from servekit.manifest import Manifest
+from servekit.profile import ProfileReport, run_profile
+from servekit.stage import StageResult
+
+
+def _write(path: Path, nbytes: int) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(b"x" * nbytes)
+
+
+@pytest.fixture
+def artifact(tmp_path):
+    model = tmp_path / "Llama-3.1-70B-Instruct"
+    model.mkdir()
+    art = tmp_path / "llama70b-tp4"
+    art.mkdir()
+    (art / "config.json").write_text("{}")
+    (art / "model-rank-0-part-0.safetensors").write_bytes(b"weights")
+    Manifest(
+        format="sharded_state", engine="sglang", engine_version="0.5.20", tp_size=1, pp_size=1,
+        dp_size=1, dtype="bfloat16", quantization=None, source=str(model),
+    ).write(art)
+    return model, art
+
+
+def _serve(tmp_path, monkeypatch, artifact, engine, *flags):
+    """`launch` with a fake engine: `engine(env)` compiles, then the server reports ready."""
+    model, art = artifact
+    seen = {}
+
+    def fake_run_profile(command, ready_timeout=1800.0, on_ready=None, head=True, env=None):
+        seen["env"] = env or {}
+        engine({**os.environ, **(env or {})})
+        report = ProfileReport(command="", started_at=0.0, ready_at=1.0, success=True, framework="sglang")
+        seen["stopped"] = on_ready(report) is True
+        return report
+
+    monkeypatch.setattr("servekit.launch.run_profile", fake_run_profile)
+    monkeypatch.setattr("servekit.launch.stage", lambda src, dest, slices=64, file_pattern="*": StageResult(dest, 0.1, 1.0, 1))
+    monkeypatch.setattr("servekit.launch.DEFAULT_ROOT", tmp_path / "shm")
+    monkeypatch.setattr("servekit.launch.DEFAULT_CACHE_ROOT", tmp_path / "node-local")
+    out = tmp_path / "run.json"
+    rc = main([
+        "launch", "--servekit-artifact-path", str(art), "--out", str(out), *flags,
+        "--", "python", "-m", "sglang.launch_server", "--model-path", str(model),
+    ])
+    seen["rc"] = rc
+    seen["report"] = json.loads(out.read_text())
+    return seen
+
+
+def _home() -> Path:
+    return Path(os.environ["HOME"])
+
+
+def test_a_jit_cache_the_engine_keeps_in_home_is_reported_with_its_size(tmp_path, monkeypatch, artifact, capsys):
+    # An engine that ignores SGLANG_JIT_CACHE_DIR, as one would that renamed it.
+    def engine(env):
+        for i, n in enumerate((1000, 2000, 3000)):
+            _write(Path(env["HOME"]) / ".cache/sglang/jit/sm90" / f"m{i}" / "m.so", n)
+
+    seen = _serve(tmp_path, monkeypatch, artifact, engine)
+
+    assert seen["rc"] == 0 and not seen["stopped"]
+    assert seen["report"]["jit_cache"]["drift"] == [
+        {"path": "~/.cache/sglang/jit", "files": 3, "bytes": 6000, "variable": "SGLANG_JIT_CACHE_DIR"}
+    ]
+    out = capsys.readouterr().out
+    assert "6.0 kB in     3 files  ~/.cache/sglang/jit" in out
+    assert "servekit set SGLANG_JIT_CACHE_DIR, and the engine wrote to its default anyway" in out
+
+
+def test_strict_stops_the_server_and_fails_the_launch(tmp_path, monkeypatch, artifact, capsys):
+    seen = _serve(
+        tmp_path, monkeypatch, artifact,
+        lambda env: _write(Path(env["HOME"]) / ".cache/sglang/jit/sm90/m/m.so", 10),
+        "--jit-cache-strict",
+    )
+
+    assert seen["stopped"] and seen["rc"] == 3
+    assert "--jit-cache-strict" in capsys.readouterr().err
+
+
+def test_an_engine_that_honors_the_variables_drifts_nowhere(tmp_path, monkeypatch, artifact):
+    # sglang 0.5.20: load_jit under SGLANG_JIT_CACHE_DIR, Triton under TRITON_CACHE_DIR.
+    def engine(env):
+        _write(Path(env["SGLANG_JIT_CACHE_DIR"]) / "sm90/comm/build-0/deps-0/comm.so", 4096)
+        _write(Path(env["TRITON_CACHE_DIR"]) / "ABC/k.cubin", 100)
+
+    seen = _serve(tmp_path, monkeypatch, artifact, engine, "--jit-cache-strict")
+
+    jit = seen["report"]["jit_cache"]
+    assert seen["rc"] == 0 and jit["drift"] == []
+    assert jit["compiled"] == {"sglang-jit": {"files": 1, "bytes": 4096}, "triton": {"files": 1, "bytes": 100}}
+    assert jit["source"] == "none" and jit["key"] == jit_cache.validity_key("sglang").name
+
+
+def test_a_cache_servekit_has_never_heard_of_is_named_as_such(tmp_path, monkeypatch, artifact, capsys):
+    seen = _serve(tmp_path, monkeypatch, artifact, lambda env: _write(Path(env["HOME"]) / ".cache/newlib/kernels/k.bin", 5))
+
+    assert seen["report"]["jit_cache"]["drift"] == [
+        {"path": "~/.cache/newlib/kernels", "files": 1, "bytes": 5, "variable": None}
+    ]
+    assert "add it to servekit.jit_cache.CACHES" in capsys.readouterr().out
+
+
+def test_a_default_in_the_temp_dir_is_found_and_named(tmp_path, monkeypatch, artifact):
+    tmp = Path(tempfile.gettempdir())
+    seen = _serve(tmp_path, monkeypatch, artifact, lambda env: _write(tmp / "torchinductor_tester/fxgraph/ab/cd", 7))
+
+    assert seen["report"]["jit_cache"]["drift"] == [
+        {"path": str(tmp / "torchinductor_tester"), "files": 1, "bytes": 7, "variable": "TORCHINDUCTOR_CACHE_DIR"}
+    ]
+
+
+def test_in_the_temp_dir_only_compiled_code_counts(tmp_path, monkeypatch, artifact):
+    tmp = Path(tempfile.gettempdir())
+
+    def engine(env):
+        _write(tmp / "tmpk3x9/counter_1234.db", 1_000_000)  # Prometheus multiprocess, --enable-metrics
+        _write(tmp / "sglang_temp_file_1.sh", 40)  # the numa launcher script
+        _write(tmp / "symm_allocator/nccl_allocator.so", 300)  # sglang 0.5.20, --enable-symm-mem
+
+    seen = _serve(tmp_path, monkeypatch, artifact, engine)
+
+    assert seen["report"]["jit_cache"]["drift"] == [
+        {"path": str(tmp / "symm_allocator"), "files": 1, "bytes": 300, "variable": None}
+    ]
+
+
+def test_downloads_and_what_was_there_before_are_not_drift(tmp_path, monkeypatch, artifact):
+    _write(_home() / ".cache/sglang/jit/sm90/old/old.so", 50)  # from before this run, untouched
+
+    seen = _serve(tmp_path, monkeypatch, artifact, lambda env: _write(Path(env["HOME"]) / ".cache/huggingface/hub/x", 9))
+
+    assert seen["report"]["jit_cache"]["drift"] == []
+
+
+def test_a_cache_the_environment_points_elsewhere_is_left_to_it(tmp_path, monkeypatch, artifact, capsys):
+    shared = _home() / ".cache" / "site-triton"
+    monkeypatch.setenv("TRITON_CACHE_DIR", str(shared))
+
+    seen = _serve(tmp_path, monkeypatch, artifact, lambda env: _write(Path(env["TRITON_CACHE_DIR"]) / "ABC/k.cubin", 3))
+
+    assert "TRITON_CACHE_DIR" not in seen["env"]
+    assert seen["report"]["jit_cache"]["drift"] == []
+    assert f"TRITON_CACHE_DIR is set by the environment ({shared})" in capsys.readouterr().out
+
+
+def test_prepare_reports_what_it_could_not_keep_and_strict_fails_after_the_manifest(tmp_path, monkeypatch):
+    from servekit.prepare import prepare
+
+    script = tmp_path / "sharder.py"
+    script.write_text(
+        "import json, os, sys\n"
+        "a = sys.argv[1:]\n"
+        "arg = lambda n: a[a.index(n) + 1]\n"
+        "open(arg('--output') + '/model-rank-0-part-0.safetensors', 'wb').write(b'w')\n"
+        "json.dump({'engine': 'sglang', 'engine_version': '0.5.20', 'tp_size': 1, 'pp_size': 1, 'dp_size': 1,"
+        " 'dtype': 'bfloat16', 'quantization': None}, open(arg('--servekit-resolved-out'), 'w'))\n"
+        "p = os.path.expanduser('~/.cache/newlib/k.bin')\n"
+        "os.makedirs(os.path.dirname(p), exist_ok=True)\n"
+        "open(p, 'wb').write(b'k' * 11)\n"
+    )
+    monkeypatch.setattr("servekit.prepare.SAVE_SCRIPT", script)
+    model = tmp_path / "m"
+    model.mkdir()
+
+    rc = prepare(model, tmp_path / "out", tp=1, cache_root=tmp_path / "node-local", strict=True)
+
+    assert rc == 3
+    assert (tmp_path / "out" / "servekit.json").is_file()
+    assert jit_cache.has_namespace(tmp_path / "out", jit_cache.validity_key("sglang"))
+
+
+def test_the_audit_skips_what_servekit_itself_writes(tmp_path):
+    tmp = Path(tempfile.gettempdir())
+    ours = tmp / "servekit" / "caches"
+    audit = jit_audit.start(covered_root=None, skip=[ours])
+    _write(ours / "a" / "k.so", 10)
+
+    assert jit_audit.finish(audit).drift == []
+
+
+def test_on_ready_returning_true_stops_the_server():
+    serve = "import time; print('The server is fired up and ready to roll!', flush=True); time.sleep(60)"
+    t0 = time.monotonic()
+
+    report = run_profile([sys.executable, "-c", serve, "sglang"], ready_timeout=30, on_ready=lambda r: True)
+
+    assert report.success
+    assert time.monotonic() - t0 < 20
