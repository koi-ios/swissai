+    Cache("CUDA_CACHE_PATH", "nv", ("~/.cache/sglang/nv", "~/.nv/ComputeCache")),
+    # torch.utils.cpp_extension.load without a build_directory; sglang 0.5.20's
+    # KDA prefill kernel is one.
+    Cache("TORCH_EXTENSIONS_DIR", "torch-extensions", ("~/.cache/torch_extensions",)),
+    # TileLang and the CuTe DSL (FlashAttention 4, quack): sglang 0.5.20 dependencies.
+    Cache("TILELANG_CACHE_DIR", "tilelang", ("~/.tilelang/cache",)),
+    Cache("CUTE_DSL_CACHE_DIR", "cute-dsl", ("<tmp>/<user>/cutlass_python_cache",)),
+)
 
 
