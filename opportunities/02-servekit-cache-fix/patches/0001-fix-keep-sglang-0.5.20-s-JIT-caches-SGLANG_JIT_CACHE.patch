diff --git a/tests/test_jit_cache.py b/tests/test_jit_cache.py
new file mode 100644
index 0000000..ccc60e3
--- /dev/null
+++ b/tests/test_jit_cache.py
@@ -0,0 +1,84 @@
+"""Tests for where the JIT caches go: every cache each engine release compiles
+must land where servekit keeps it."""
+from pathlib import Path
+
+import pytest
+
+from servekit import jit_cache
+
+# --- every cache each sglang release compiles lands where servekit keeps it ------------------------
+
+
+def _expand(path: str, env: dict) -> Path:
+    return Path(env["HOME"] + path[1:]) if path.startswith("~") else Path(path)
+
+
+def _sglang_cache_dir(env: dict) -> Path:
+    # srt/environ.py: SGLANG_CACHE_DIR = EnvStr(os.path.expanduser("~/.cache/sglang"))
+    return _expand(env.get("SGLANG_CACHE_DIR", "~/.cache/sglang"), env)
+
+
+def _after_import_0_5_20(env: dict) -> dict:
+    """`import sglang` runs redirect_third_party_caches (srt/environ.py:1923-1946): setdefault."""
+    base = _sglang_cache_dir(env)
+    defaults = {
+        "TRITON_CACHE_DIR": base / "triton",
+        "TORCHINDUCTOR_CACHE_DIR": base / "inductor",
+        "CUDA_CACHE_PATH": base / "nv",
+        "FLASHINFER_WORKSPACE_BASE": base,
+    }
+    return {**{k: str(v) for k, v in defaults.items()}, **env}
+
+
+# Where each release puts each cache, given the engine's environment. Each line
+# mirrors the cited source at that tag; a new release gets a new block.
+WHERE = {
+    "0.5.16": {
+        # python/sglang/jit_kernel/utils/compile.py:244
+        "load_jit (custom all-reduce)": lambda env: _expand(env.get("TVM_FFI_CACHE_DIR", "~/.cache/tvm-ffi"), env),
+        # srt/layers/deep_gemm_wrapper/compile_utils.py:39
+        "DeepGEMM": lambda env: _expand(env.get("SGLANG_DG_CACHE_DIR", "~/.cache/deep_gemm"), env),
+        # srt/compilation/backend.py:405, custom_all_reduce_utils.py:266
+        "torch.compile, P2P check": _sglang_cache_dir,
+        "Triton": lambda env: _expand(env.get("TRITON_CACHE_DIR", "~/.triton/cache"), env),
+        "FlashInfer": lambda env: _expand(env.get("FLASHINFER_WORKSPACE_BASE", "~"), env) / ".cache" / "flashinfer",
+    },
+    "0.5.20": {
+        # python/sglang/kernels/jit/utils/compile/cache.py:302
+        "load_jit (custom all-reduce)": lambda env: _expand(env.get("SGLANG_JIT_CACHE_DIR") or "~/.cache/sglang/jit", env),
+        # srt/environ.py:1168
+        "CuTe DSL AOT": lambda env: _expand(env.get("SGLANG_CUTE_AOT_CACHE_DIR") or str(_sglang_cache_dir(env) / "cute_aot"), env),
+        # srt/environ.py:1154
+        "DeepGEMM": lambda env: _expand(env.get("SGLANG_DG_CACHE_DIR") or str(_sglang_cache_dir(env) / "deep_gemm"), env),
+        # srt/compilation/backend.py:403, custom_all_reduce_utils.py:267
+        "torch.compile, P2P check": _sglang_cache_dir,
+        "Triton": lambda env: Path(_after_import_0_5_20(env)["TRITON_CACHE_DIR"]),
+        "Inductor": lambda env: Path(_after_import_0_5_20(env)["TORCHINDUCTOR_CACHE_DIR"]),
+        "CUDA PTX": lambda env: Path(_after_import_0_5_20(env)["CUDA_CACHE_PATH"]),
+        "FlashInfer": lambda env: Path(_after_import_0_5_20(env)["FLASHINFER_WORKSPACE_BASE"]) / ".cache" / "flashinfer",
+        # tilelang 0.1.12, tilelang/env.py:337 (a sglang 0.5.20 dependency)
+        "TileLang": lambda env: _expand(env.get("TILELANG_CACHE_DIR", "~/.tilelang/cache"), env),
+        # kernels/ops/attention/linear/kda_ptx_prefill/__init__.py:42: torch.utils.cpp_extension.load
+        "torch extensions": lambda env: _expand(env.get("TORCH_EXTENSIONS_DIR", "~/.cache/torch_extensions"), env),
+    },
+}
+
+
+@pytest.mark.parametrize("version, cache", [(v, c) for v, caches in WHERE.items() for c in caches])
+def test_every_cache_a_release_compiles_lands_where_servekit_keeps_it(tmp_path, version, cache):
+    kept = tmp_path / "node-local" / "llama70b-tp4"
+    env = {"HOME": str(tmp_path / "home"), **jit_cache.env_for(kept)}
+
+    assert kept in WHERE[version][cache](env).parents
+
+
+# servekit's list before keys (jit_cache.py:16-22 at cd8f0b8).
+BEFORE = {"TRITON_CACHE_DIR": "triton", "TVM_FFI_CACHE_DIR": "tvm-ffi", "FLASHINFER_WORKSPACE_BASE": "flashinfer"}
+
+
+@pytest.mark.parametrize("version, kept", [("0.5.16", True), ("0.5.20", False)])
+def test_the_old_list_kept_the_all_reduce_kernel_only_up_to_0_5_16(tmp_path, version, kept):
+    root = tmp_path / "node-local"
+    env = {"HOME": str(tmp_path / "home"), **{var: str(root / sub) for var, sub in BEFORE.items()}}
+
+    assert (root in WHERE[version]["load_jit (custom all-reduce)"](env).parents) is kept
diff --git a/tests/test_jit_cache_regression.py b/tests/test_jit_cache_regression.py
new file mode 100644
index 0000000..3e0c98f
--- /dev/null
+++ b/tests/test_jit_cache_regression.py
@@ -0,0 +1,88 @@
+"""The regression: sglang 0.5.20 builds its custom all-reduce (with every
+other `load_jit` kernel) under SGLANG_JIT_CACHE_DIR, which servekit did not
+set. `prepare` JITted it into the job's ephemeral $HOME, kept nothing, and
+every later launch built it again during torch.distributed init (~17 s at TP4
+on 0.5.16, where it was still kept).
+
+Uses only what servekit had before the fix (prepare, `launch`, the fake-engine
+seams), so the same file runs against cd8f0b8 and fails there.
+"""
+import os
+from pathlib import Path
+
+from servekit.cli import main
+from servekit.prepare import prepare
+from servekit.profile import ProfileReport
+from servekit.stage import StageResult
+
+MODULE = "sgl_kernel_jit_communicator"
+
+# The part of a sglang 0.5.20 sharding run this is about: torch.distributed init
+# builds the custom all-reduce through load_jit, which caches under
+# `envs.SGLANG_JIT_CACHE_DIR.get() or "~/.cache/sglang/jit"`
+# (python/sglang/kernels/jit/utils/compile/cache.py:302 at v0.5.20).
+FAKE_SGLANG_0_5_20 = f'''
+import json, os, shutil, sys
+from pathlib import Path
+args = sys.argv[1:]
+def arg(name):
+    return args[len(args) - 1 - args[::-1].index(name) + 1]
+out, model, tp = arg("--output"), arg("--model-path"), int(arg("--tensor-parallel-size"))
+if "--servekit-warm-only" not in args:
+    for rank in range(tp):
+        open(f"{{out}}/model-rank-{{rank}}-part-0.safetensors", "wb").write(b"weights")
+    shutil.copy(os.path.join(model, "config.json"), out)
+    resolved = {{"engine": "sglang", "engine_version": "0.5.20", "tp_size": tp, "pp_size": 1,
+                "dp_size": 1, "dtype": "bfloat16", "quantization": None}}
+    json.dump(resolved, open(arg("--servekit-resolved-out"), "w"))
+root = Path(os.environ.get("SGLANG_JIT_CACHE_DIR") or os.path.expanduser("~/.cache/sglang/jit"))
+leaf = root / "sm90" / "{MODULE}" / "build-0" / "deps-0"
+leaf.mkdir(parents=True, exist_ok=True)
+(leaf / "{MODULE}.so").write_bytes(b"\\x7fELF" + bytes(4096))
+'''
+
+
+def _built(env: dict) -> bool:
+    """Whether a 0.5.20 engine started with `env` finds the module already built."""
+    root = Path(env.get("SGLANG_JIT_CACHE_DIR") or os.path.join(env["HOME"], ".cache", "sglang", "jit"))
+    return any(p.name == f"{MODULE}.so" for p in root.rglob("*")) if root.is_dir() else False
+
+
+def test_a_later_job_finds_the_all_reduce_kernel_prepare_built(tmp_path, monkeypatch):
+    model = tmp_path / "Apertus-8B-Instruct-2509"
+    model.mkdir()
+    (model / "config.json").write_text("{}")
+    artifact = tmp_path / "apertus8b-tp2"
+    sharder = tmp_path / "fake_sglang_0_5_20.py"
+    sharder.write_text(FAKE_SGLANG_0_5_20)
+    monkeypatch.setattr("servekit.prepare.SAVE_SCRIPT", sharder)
+    monkeypatch.delenv("SGLANG_JIT_CACHE_DIR", raising=False)
+
+    # Job 1 prepares on node 1, with that job's own $HOME and /tmp.
+    monkeypatch.setenv("HOME", str(tmp_path / "job1-home"))
+    assert prepare(model, artifact, tp=2, cache_root=tmp_path / "node1-tmp") == 0
+
+    # Job 2 serves on node 2: a fresh $HOME and /tmp, only the artifact carries over.
+    monkeypatch.setenv("HOME", str(tmp_path / "job2-home"))
+    seen = {}
+
+    def fake_run_profile(command, ready_timeout=1800.0, on_ready=None, head=True, env=None):
+        seen["built"] = _built({**os.environ, **(env or {})})
+        return ProfileReport(command="", started_at=0.0, ready_at=1.0, success=True, framework="sglang")
+
+    def fake_stage(src, dest, slices=64, file_pattern="*"):
+        return StageResult(dest=dest, wall_s=0.1, gbps=1.0, bytes=1)
+
+    monkeypatch.setattr("servekit.launch.run_profile", fake_run_profile)
+    monkeypatch.setattr("servekit.launch.stage", fake_stage)
+    monkeypatch.setattr("servekit.launch.DEFAULT_ROOT", tmp_path / "node2-shm")
+    monkeypatch.setattr("servekit.launch.DEFAULT_CACHE_ROOT", tmp_path / "node2-tmp")
+    rc = main([
+        "launch", "--servekit-artifact-path", str(artifact), "--out", str(tmp_path / "run.json"),
+        "--", "python", "-m", "sglang.launch_server",
+        "--model-path", str(model), "--tensor-parallel-size", "2",
+    ])
+
+    assert rc == 0
+    assert seen["built"], "job 2 rebuilds the custom all-reduce: prepare did not keep sglang 0.5.20's load_jit cache"
+    assert not (tmp_path / "job1-home" / ".cache" / "sglang" / "jit").exists(), "prepare JITted into $HOME"
