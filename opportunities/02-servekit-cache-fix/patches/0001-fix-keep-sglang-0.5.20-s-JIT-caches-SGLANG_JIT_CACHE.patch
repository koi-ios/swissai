+    # under SGLANG_CACHE_DIR, but with setdefault, so the values here win.
+    Cache("TRITON_CACHE_DIR", "triton", ("~/.cache/sglang/triton", "~/.triton/cache")),
+    # tvm-ffi's own cache; sglang's load_jit built into it up to 0.5.16.
+    Cache("TVM_FFI_CACHE_DIR", "tvm-ffi", ("~/.cache/tvm-ffi",)),
     # FlashInfer has no cache-path variable; this stands in for $HOME and it
