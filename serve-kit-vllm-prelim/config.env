# Paths and settings shared by every run script. Edit this file on the VM, or
# override any value from the environment (e.g. `REPEATS=1 ./run_baseline.sh`).
# The scripts `source` it; nothing here is secret.

# --- model -------------------------------------------------------------------
: "${MODEL_ID:=swiss-ai/Apertus-8B-Instruct-2509}"   # in the servekit article's results table
: "${MODEL_NAME:=Apertus-8B-Instruct-2509}"         # the `model` column in results/*.csv
: "${SERVED_NAME:=apertus-8b}"                      # --served-model-name on every launch, so verify compares like with like

# --- storage -----------------------------------------------------------------
# /net must be the provider's NETWORK volume (symlink it: sudo ln -s /mnt/<volume> /net).
# /local must be local NVMe. setup_vm.sh prints the filesystem type of each.
: "${NET_ROOT:=/net/models}"
: "${LOCAL_ROOT:=/local/models}"
: "${MODEL_NET:=$NET_ROOT/apertus-8b}"              # checkpoint on the network volume (the main subject)
: "${MODEL_LOCAL:=$LOCAL_ROOT/apertus-8b}"          # the same checkpoint on local NVMe (control arm)
: "${PRESHARD_NET:=$NET_ROOT/apertus-8b-tp2}"       # presharded at TP 2 (preshard.py), on the network volume
: "${SHM_DIR:=/dev/shm/apertus-8b-tp2}"             # where stage.py copies the presharded files
: "${SK_ARTIFACT:=$NET_ROOT/apertus-8b-sk-tp2}"     # servekit launch --only-prepare writes this (run_servekit_prepare.sh)

# --- measurement -------------------------------------------------------------
: "${TP_LIST:=1 2}"                 # Day 1 baseline tensor-parallel sizes
: "${ARMS_TP:=2}"                   # Day 2 arms run at TP 2 (presharding needs TP >= 2 to pay off)
: "${REPEATS:=3}"                   # every number is a median of at least 3
: "${PORT:=8000}"
: "${STAGE_SWEEP:=1,2,4,8,16,32}"   # reader processes tried by run_staging_sweep.sh
: "${STAGE_READERS:=16}"            # readers used by the staged arm: set to the sweep's best N
: "${STAGE_BLOCK_MIB:=16}"          # servekit's stager also uses 16 MiB blocks
: "${READY_TIMEOUT:=1200}"          # seconds before a launch counts as failed
: "${VLLM_EXTRA_ARGS:=}"            # added to every `vllm serve`, e.g. "--max-model-len 8192"

# --- housekeeping ------------------------------------------------------------
: "${RESULTS:=results}"
: "${WARM_CACHE_ROOT:=$HOME/sk-warm-caches}"   # persistent compile caches for the "warm" run type
: "${FRESH_CACHE_BASE:=/tmp/sk-caches}"        # each cold run gets fresh dirs under here, deleted after
: "${VENV:=$HOME/sk}"                          # setup_vm.sh creates it; run scripts activate it if present
: "${VLLM_VERSION:=0.33.0}"                    # newest on PyPI on 11 Nov 2026; record what you ran in ENV.md
: "${SERVEKIT_REF:=main}"                      # servekit git ref to install

export MODEL_ID MODEL_NAME SERVED_NAME NET_ROOT LOCAL_ROOT MODEL_NET MODEL_LOCAL PRESHARD_NET SHM_DIR SK_ARTIFACT \
  TP_LIST ARMS_TP REPEATS PORT STAGE_SWEEP STAGE_READERS STAGE_BLOCK_MIB READY_TIMEOUT VLLM_EXTRA_ARGS \
  RESULTS WARM_CACHE_ROOT FRESH_CACHE_BASE VENV VLLM_VERSION SERVEKIT_REF

if [[ -z "${VIRTUAL_ENV:-}" && -f "$VENV/bin/activate" ]]; then
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
fi
