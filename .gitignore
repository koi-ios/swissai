# swissai control plane. Its one remote is a private GitHub repository that only the
# user pushes to; agents never push (pipeline/DECISIONS.md, 13 Nov 2026).
# Heavy, regenerable or machine-local trees stay on disk but out of history.
# SETUP.md says how to rebuild them on a new machine.
# Nothing listed here is deleted; see opportunities/README.md "Housekeeping".

# Upstream clones, worktrees and build trees (each has its own .git).
# The tracked record of a change is the patch series in <project>/patches/.
vendor/

# Per-folder environments and tool caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.ipynb_checkpoints/
.coverage
htmlcov/
node_modules/

# Folder-local toolchains (06: Go toolchain and module cache, about 4 GB)
toolchain/

# Model weights (07: small CPU test models, about 3.5 GB)
/opportunities/*/models/
*.safetensors
*.gguf

# Run logs and built binaries that a script regenerates
# (06: about 500 MB of trial logs, three 70 MB otela builds)
/opportunities/06-opentela-73/e2e/runs/
/opportunities/06-opentela-73/e2e/bin/

# Large derived data. Rebuild from Hugging Face eth-easl/swissai-serving-trace
# (see data/swissai-trace.README.md).
/data/swissai-trace.parquet

# Secrets and credentials. None are tracked (audit of 13 Nov); keep it that way.
# serve-kit-vllm-prelim/config.env is tracked on purpose: settings only, no secrets.
.env
.env.*
!.env.example
*.pem
*.key
.netrc
.git-credentials
.modal.toml

# Per-machine agent settings and agent worktrees (shared settings stay tracked)
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/

# OS and editor noise
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
