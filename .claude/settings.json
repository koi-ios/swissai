{
  "claudeMdExcludes": [
    "**/vendor/**/CLAUDE.md",
    "**/vendor/**/CLAUDE.local.md",
    "**/vendor/**/AGENTS.md",
    "**/vendor/**/.claude/rules/**",
    "**/toolchain/**/CLAUDE.md",
    "**/toolchain/**/AGENTS.md",
    "**/.venv/**/CLAUDE.md",
    "**/.venv/**/AGENTS.md",
    "**/node_modules/**/CLAUDE.md",
